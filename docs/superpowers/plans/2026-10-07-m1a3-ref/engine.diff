diff -ruN base/engine/tests/test_sage_frame.cpp work/engine/tests/test_sage_frame.cpp
--- base/engine/tests/test_sage_frame.cpp	1970-01-01 01:00:00
+++ work/engine/tests/test_sage_frame.cpp	2026-10-07 12:40:43
@@ -0,0 +1,156 @@
+// M1a-3: the SAGE frame replay (lomn/view/sage_frame.h) on the D3D8 state shim, and the A10 contract through AreaRenderer.
+// Expected values come from the decompiled functions named in each case.
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "doctest.h"
+#include "lomn/d3d/device8.h"
+#include "lomn/d3d/ffp.h"
+#include "lomn/fs.h"
+#include "lomn/rhi.h"
+#include "lomn/view/area.h"
+#include "lomn/view/sage_frame.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn;
+using namespace lomn::d3d;
+
+namespace {
+
+std::vector<std::string> state_lines(const std::vector<std::string>& log) {
+  std::vector<std::string> o;
+  for (const auto& l : log)
+    if (l.rfind("# ", 0) != 0) o.push_back(l);
+  return o;
+}
+
+view::AreaData synthetic_area() {
+  fs::MemoryFileSystem mfs;
+  REQUIRE(view::mount_synthetic_install(mfs));
+  view::AreaData a;
+  std::string err;
+  REQUIRE_MESSAGE(view::load_area(mfs, view::kSyntheticLevel, view::kSyntheticStateArea, view::AreaOptions(), a, &err), err);
+  return a;
+}
+
+}  // namespace
+
+TEST_CASE("sage: SrPushRenderMode carries ALPHAREF across the HUD's 0x80000 mode (R13 history)") {
+  std::vector<std::string> log;
+  Device8 d(&log);
+  view::SageFrame f(d, view::SageCaps(), view::SageFrameOptions());
+  f.push_render_mode(view::kModeMainView);  // from gLastRenderMode 0: nothing about ALPHAREF
+  CHECK(d.get_rs(rs::ALPHAREF) == 0);
+  CHECK(d.get_rs(rs::LIGHTING) == 1);
+  CHECK(d.get_rs(rs::CULLMODE) == kCullCW);
+  f.push_render_mode(view::kModeHud);  // entering 0x80000: ALPHAREF 0, blend + test on, z write off
+  CHECK(d.get_rs(rs::ALPHAREF) == 0);
+  CHECK(d.get_rs(rs::ALPHABLENDENABLE) == 1);
+  CHECK(d.get_rs(rs::ZWRITEENABLE) == 0);
+  f.push_render_mode(view::kModeArea);  // leaving it: ALPHAREF 1
+  CHECK(d.get_rs(rs::ALPHAREF) == 1);
+  CHECK(d.get_rs(rs::ALPHABLENDENABLE) == 0);
+  CHECK(d.get_rs(rs::ZWRITEENABLE) == 1);
+  CHECK(d.get_rs(rs::LIGHTING) == 0);  // 0x14634 bit 0 clear: the area nodes are unlit
+  CHECK(d.get_rs(rs::ZENABLE) == kZbUseW);
+  CHECK(d.get_rs(rs::FILLMODE) == kFillSolid);
+  CHECK(d.get_rs(rs::FOGENABLE) == 1);  // 0x200
+  f.push_render_mode(view::kModeTrans);  // 0x10034: no 0x200 -> fog off, cull none
+  CHECK(d.get_rs(rs::FOGENABLE) == 0);
+  CHECK(d.get_rs(rs::CULLMODE) == kCullNone);
+}
+
+TEST_CASE("sage: SetFog writes the statics' bit patterns once, then only toggles FOGENABLE") {
+  std::vector<std::string> log;
+  Device8 d(&log);
+  view::SageFrame f(d, view::SageCaps(), view::SageFrameOptions());
+  f.set_fog_value(0xfff9dcf9u, 40.0f, 1200.0f, 0.05f);
+  f.set_fog(true);
+  f.set_fog(true);  // mFogOn already set: returns early
+  f.set_fog(false);
+  f.set_fog(true);
+  // FOGTABLEMODE: the D3D8 default is NONE; SetFog writes LINEAR (AppMain did too, on the real device).
+  const std::vector<std::string> want = {"RS FOGENABLE 1",       "RS FOGTABLEMODE 3", "RS FOGCOLOR 0xfff9dcf9",         "RS FOGSTART 0x42200000 (40)",
+                                         "RS FOGEND 0x44960000 (1200)", "RS FOGDENSITY 0x3d4ccccd (0.05)", "RS FOGENABLE 0",
+                                         "RS FOGENABLE 1"};
+  CHECK(state_lines(log) == want);
+}
+
+TEST_CASE("sage: DrawX two passes; plnt sets the context flag (alpha test only) and turns fog off afterwards (R14)") {
+  view::AreaData a = synthetic_area();
+  std::vector<std::string> log;
+  Device8 d(&log);
+  view::SageFrame f(d, view::SageCaps(), view::SageFrameOptions());
+  f.push_render_mode(view::kModeArea);
+  uint32_t quad = 0, plnt = 0;
+  for (uint32_t i = 0; i < a.placements.size(); ++i) {
+    const std::string& id = a.models[a.placements[i].model].id;
+    if (id == "quad" && a.placements[i].route == sage::Route::Main) quad = i;
+    if (id == "plnt") plnt = i;
+  }
+  log.clear();
+  f.area_render(a, quad);
+  std::vector<std::string> l = state_lines(log);
+  // quad: red (opaque), nothere (opaque, NULL texture), then cut in pass 2 with blend + GREATER test.
+  auto at = [&](const std::string& s) { return std::find(l.begin(), l.end(), s) - l.begin(); };
+  REQUIRE(at("DRAW quad#0 attrib=0") < at("DRAW quad#0 attrib=2"));
+  REQUIRE(at("DRAW quad#0 attrib=2") < at("RS ALPHATESTENABLE 1"));
+  CHECK(at("RS ALPHABLENDENABLE 1") < at("DRAW quad#0 attrib=1"));
+  CHECK(at("RS ALPHAFUNC 5") < at("DRAW quad#0 attrib=1"));
+  CHECK(at("RS ZBIAS 16") > at("DRAW quad#0 attrib=1"));  // left at 16 after the alpha pass
+  CHECK(l.back() == "TEXTURE 1 NULL");
+  CHECK(d.get_rs(rs::FOGENABLE) == 1);
+  log.clear();
+  f.area_render(a, plnt);
+  l = state_lines(log);
+  // ALPHABLENDENABLE goes 1 then back to 0 before the alpha subset is drawn; fog is off after the model.
+  const auto draw = at("DRAW plnt#6 attrib=0");
+  REQUIRE(draw < static_cast<std::ptrdiff_t>(l.size()));
+  std::string last_blend;
+  for (std::ptrdiff_t k = 0; k < draw; ++k)
+    if (l[k].rfind("RS ALPHABLENDENABLE", 0) == 0) last_blend = l[k];
+  CHECK(last_blend == "RS ALPHABLENDENABLE 0");
+  CHECK(l.back() == "RS FOGENABLE 0");
+  CHECK(d.get_rs(rs::FOGENABLE) == 0);
+  CHECK_FALSE(f.context_flag());
+}
+
+TEST_CASE("sage: a model with mTransparency < 1 gets ZBIAS 16 and a TFACTOR alpha (DrawX prologue)") {
+  view::AreaData a = synthetic_area();
+  std::vector<std::string> log;
+  Device8 d(&log);
+  view::SageFrame f(d, view::SageCaps(), view::SageFrameOptions());
+  f.draw_x(a, 0, 0.5f);
+  const std::vector<std::string> l = state_lines(log);
+  REQUIRE(l.size() > 6);
+  CHECK(l[0].rfind("XFORM WORLD", 0) == 0);  // SOFTWAREVERTEXPROCESSING 0 is the default: ScDxStates filters it
+  CHECK(l[1] == "RS ZBIAS 16");
+  CHECK(l[2] == "RS ALPHABLENDENABLE 1");
+  CHECK(l[3] == "TSS0 ALPHAOP 4");
+  CHECK(l[4] == "TSS0 ALPHAARG1 3");
+  CHECK(l[5] == "TSS0 ALPHAARG2 2");  // D3D8 default CURRENT -> TEXTURE
+  CHECK(l[6] == "RS TEXTUREFACTOR 0x80000000");
+}
+
+TEST_CASE("area: A10 - every drawn subset of a coloured model feeds its vertex DIFFUSE to the shader") {
+  view::AreaData a = synthetic_area();
+  std::vector<std::string> calls;
+  auto dev = rhi::create_null_device(&calls);
+  rhi::TextureId rt = dev->create_render_target_ex(rhi::RenderTargetDesc{16, 16, true, 1.0f});
+  view::AreaRenderer r;
+  std::string err;
+  REQUIRE_MESSAGE(r.upload(*dev, a, view::RenderOptions(), &err), err);
+  REQUIRE(r.render(*dev, rt, a, view::make_camera(a, view::synthetic_camera(), 1.0f)));
+  // The vertex layout carries the colour at @location(3) (48-byte stride, offset 32).
+  bool layout = false;
+  for (const auto& l : calls)
+    if (l.rfind("create_mesh_pipeline", 0) == 0) layout = l.find("3:f32x4@32") != std::string::npos;
+  CHECK(layout);
+  CHECK(std::string(view::area_wgsl()).find("@location(3) c: vec4f") != std::string::npos);
+  CHECK(std::string(view::area_wgsl()).find("select(vec4f(1.0), c, u.a.y > 0.5)") != std::string::npos);
+  CHECK(r.last_stats().rhi_draws == 19);
+}
+
diff -ruN base/engine/tests/test_sage_osi.cpp work/engine/tests/test_sage_osi.cpp
--- base/engine/tests/test_sage_osi.cpp	1970-01-01 01:00:00
+++ work/engine/tests/test_sage_osi.cpp	2026-10-07 12:17:22
@@ -0,0 +1,200 @@
+// M1a-3: the bounded OSI reader (lomn/sage/osi.h) on the synthetic Base.osi program (tests/osi_builder.h; the A9 scene
+// carries the same bytes) and hostile variants of it: every truncation, bit flips, a bad version, an unknown opcode,
+// every per-file / per-method cap (REF3 revision 2: values measured on the real Base.osi, see osi.h).
+// The time/memory side of the caps is probed by probe_osi.cpp (ctest osi_probe, native and wasm32).
+#include <string>
+#include <vector>
+
+#include "doctest.h"
+#include "lomn/sage/osi.h"
+#include "osi_builder.h"
+
+using namespace lomn;
+
+namespace {
+std::vector<uint8_t> synthetic_osi() { return test::statt_osi(); }
+std::vector<uint8_t> with_code(const std::vector<uint8_t>& code) {
+  test::OsiSpec s;
+  s.code = code;
+  return test::build_osi(s);
+}
+}  // namespace
+
+TEST_CASE("osi: tables and the straight-line literal finder") {
+  sage::OsiFile o;
+  std::string err;
+  REQUIRE_MESSAGE(o.parse(synthetic_osi(), &err), err);
+  CHECK(o.major() == 4);
+  CHECK(o.minor() == 1);
+  REQUIRE(o.classes().size() == 1);
+  CHECK(o.find_class("LEGO_AREA_STATT") != nullptr);  // case-insensitive
+  uint64_t n = 0;
+  REQUIRE_MESSAGE(o.check_all(&n, &err), err);
+  CHECK(n == 15);  // push i32, 0, f32, sub, 0, f32, sub, f32, call, pop, i8, call, pop, nothing, return
+  std::vector<sage::OsiCall> calls;
+  REQUIRE_MESSAGE(o.eval_calls("lego_area_statt", "InitFull", calls, &err), err);
+  REQUIRE(calls.size() == 2);
+  CHECK(calls[0].fn == "setfog");
+  REQUIRE(calls[0].args.size() == 4);
+  double v = 0;
+  REQUIRE(calls[0].args[0].number(v));
+  CHECK(static_cast<uint32_t>(static_cast<int64_t>(v)) == 0xff808080u);
+  REQUIRE(calls[0].args[1].number(v));
+  CHECK(v == -5.0);  // 0 - 5 folded
+  REQUIRE(calls[0].args[2].number(v));
+  CHECK(v == -50.0);
+  CHECK(calls[0].args[3].kind == sage::OsiValue::Float);
+  CHECK(calls[1].fn == "setcavelighting");
+  REQUIRE(calls[1].args[0].number(v));
+  CHECK(v == 1.0);
+  CHECK_FALSE(o.eval_calls("lego_area_none", "initfull", calls, &err));
+  CHECK_FALSE(o.eval_calls("lego_area_statt", "process", calls, &err));
+}
+
+TEST_CASE("osi: every truncation and 2000 bit flips fail cleanly or parse; bad version and opcodes are rejected") {
+  const std::vector<uint8_t> good = synthetic_osi();
+  for (size_t len = 0; len < good.size(); ++len) {
+    sage::OsiFile o;
+    std::string err;
+    const bool ok = o.parse(std::vector<uint8_t>(good.begin(), good.begin() + static_cast<std::ptrdiff_t>(len)), &err);
+    if (ok) {  // a truncated bytecode tail can still parse its tables: the walk must then fail
+      std::vector<sage::OsiCall> calls;
+      CHECK_FALSE(o.eval_calls("lego_area_statt", "initfull", calls, &err));
+    }
+  }
+  uint32_t seed = 12345, parsed = 0;
+  for (int i = 0; i < 2000; ++i) {
+    std::vector<uint8_t> b = good;
+    seed = seed * 1664525u + 1013904223u;
+    b[(seed >> 8) % b.size()] ^= static_cast<uint8_t>(1u << ((seed >> 4) & 7));
+    sage::OsiFile o;
+    std::string err;
+    if (o.parse(b, &err)) {
+      ++parsed;
+      uint64_t n = 0;
+      o.check_all(&n, &err);
+      std::vector<sage::OsiCall> calls;
+      o.eval_calls("lego_area_statt", "initfull", calls, &err);
+    }
+  }
+  CHECK(parsed > 0);
+  std::vector<uint8_t> v = good;
+  v[4] = 6;  // version 6.1: another table layout
+  sage::OsiFile o;
+  std::string err;
+  CHECK_FALSE(o.parse(v, &err));
+  CHECK(err.find("unsupported version") != std::string::npos);
+  std::vector<uint8_t> bad = good;
+  bad[bad.size() - 1] = 0x01;  // the final Return becomes an undefined opcode
+  REQUIRE(o.parse(bad, &err));
+  std::vector<sage::OsiCall> calls;
+  CHECK_FALSE(o.eval_calls("lego_area_statt", "initfull", calls, &err));
+  CHECK(err.find("unknown opcode") != std::string::npos);
+}
+
+TEST_CASE("osi: a subroutine longer than kMaxOsiInstructions is rejected") {
+  std::vector<uint8_t> b = synthetic_osi();
+  b.pop_back();  // drop the Return: a run of Nops follows, then the Return
+  b.insert(b.end(), sage::kMaxOsiInstructions, 0x00);
+  b.push_back(0x52);
+  sage::OsiFile o;
+  std::string err;
+  REQUIRE(o.parse(b, &err));
+  std::vector<sage::OsiCall> calls;
+  CHECK_FALSE(o.eval_calls("lego_area_statt", "initfull", calls, &err));
+  CHECK(err.find("kMaxOsiInstructions") != std::string::npos);
+}
+
+TEST_CASE("osi: per-method caps (calls, argc, args, string bytes, literal stack) are errors with no partial result") {
+  sage::OsiFile o;
+  std::string err;
+  std::vector<sage::OsiCall> calls;
+  auto run = [&](const std::vector<uint8_t>& code) {
+    REQUIRE_MESSAGE(o.parse(with_code(code), &err), err);
+    calls.assign(3, sage::OsiCall());  // stale content must be cleared on success and on failure
+    return o.eval_calls("lego_area_statt", "initfull", calls, &err);
+  };
+  auto rep = [](std::vector<uint8_t> unit, uint32_t n) {
+    std::vector<uint8_t> c;
+    for (uint32_t i = 0; i < n; ++i) c.insert(c.end(), unit.begin(), unit.end());
+    c.push_back(0x52);
+    return c;
+  };
+  const std::vector<uint8_t> call0 = {0x82, 0, 0, 1, 0, 0, 0x30};  // call, Pop its result (as compiled scripts do)
+  CHECK(run(rep(call0, sage::kMaxOsiCallsPerMethod)));  // exactly at the cap: accepted
+  CHECK(calls.size() == sage::kMaxOsiCallsPerMethod);
+  CHECK_FALSE(run(rep(call0, sage::kMaxOsiCallsPerMethod + 1)));
+  CHECK(err.find("kMaxOsiCallsPerMethod") != std::string::npos);
+  CHECK(calls.empty());
+  std::vector<uint8_t> argc127 = {0x82, 0, 0, 1, 0, 127, 0x30};
+  CHECK(run(rep(argc127, sage::kMaxOsiArgsPerMethod / 127)));                  // 32 x 127 = 4064 args
+  CHECK_FALSE(run(rep(argc127, sage::kMaxOsiArgsPerMethod / 127 + 1)));        // 4191 > 4096
+  CHECK(err.find("kMaxOsiArgsPerMethod") != std::string::npos);
+  CHECK(calls.empty());
+  CHECK_FALSE(run(rep({0x82, 0, 0, 1, 0, 0x80}, 1)));  // argc -128 (s8): rejected, never clamped
+  CHECK(err.find("argc") != std::string::npos);
+  // String bytes copied into arguments: 255-char string pushed and passed one by one.
+  test::OsiSpec s;
+  s.strings.push_back(std::string(255, 'x'));
+  std::vector<uint8_t> unit = {0x46, 4, 0, 0x82, 0, 0, 1, 0, 1, 0x30};
+  s.code = rep(unit, sage::kMaxOsiStringArgBytes / 255);
+  REQUIRE(o.parse(test::build_osi(s), &err));
+  CHECK(o.eval_calls("lego_area_statt", "initfull", calls, &err));
+  s.code = rep(unit, sage::kMaxOsiStringArgBytes / 255 + 1);
+  REQUIRE(o.parse(test::build_osi(s), &err));
+  CHECK_FALSE(o.eval_calls("lego_area_statt", "initfull", calls, &err));
+  CHECK(err.find("kMaxOsiStringArgBytes") != std::string::npos);
+  CHECK(calls.empty());
+  // Literal stack depth.
+  CHECK(run(rep({0x45}, sage::kMaxOsiStackDepth)));
+  CHECK_FALSE(run(rep({0x45}, sage::kMaxOsiStackDepth + 1)));
+  CHECK(err.find("kMaxOsiStackDepth") != std::string::npos);
+}
+
+TEST_CASE("osi: check_all walks shared bytecode once and caps total instructions and calls per file") {
+  sage::OsiFile o;
+  std::string err;
+  uint64_t n = 0, nc = 0;
+  test::OsiSpec s;
+  s.code = test::osi_statt_program();
+  s.functions = 1000;  // all share the method's bytecode: walked once
+  REQUIRE(o.parse(test::build_osi(s), &err));
+  REQUIRE_MESSAGE(o.check_all(&n, &err, &nc), err);
+  CHECK(n == 15);
+  CHECK(nc == 2);
+  // Functions starting inside one long Nop run at distinct offsets: each walk is legal, the total is capped.
+  s.code.assign(sage::kMaxOsiInstructions - 1, 0x00);
+  s.code.push_back(0x52);
+  s.functions = 200;
+  s.function_stride = 1;
+  REQUIRE(o.parse(test::build_osi(s), &err));
+  CHECK_FALSE(o.check_all(&n, &err));
+  CHECK(err.find("kMaxOsiTotalInstructions") != std::string::npos);
+  // Calls per file: methods may each stay under kMaxOsiCallsPerMethod while the file exceeds kMaxOsiTotalCalls.
+  s.code.clear();
+  for (uint32_t i = 0; i < 5000; ++i) s.code.insert(s.code.end(), {0x82, 0, 0, 1, 0, 0});
+  s.code.push_back(0x52);
+  s.functions = 30;
+  s.function_stride = 6;  // 30 walks of ~5000 calls each = 150,000 > 131,072
+  REQUIRE(o.parse(test::build_osi(s), &err));
+  CHECK_FALSE(o.check_all(&n, &err));
+  CHECK(err.find("kMaxOsiTotalCalls") != std::string::npos);
+}
+
+TEST_CASE("osi: a failed parse leaves no partial tables; oversized files are rejected before reading") {
+  std::vector<uint8_t> b = synthetic_osi();
+  sage::OsiFile o;
+  std::string err;
+  REQUIRE(o.parse(b, &err));
+  REQUIRE(o.classes().size() == 1);
+  // Cut inside the source table's count: the string, class and symbol tables were already read when parse fails.
+  std::vector<uint8_t> t(b.begin(), b.end() - static_cast<std::ptrdiff_t>(test::osi_statt_program().size()) - 1);
+  CHECK_FALSE(o.parse(t, &err));
+  CHECK(err.find("symbol/source") != std::string::npos);
+  CHECK(o.classes().empty());
+  CHECK(o.strings().empty());
+  CHECK(o.major() == 0);
+  std::vector<uint8_t> big(static_cast<size_t>(sage::kMaxOsiBytes) + 1, 0);
+  CHECK_FALSE(o.parse(std::move(big), &err));
+  CHECK(err.find("too large") != std::string::npos);
+}
