+  State unlit = base;
+  unlit.rs[rs::LIGHTING] = 0;
+  out.push_back({"LIGHTING off: vertex colour", unlit, true});
+  out.push_back({"LIGHTING off, no vertex colour: opaque white", unlit, false});
+  State fog = unlit;
+  fog.rs[rs::FOGENABLE] = 1;
+  fog.rs[rs::FOGTABLEMODE] = kFogLinear;
+  fog.rs[rs::FOGSTART] = float_to_bits(0.0f);
+  fog.rs[rs::FOGEND] = float_to_bits(4.0f);
+  fog.rs[rs::FOGCOLOR] = 0xffff0000u;
+  out.push_back({"fog LINEAR at w 1 (start 0, end 4): f 0.75", fog, true});
+  fog.rs[rs::FOGTABLEMODE] = kFogExp;
+  fog.rs[rs::FOGDENSITY] = float_to_bits(0.7f);
+  out.push_back({"fog EXP density 0.7 at w 1", fog, true});
+  fog.rs[rs::FOGTABLEMODE] = kFogExp2;
+  out.push_back({"fog EXP2 density 0.7 at w 1", fog, true});
+  State test = unlit;  // alpha test only (GcArea::Render's plnt/tre1 context flag: DrawX turns blending off), TFACTOR alpha
+  test.rs[rs::ALPHABLENDENABLE] = 0;
+  test.rs[rs::ALPHATESTENABLE] = 1;
+  test.rs[rs::ALPHAFUNC] = kCmpGreater;
+  test.rs[rs::ALPHAREF] = 1;
+  test.tss[0][tss::ALPHAOP] = kTopSelectArg2;
+  test.tss[0][tss::ALPHAARG2] = kTaTFactor;
+  test.rs[rs::TEXTUREFACTOR] = 0x01000000u;  // alpha 1: 1 > 1 fails -> discarded
+  out.push_back({"alpha test GREATER ref 1, alpha 1: discarded", test, true});
+  test.rs[rs::TEXTUREFACTOR] = 0x02000000u;
+  out.push_back({"alpha test GREATER ref 1, alpha 2: kept (unblended)", test, true});
+  test.rs[rs::ALPHAREF] = 0;
+  test.rs[rs::TEXTUREFACTOR] = 0x01000000u;
+  out.push_back({"alpha test GREATER ref 0, alpha 1: kept (R13: ALPHAREF 0 keeps alpha 1/255)", test, true});
+  test.rs[rs::ALPHABLENDENABLE] = 1;
+  test.rs[rs::ALPHATESTENABLE] = 0;
+  test.rs[rs::TEXTUREFACTOR] = 0xb2000000u;  // 178 = round(255 * 0.7): the vllg river's textures.slb trans
+  out.push_back({"TFACTOR alpha 178 blended", test, true});
+  State mod = unlit;  // vertex alpha through ALPHAOP MODULATE(TFACTOR, TEXTURE) (DrawX's mTransparency < 1 path)
+  mod.rs[rs::ALPHABLENDENABLE] = 1;
+  mod.tss[0][tss::ALPHAOP] = kTopModulate;
+  mod.tss[0][tss::ALPHAARG1] = kTaTFactor;
+  mod.tss[0][tss::ALPHAARG2] = kTaTexture;
+  mod.rs[rs::TEXTUREFACTOR] = 0x80000000u;
+  out.push_back({"ALPHAOP MODULATE(TFACTOR 128, TEXTURE 255)", mod, true});
+  return out;
+}
+
+}  // namespace lomn::test
diff -ruN base/engine/tests/fuzz_osi.cpp work/engine/tests/fuzz_osi.cpp
--- base/engine/tests/fuzz_osi.cpp	1970-01-01 01:00:00
+++ work/engine/tests/fuzz_osi.cpp	2026-10-07 12:43:03
@@ -0,0 +1,100 @@
+// M1a-3 REF3 revision 2: deterministic mutation fuzzer for the OSI reader (lomn/sage/osi.h), built with ASan+UBSan
+// (-fno-sanitize-recover=all) natively and as wasm32 (emcc, Node) by `make fuzz-osi` (not part of check). Seeds: the
+// synthetic InitFull program, a small cap-edge program, and optionally a real Base.osi (argv[3]; user data, never
+// committed). Every accepted input is checked against the caps; a failed parse / eval must leave no partial state.
+// Usage: fuzz_osi ITERATIONS SEED [REAL_BASE_OSI]
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "lomn/sage/osi.h"
+#include "osi_builder.h"
+
+using namespace lomn;
+static uint64_t rng = 1;
+static uint32_t rnd(uint32_t n) {
+  rng = rng * 6364136223846793005ull + 1442695040888963407ull;
+  return n ? static_cast<uint32_t>((rng >> 33) % n) : 0;
+}
+static void die(const char* what, uint64_t it) {
+  std::printf("INVARIANT FAILED at iteration %llu: %s\n", static_cast<unsigned long long>(it), what);
+  std::exit(1);
+}
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const uint64_t iters = argc > 1 ? std::strtoull(argv[1], nullptr, 10) : 10000;
+  rng = argc > 2 ? std::strtoull(argv[2], nullptr, 10) : 1;
+  std::vector<std::vector<uint8_t>> seeds = {test::statt_osi()};
+  {
+    test::OsiSpec s;
+    s.strings.push_back(std::string(255, 'x'));
+    s.code = {0x46, 4, 0, 0x46, 4, 0, 0x82, 0, 0, 1, 0, 2, 0x30, 0x53, 2, 0, 0x45, 0x45, 0x31, 2, 0x52};
+    s.functions = 3;
+    s.function_stride = 3;
+    seeds.push_back(test::build_osi(s));
+  }
+  if (argc > 3) {
+    std::ifstream f(argv[3], std::ios::binary);
+    seeds.emplace_back(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+  }
+  const uint8_t interesting[] = {0, 1, 0x7f, 0x80, 0xff, 0x82, 0x46, 0x53, 0x54, 0x52, 0x31, 0x30, 0x45, 0x70, 0x73};
+  uint64_t accepted = 0, evaluated = 0, calls_seen = 0;
+  for (uint64_t it = 0; it < iters; ++it) {
+    const size_t si = rnd(static_cast<uint32_t>(seeds.size()));
+    std::vector<uint8_t> b = seeds[si];
+    const bool real = si >= 2;
+    const uint32_t nmut = 1 + rnd(real ? 4 : 8);
+    for (uint32_t m = 0; m < nmut && !b.empty(); ++m) {
+      const uint32_t at = rnd(static_cast<uint32_t>(b.size()));
+      switch (rnd(7)) {
+        case 0: b[at] ^= static_cast<uint8_t>(1u << rnd(8)); break;
+        case 1: b[at] = interesting[rnd(sizeof interesting)]; break;
+        case 2: b[at] = 0xff; if (at + 1 < b.size()) b[at + 1] = 0xff; break;   // u16 count/index to 0xffff
+        case 3: b.insert(b.begin() + at, static_cast<uint8_t>(rnd(256))); break;
+        case 4: b.erase(b.begin() + at, b.begin() + std::min<size_t>(b.size(), at + 1 + rnd(16))); break;
+        case 5: { const uint32_t len = std::min<uint32_t>(1 + rnd(64), static_cast<uint32_t>(b.size() - at));
+                  std::vector<uint8_t> chunk(b.begin() + at, b.begin() + at + len);
+                  for (uint32_t k = rnd(64); k > 0; --k) b.insert(b.begin() + at, chunk.begin(), chunk.end()); break; }
+        case 6: b.resize(at); break;
+      }
+    }
+    sage::OsiFile o;
+    std::string err;
+    if (!o.parse(std::move(b), &err)) {
+      if (!o.classes().empty() || !o.strings().empty()) die("failed parse left tables", it);
+      continue;
+    }
+    ++accepted;
+    uint64_t n = 0, nc = 0;
+    if (o.check_all(&n, &err, &nc) && (n > sage::kMaxOsiTotalInstructions || nc > sage::kMaxOsiTotalCalls)) die("check_all over cap", it);
+    uint32_t budget = real ? 16 : 1u << 30;  // the real seed has 8,406 methods: sample a few per input
+    for (const sage::OsiClass& k : o.classes())
+      for (const sage::OsiMethod& m : k.methods) {
+        if (real && rnd(512) != 0) continue;
+        if (budget-- == 0) break;
+        std::vector<sage::OsiCall> calls(2);
+        ++evaluated;
+        if (!o.eval_calls(k.name, m.name, calls, &err)) {
+          if (!calls.empty()) die("failed eval left calls", it);
+          continue;
+        }
+        if (calls.size() > sage::kMaxOsiCallsPerMethod) die("calls over cap", it);
+        uint64_t args = 0, sb = 0;
+        for (const sage::OsiCall& c : calls) {
+          if (c.args.size() > sage::kMaxOsiArgc) die("argc over cap", it);
+          args += c.args.size();
+          for (const sage::OsiValue& v : c.args) sb += v.s.size();
+        }
+        if (args > sage::kMaxOsiArgsPerMethod || sb > sage::kMaxOsiStringArgBytes) die("args/string bytes over cap", it);
+        calls_seen += calls.size();
+      }
+  }
+  std::printf("fuzz_osi: %llu inputs, %llu accepted, %llu method evaluations, %llu calls, 0 invariant failures\n",
+              static_cast<unsigned long long>(iters), static_cast<unsigned long long>(accepted),
+              static_cast<unsigned long long>(evaluated), static_cast<unsigned long long>(calls_seen));
+  return 0;
+}
diff -ruN base/engine/tests/osi_builder.h work/engine/tests/osi_builder.h
--- base/engine/tests/osi_builder.h	1970-01-01 01:00:00
+++ work/engine/tests/osi_builder.h	2026-10-07 12:16:46
@@ -0,0 +1,109 @@
+// Test-only OSI 4.1 writer (lomn/sage/osi.h layout): one class with one method "initfull", optional functions that
+// all point at the method's bytecode (or at offsets inside it), and the program the synthetic Base.osi carries
+// (lomn/view/synthetic.cpp writes the same bytes for the A9 scene). Shared by test_sage_osi.cpp and probe_osi.cpp so
+// the OSI reader's tests need nothing above lomn_sage.
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace lomn::test {
+
+struct OsiSpec {
+  std::vector<std::string> strings = {"gcareadirector", "setfog", "gclightdirector", "setcavelighting"};
+  std::string cls = "lego_area_statt";
+  std::vector<uint8_t> code;               // the method's bytecode
+  uint32_t functions = 0;                  // function-table entries
+  uint32_t function_stride = 0;            // function k starts at code + k * stride (0: all share the method's code)
+};
+
+inline void osi_put16(std::vector<uint8_t>& b, uint32_t v) {
+  b.push_back(static_cast<uint8_t>(v));
+  b.push_back(static_cast<uint8_t>(v >> 8));
+}
+inline void osi_put32(std::vector<uint8_t>& b, uint32_t v) {
+  for (int i = 0; i < 4; ++i) b.push_back(static_cast<uint8_t>(v >> (8 * i)));
+}
+
+inline std::vector<uint8_t> build_osi(const OsiSpec& s) {
+  std::vector<uint8_t> b = {'O', 'S', 'I', 0};
+  osi_put16(b, 4);
+  osi_put16(b, 1);
+  auto table = [&](const std::vector<std::string>& v) {
+    osi_put16(b, static_cast<uint32_t>(v.size()));
+    for (const std::string& x : v) {
+      b.push_back(static_cast<uint8_t>(x.size()));
+      b.insert(b.end(), x.begin(), x.end());
+      b.push_back(0);
+    }
+  };
+  table(s.strings);
+  table({});  // globals
+  osi_put16(b, s.functions);
+  std::vector<size_t> fpatch;
+  for (uint32_t k = 0; k < s.functions; ++k) {
+    b.push_back(1);
+    b.push_back('f');
+    fpatch.push_back(b.size());
+    osi_put32(b, 0);
+    osi_put16(b, 0);
+  }
+  osi_put16(b, 1);  // one class, no properties, one method: symbol 0 = "initfull"
+  b.push_back(0);
+  b.push_back(1);
+  osi_put16(b, 0);
+  const size_t mpatch = b.size();
+  osi_put32(b, 0);
+  b.push_back(static_cast<uint8_t>(s.cls.size()));
+  b.insert(b.end(), s.cls.begin(), s.cls.end());
+  b.push_back(0);
+  table({"initfull"});
+  table({});  // sources
+  const uint32_t code = static_cast<uint32_t>(b.size());
+  auto patch = [&](size_t at, uint32_t v) {
+    for (int i = 0; i < 4; ++i) b[at + i] = static_cast<uint8_t>(v >> (8 * i));
+  };
+  patch(mpatch, code);
+  for (uint32_t k = 0; k < s.functions; ++k) patch(fpatch[k], code + k * s.function_stride);
+  b.insert(b.end(), s.code.begin(), s.code.end());
+  return b;
+}
+
+// The synthetic scene's InitFull: SetFog(0xff808080, 0 - 5, 0 - 50, 0.1f); SetCaveLighting(1).
+inline std::vector<uint8_t> osi_statt_program() {
+  std::vector<uint8_t> c;
+  auto f32 = [&](float f) {
+    uint32_t x;
+    std::memcpy(&x, &f, 4);
+    osi_put32(c, x);
+  };
+  c.push_back(0x40);
+  osi_put32(c, 0xff808080u);  // PushConstanti32
+  c.push_back(0x45);          // PushConstant0
+  c.push_back(0x44);
+  f32(5.0f);
+  c.push_back(0x71);          // Subtract -> -5
+  c.push_back(0x45);
+  c.push_back(0x44);
+  f32(50.0f);
+  c.push_back(0x71);          // -> -50
+  c.push_back(0x44);
+  f32(0.1f);
+  c.insert(c.end(), {0x82, 0, 0, 1, 0, 4});  // CallGameFunction gcareadirector.setfog/4
+  c.push_back(0x30);                         // Pop
+  c.insert(c.end(), {0x43, 1});              // PushConstanti8 1
+  c.insert(c.end(), {0x82, 2, 0, 3, 0, 1});  // CallGameFunction gclightdirector.setcavelighting/1
+  c.push_back(0x30);
+  c.push_back(0x47);  // PushNothing
+  c.push_back(0x52);  // Return
+  return c;
+}
+
+inline std::vector<uint8_t> statt_osi() {
+  OsiSpec s;
+  s.code = osi_statt_program();
+  return build_osi(s);
+}
+
+}  // namespace lomn::test
diff -ruN base/engine/tests/probe_osi.cpp work/engine/tests/probe_osi.cpp
--- base/engine/tests/probe_osi.cpp	1970-01-01 01:00:00
+++ work/engine/tests/probe_osi.cpp	2026-10-07 12:51:15
@@ -0,0 +1,106 @@
+// REF3 revision 2: crafted-input TIME and MEMORY probes for the OSI reader (lomn/sage/osi.h), one per loop whose count
+// an attacker controls (M1a-1 audit rule). Each probe builds a hostile Base.osi in memory, runs parse + check_all +
+// eval_calls, and must finish with the expected cap error in <= kMaxSeconds and grow the process peak memory by
+// <= kMaxGrowthMB. Runs natively (peak RSS) and as wasm32 under Node (linear-memory size, 2 GB cap; it only grows when
+// the allocator runs out of the initial 16 MiB, so +0.0 there means every probe fit in it): ctest osi_probe.
+// Before the caps, "calls" (Fable's 600 KB call flood) took 486 MB natively.
+#include <chrono>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include "lomn/sage/osi.h"
+#include "osi_builder.h"
+
+#if defined(__EMSCRIPTEN__)
+static double peak_mb() { return __builtin_wasm_memory_size(0) * 65536.0 / 1048576.0; }
+#else
+#include <sys/resource.h>
+static double peak_mb() {
+  rusage u{};
+  getrusage(RUSAGE_SELF, &u);
+#if defined(__APPLE__)
+  return u.ru_maxrss / 1048576.0;  // bytes
+#else
+  return u.ru_maxrss / 1024.0;  // KiB
+#endif
+}
+#endif
+
+using namespace lomn;
+
+namespace {
+constexpr double kMaxSeconds = 5.0, kMaxGrowthMB = 64.0;
+
+std::vector<uint8_t> rep(std::vector<uint8_t> unit, uint32_t n, bool ret = true) {
+  std::vector<uint8_t> c;
+  c.reserve(unit.size() * n + 1);
+  for (uint32_t i = 0; i < n; ++i) c.insert(c.end(), unit.begin(), unit.end());
+  if (ret) c.push_back(0x52);
+  return c;
+}
+
+bool probe(const char* name, std::vector<uint8_t> file, const char* want) {  // want == nullptr: must be accepted
+  const double m0 = peak_mb();
+  const auto t0 = std::chrono::steady_clock::now();
+  const size_t bytes = file.size();
+  std::string err, got;
+  {
+    sage::OsiFile o;
+    if (!o.parse(std::move(file), &err)) {
+      got = err;
+    } else {
+      uint64_t n = 0;
+      if (!o.check_all(&n, &err)) got = err;
+      std::vector<sage::OsiCall> calls;
+      if (!o.eval_calls("lego_area_statt", "initfull", calls, &err) && got.empty()) got = err;
+    }
+  }
+  const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+  const double grow = peak_mb() - m0;
+  const bool want_ok = want == nullptr ? got.empty() : got.find(want) != std::string::npos;
+  const bool ok = want_ok && s <= kMaxSeconds && grow <= kMaxGrowthMB;
+  std::printf("%s %-14s %8zu bytes  %.3f s  peak +%.1f MB (%.1f MB)  -> %s\n", ok ? "ok  " : "FAIL", name, bytes, s, grow,
+              peak_mb(), got.empty() ? "(accepted)" : got.c_str());
+  return ok;
+}
+}  // namespace
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);  // every line survives a timeout kill
+  bool ok = true;
+  test::OsiSpec s;
+  s.strings.push_back(std::string(255, 'x'));  // string 4: the longest a u8 length allows
+  // 1. Fable's call flood: 100,000 x CallGameFunction argc 127 (600 KB): one subroutine past the instruction cap.
+  s.code = rep({0x82, 0, 0, 1, 0, 127}, 100000);
+  ok &= probe("calls", test::build_osi(s), "kMaxOsiInstructions");
+  // 1b. The same flood inside the instruction cap: the per-method argument cap stops it.
+  s.code = rep({0x82, 0, 0, 1, 0, 127}, 32000);
+  ok &= probe("calls-in-cap", test::build_osi(s), "kMaxOsiArgsPerMethod");
+  // 1c. argc-0 calls with their results popped: the per-method call cap.
+  s.code = rep({0x82, 0, 0, 1, 0, 0, 0x30}, 16000);
+  ok &= probe("calls-argc0", test::build_osi(s), "kMaxOsiCallsPerMethod");
+  // 2. String-push flood (each push copied a 255-byte string onto the literal stack).
+  s.code = rep({0x46, 4, 0}, 32000);
+  ok &= probe("stack", test::build_osi(s), "kMaxOsiStackDepth");
+  // 2b. 255-byte strings passed one per call: the string-bytes cap.
+  s.code = rep({0x46, 4, 0, 0x82, 0, 0, 1, 0, 1, 0x30}, 3000);
+  ok &= probe("string-args", test::build_osi(s), "kMaxOsiStringArgBytes");
+  // 3. 65,535 functions sharing one 32,767-Nop run (walked once), then 32,000 functions starting at distinct offsets of
+  // it (each walk legal, 32,000 x ~16,000 instructions in total): check_all's total-instruction cap.
+  s.code = rep({0x00}, sage::kMaxOsiInstructions - 1);
+  s.functions = 65535;
+  s.function_stride = 0;
+  ok &= probe("funcs-shared", test::build_osi(s), nullptr);  // shared bytecode: accepted (no cap hit), walked once
+  s.functions = 32000;
+  s.function_stride = 1;
+  ok &= probe("funcs-distinct", test::build_osi(s), "kMaxOsiTotalInstructions");
+  s.functions = 0;
+  // 4. A subroutine as long as the file cap allows.
+  s.code = rep({0x00}, static_cast<uint32_t>(sage::kMaxOsiBytes) - 1024);
+  ok &= probe("nops", test::build_osi(s), "kMaxOsiInstructions");
+  // 5. One byte over the file cap.
+  ok &= probe("too-large", std::vector<uint8_t>(static_cast<size_t>(sage::kMaxOsiBytes) + 1, 0), "too large");
+  std::printf("%s\n", ok ? "osi_probe: all probes bounded" : "osi_probe: FAILED");
+  return ok ? 0 : 1;
+}
diff -ruN base/engine/tests/test_area_states.cpp work/engine/tests/test_area_states.cpp
--- base/engine/tests/test_area_states.cpp	1970-01-01 01:00:00
+++ work/engine/tests/test_area_states.cpp	2026-10-07 12:40:43
@@ -0,0 +1,87 @@
+// M1a-3 area-loader additions (lomn/view/area.h): LIGHT.slb / default lights (GcLightLoader::LoadLights 0x00470010,
+// GrSetDefaultLighting 0x00470560), the Base.osi fog / cave-lighting literals and textures.slb, on the synthetic state scene.
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "doctest.h"
+#include "lomn/d3d/device8.h"
+#include "lomn/fs.h"
+#include "lomn/view/area.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn;
+using namespace lomn::d3d;
+
+namespace {
+
+view::AreaData synthetic_area() {
+  fs::MemoryFileSystem mfs;
+  REQUIRE(view::mount_synthetic_install(mfs));
+  view::AreaData a;
+  std::string err;
+  REQUIRE_MESSAGE(view::load_area(mfs, view::kSyntheticLevel, view::kSyntheticStateArea, view::AreaOptions(), a, &err), err);
+  return a;
+}
+
+}  // namespace
+
+TEST_CASE("area: lights, fog and special textures come from LIGHT.slb, Base.osi and textures.slb") {
+  view::AreaData a = synthetic_area();
+  // LIGHT.slb: a point light and a directional one (+ the opposite "Shad" fill for the first directional).
+  REQUIRE(a.lights.size() == 3);
+  CHECK(a.lights_source == "light_slb");
+  const Light8& pt = a.lights[0].light;
+  CHECK(pt.type == kLightPoint);
+  CHECK(pt.range == 20.0f);
+  CHECK(pt.attenuation1 == doctest::Approx(1.0f / (0.15f * 20.0f)));
+  // intensity 1.0 > 0.9 -> x 1.2; then SetCaveLighting(1) from the script: style 0 -> SetIntensity(0.25) on the base.
+  CHECK(pt.diffuse.g == doctest::Approx(0.5f * 0.25f));
+  CHECK(a.lights[1].name == "sun1");
+  CHECK(a.lights[1].light.direction[1] == -1.0f);
+  CHECK(a.lights[2].name == "Shad");
+  CHECK(a.lights[2].light.direction[0] == -0.5f);
+  CHECK(a.cave_lighting);
+  CHECK(a.fog.source == "osi");
+  CHECK(a.fog.color == 0xff808080u);
+  CHECK(a.fog.start == 5.0f);  // GcAreaDirector::SetFog negates the script's -5 / -50
+  CHECK(a.fog.end == 50.0f);
+  CHECK(a.fog.density == doctest::Approx(0.1f));
+  CHECK(a.script_class == "lego_area_statt");
+  CHECK(a.special_textures == 3);
+  CHECK(a.special_matches == 2);  // "tfx" (trans) and "cut" (scroll); "red" is (1, 0, 0) and skipped
+  CHECK(a.level_type == uint8_t('t' - '0'));
+}
+
+TEST_CASE("area: default lighting by level type (GrSetDefaultLighting)") {
+  fs::MemoryFileSystem mfs;
+  REQUIRE(view::mount_synthetic_install(mfs));
+  std::vector<uint8_t> blk;
+  REQUIRE(mfs.read("Root/Data/Levels/levt/levt.blk", blk) == fs::Error::None);
+  for (const char* lev : {"lev1", "lev4"}) {
+    fs::MemoryFileSystem m2;
+    REQUIRE(m2.mount(std::string("Root/Data/Levels/") + lev + "/" + lev + ".blk", blk));
+    std::vector<uint8_t> area;
+    REQUIRE(mfs.read("Root/Data/Levels/levt/test.blk", area) == fs::Error::None);
+    REQUIRE(m2.mount(std::string("Root/Data/Levels/") + lev + "/quad.blk", area));  // no quad_light.slb in it
+    view::AreaData a;
+    std::string err;
+    REQUIRE_MESSAGE(view::load_area(m2, lev, "quad", view::AreaOptions(), a, &err), err);
+    CHECK(a.lights_source == "default");
+    if (std::string(lev) == "lev1") {
+      REQUIRE(a.lights.size() == 1);  // "LmbA": ambient 120/255 grey
+      CHECK(a.lights[0].name == "LmbA");
+      CHECK(a.lights[0].light.ambient.r == doctest::Approx(0.47058824f));
+      CHECK(a.lights[0].light.diffuse.r == 0.0f);
+    } else {
+      REQUIRE(a.lights.size() == 2);  // SunL white x 1.2, Shad blue-grey (level type 4)
+      CHECK(a.lights[0].name == "SunL");
+      CHECK(a.lights[0].light.diffuse.r == doctest::Approx(1.2f));
+      CHECK(a.lights[0].light.direction[0] == doctest::Approx(0.85570401f));
+      CHECK(a.lights[1].light.diffuse.b == doctest::Approx(0.54901963f * 1.2f));
+    }
+  }
+}
