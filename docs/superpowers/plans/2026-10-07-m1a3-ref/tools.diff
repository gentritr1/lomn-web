diff -ruN -x __pycache__ base/tools/research/oracle/ffp_oracle.py work/tools/research/oracle/ffp_oracle.py
--- base/tools/research/oracle/ffp_oracle.py	1970-01-01 01:00:00
+++ work/tools/research/oracle/ffp_oracle.py	2026-10-07 12:37:21
@@ -0,0 +1,177 @@
+"""Independent check of the C++ CPU reference of the D3D8 fixed-function formulas (engine/src/d3d/ffp.cpp
+reference_vertex_color / reference_fragment, which is also the expectation of the GPU probe gpu_ffp).
+
+Written from the DirectX 8.1 SDK documentation ("Mathematics of Lighting", "Light Attenuation Over Distance",
+"Fog Formulas", "Alpha Testing State", "Texture Blending" / D3DTEXTUREOP, D3DTA, D3DMATERIALCOLORSOURCE), NOT from
+ffp.cpp; float64 throughout. Input: the JSON lines of lomn_ffp_cases (engine/tests/ffp_cases.cpp): gpu_ffp's cases plus
+seeded random samples, each with every input the reference reads and its results.
+
+Conventions this oracle shares with the shim on purpose (they are declared deviations or render-target conventions,
+not D3D8 facts): an unbound texture samples opaque white (deviation V3); with blending off the written alpha is 1.
+Cases outside the formulas modelled here are SKIPPED and counted, never silently passed:
+  FOGENABLE with both FOGTABLEMODE and FOGVERTEXMODE = NONE (D3D8 then takes the fog factor from the vertex specular
+  alpha; the area path never does this: AppMain sets FOGTABLEMODE LINEAR).
+Usage: ffp_oracle.py CASES.jsonl   (exit 0 when every non-skipped case agrees within TOL; prints a summary)
+"""
+import json, math, sys
+
+TOL = 1e-4
+D3DTOP_DISABLE, D3DTOP_SELECTARG1, D3DTOP_SELECTARG2, D3DTOP_MODULATE = 1, 2, 3, 4
+D3DTA_DIFFUSE, D3DTA_CURRENT, D3DTA_TEXTURE, D3DTA_TFACTOR = 0, 1, 2, 3
+D3DLIGHT_POINT, D3DLIGHT_DIRECTIONAL = 1, 3
+D3DMCS_COLOR1 = 1
+D3DFOG_NONE, D3DFOG_EXP, D3DFOG_EXP2, D3DFOG_LINEAR = 0, 1, 2, 3
+
+
+def argb(v):
+    return ((v >> 16 & 255) / 255.0, (v >> 8 & 255) / 255.0, (v & 255) / 255.0, (v >> 24 & 255) / 255.0)
+
+
+def bits_float(v):
+    import struct
+    return struct.unpack('<f', struct.pack('<I', v & 0xffffffff))[0]
+
+
+def inv3(m):
+    """Inverse of a 3x3 (list of rows)."""
+    a, b, c = m[0]; d, e, f = m[1]; g, h, i = m[2]
+    det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
+    return [[(e * i - f * h) / det, (c * h - b * i) / det, (b * f - c * e) / det],
+            [(f * g - d * i) / det, (a * i - c * g) / det, (c * d - a * f) / det],
+            [(d * h - e * g) / det, (b * g - a * h) / det, (a * e - b * d) / det]]
+
+
+def lit_vertex(c):
+    rs = c['rs']
+    vcol = c['vcol']
+    if not rs['LIGHTING']:
+        # Unlit: the vertex diffuse colour, or opaque white when the vertex format has none.
+        return list(vcol) if c['has_vcol'] else [1.0, 1.0, 1.0, 1.0]
+    mat = c['material']
+    # D3DRS_DIFFUSEMATERIALSOURCE = COLOR1 takes the vertex diffuse colour when COLORVERTEX is on and the vertex has one;
+    # a missing vertex colour falls back to the material.
+    cd = vcol if (c['has_vcol'] and rs['COLORVERTEX'] and rs['DIFFUSEMATERIALSOURCE'] == D3DMCS_COLOR1) else mat['diffuse']
+    W = c['world']
+    rows = [W[0:4], W[4:8], W[8:12], W[12:16]]
+    p = c['p']
+    P = [p[0] * rows[0][j] + p[1] * rows[1][j] + p[2] * rows[2][j] + rows[3][j] for j in range(3)]
+    # Normals go through the inverse transpose of the upper 3x3 (row-vector convention: n' = n * (M^-1)^T).
+    Mi = inv3([r[0:3] for r in rows[0:3]])
+    n = c['n']
+    N = [sum(n[k] * Mi[j][k] for k in range(3)) for j in range(3)]
+    ga = argb(rs['AMBIENT'])
+    amb = [ga[0], ga[1], ga[2]]
+    dif = [0.0, 0.0, 0.0]
+    for L in c['lights']:
+        if L['type'] == D3DLIGHT_DIRECTIONAL:
+            dx = L['direction']
+            ln = math.sqrt(sum(x * x for x in dx))
+            Ldir = [-x / ln for x in dx] if ln > 0 else [0.0, 0.0, 0.0]
+            atten = 1.0
+        elif L['type'] == D3DLIGHT_POINT:
+            V = [L['position'][k] - P[k] for k in range(3)]
+            dist = math.sqrt(sum(x * x for x in V))
+            if dist > L['range']:  # beyond Range the light has no effect
+                continue
+            Ldir = [x / dist for x in V] if dist > 0 else [0.0, 0.0, 0.0]
+            a0, a1, a2 = L['att']
+            atten = 1.0 / (a0 + a1 * dist + a2 * dist * dist)
+        else:
+            raise SystemExit('light type %d not modelled' % L['type'])
+        ndotl = max(0.0, sum(N[k] * Ldir[k] for k in range(3)))
+        for k in range(3):
+            amb[k] += atten * L['ambient'][k]           # Ambient = Ca * (Ga + sum(Atten * La))
+            dif[k] += cd[k] * L['diffuse'][k] * ndotl * atten  # Diffuse = sum(Cd * Ld * (N.Ldir) * Atten)
+    out = [min(1.0, max(0.0, mat['emissive'][k] + mat['ambient'][k] * amb[k] + dif[k])) for k in range(3)]
+    return out + [cd[3]]  # the lit colour's alpha is the diffuse alpha
+
+
+def fragment(c):
+    """Returns (kept, rgba)."""
+    rs, ts = c['rs'], c['tss0']
+    d = c['d']
+    texel = c['texel'] if c['bound'] else [1.0, 1.0, 1.0, 1.0]
+    tf = argb(rs['TEXTUREFACTOR'])
+
+    def arg(a):
+        a &= 0xf
+        if a == D3DTA_TEXTURE: return texel
+        if a == D3DTA_TFACTOR: return tf
+        return d  # DIFFUSE, and CURRENT (= diffuse on stage 0)
+
+    def op(o, a1, a2, ch):
+        if o == D3DTOP_SELECTARG1: return a1[ch]
+        if o == D3DTOP_SELECTARG2: return a2[ch]
+        if o == D3DTOP_MODULATE: return a1[ch] * a2[ch]
+        return d[ch]  # DISABLE: stage 0 passes the diffuse (current) value through
+
+    col = [op(ts['COLOROP'], arg(ts['COLORARG1']), arg(ts['COLORARG2']), ch) for ch in range(3)]
+    alpha = op(ts['ALPHAOP'], arg(ts['ALPHAARG1']), arg(ts['ALPHAARG2']), 3)
+    if rs['ALPHATESTENABLE']:
+        a8 = math.floor(min(1.0, max(0.0, alpha)) * 255.0 + 0.5)  # the 8-bit alpha the test compares
+        ref = rs['ALPHAREF'] & 0xff
+        f = rs['ALPHAFUNC']
+        ok = {1: False, 2: a8 < ref, 3: a8 == ref, 4: a8 <= ref, 5: a8 > ref, 6: a8 != ref, 7: a8 >= ref, 8: True}.get(f, True)
+        if not ok:
+            return False, None
+    out = col + [alpha if rs['ALPHABLENDENABLE'] else 1.0]
+    if rs['FOGENABLE']:
+        mode = rs['FOGTABLEMODE'] if rs['FOGTABLEMODE'] != D3DFOG_NONE else rs['FOGVERTEXMODE']
+        z = c['w']
+        st, en, de = bits_float(rs['FOGSTART']), bits_float(rs['FOGEND']), bits_float(rs['FOGDENSITY'])
+        if mode == D3DFOG_LINEAR:
+            fo = min(1.0, max(0.0, (en - z) / (en - st)))
+        elif mode == D3DFOG_EXP:
+            fo = math.exp(-(z * de))  # 1 / e^(z * density)
+        elif mode == D3DFOG_EXP2:
+            fo = math.exp(-((z * de) ** 2))  # 1 / e^((z * density)^2)
+        else:
+            raise ValueError('skip')
+        fc = argb(rs['FOGCOLOR'])
+        out = [fo * out[k] + (1.0 - fo) * fc[k] for k in range(3)] + [out[3]]
+    return True, out
+
+
+def main():
+    n = skipped = bad = 0
+    worst_v = worst_f = 0.0
+    kept_cases = discards = 0
+    for line in open(sys.argv[1]):
+        c = json.loads(line)
+        n += 1
+        v = lit_vertex(c)
+        dv = max(abs(v[k] - c['out_vertex'][k]) for k in range(4))
+        worst_v = max(worst_v, dv)
+        try:
+            kept, f = fragment(c)
+        except ValueError:
+            skipped += 1
+            if dv > TOL:
+                bad += 1
+                print('MISMATCH vertex %s: oracle %s shim %s' % (c['what'], v, c['out_vertex']))
+            continue
+        msg = None
+        if dv > TOL:
+            msg = 'vertex: oracle %s shim %s' % (v, c['out_vertex'])
+        if kept != c['out_kept']:
+            msg = 'alpha test: oracle kept=%s shim kept=%s' % (kept, c['out_kept'])
+        elif kept:
+            kept_cases += 1
+            df = max(abs(f[k] - c['out_fragment'][k]) for k in range(4))
+            worst_f = max(worst_f, df)
+            if df > TOL:
+                msg = 'fragment: oracle %s shim %s' % (f, c['out_fragment'])
+        else:
+            discards += 1
+        if msg:
+            bad += 1
+            if bad <= 10:
+                print('MISMATCH case %d (%s): %s' % (n, c['what'], msg))
+    print('ffp_oracle: %d cases (%d fragments kept, %d discarded by the alpha test, %d fragment checks skipped: fog with '
+          'no fog mode), max |vertex diff| %.2e, max |fragment diff| %.2e, %d mismatches (tolerance %g)'
+          % (n, kept_cases, discards, skipped, worst_v, worst_f, bad, TOL))
+    sys.exit(1 if bad or n == 0 else 0)
+
+
+if __name__ == '__main__':
+    main()
diff -ruN -x __pycache__ base/tools/research/osi.py work/tools/research/osi.py
--- base/tools/research/osi.py	1970-01-01 01:00:00
+++ work/tools/research/osi.py	2026-10-07 12:33:44
@@ -0,0 +1,252 @@
+"""Bounded OSI (SAGE script bytecode) reader + literal finder for M1a-3 (camera / fog literals).
+
+Format (header + tables) follows the public SAGESharp reader (github.com/TheLegendOfMataNui/SAGESharp,
+SAGESharp/OSI/OSIFile.cs + BCLInstruction.cs, MPL-2.0; read, not copied). Everything here is our own code and treats
+the file as untrusted: every read is bounds-checked, table counts are capped by the remaining bytes, and bytecode is
+walked linearly per subroutine with an instruction cap.
+
+Two call finders, which answer DIFFERENT questions (do not cross-check one against the other):
+  eval_calls(d, o, cls, method)   the straight-line constant evaluator - the same algorithm as the C++
+                                  lomn::sage::OsiFile::eval_calls (osi.h) and the one a9_oracle.py uses: folds 0 - 40
+                                  to -40, so it reports the values the game passes.  CLI: --eval CLASS METHOD
+  find_plain_push_calls(d, o, wanted)  a whole-file SURVEY of where a function is called: decodes only the argc
+                                  instructions right before each call, and only when they are plain pushes; a computed
+                                  argument (vllg's SetFog start "0 - 40") reads as None and the slots shift (so its fog
+                                  colour prints as 0).  CLI: --plain-calls class.func ...
+
+Usage: osi.py Base.osi --eval lego_area_vllg initfull                                  (JSON to stdout)
+       osi.py Base.osi --plain-calls gcareadirector.setfog gcgraphicsoptions.setdrawdistance ...
+       osi.py Base.osi --summary
+"""
+import json, struct, sys
+
+MAX_INSNS_PER_SUB = 1 << 15  # = the C++ kMaxOsiInstructions (measured maximum 1,707)
+# opcode -> operand struct format (little-endian); 'T' = 3-byte signed int.
+OPS = {0x04: 'HH', 0x05: 'HH', 0x06: 'HH', 0x10: 'H', 0x11: 'H', 0x12: 'H', 0x13: 'H', 0x14: 'b', 0x15: 'H', 0x16: 'H',
+       0x17: 'H', 0x21: 'H', 0x22: 'H', 0x23: 'b', 0x24: 'H', 0x25: 'H', 0x31: 'b', 0x33: 'b', 0x34: 'b', 0x40: 'i',
+       0x41: 'T', 0x42: 'h', 0x43: 'b', 0x44: 'f', 0x46: 'H', 0x48: 'I', 0x49: 'H', 0x50: 'b', 0x51: 'b', 0x53: 'h',
+       0x54: 'h', 0x80: 'HH', 0x81: 'HH', 0x82: 'HHb', 0x83: 'Hb', 0x84: 'ib'}
+NOARG = {0x00, 0x02, 0x03, 0x18, 0x19, 0x1A, 0x30, 0x32, 0x35, 0x45, 0x47, 0x52, 0x60, 0x61, 0x62, 0x63, 0x64, 0x6A,
+         0x6B, 0x6C, 0x6D, 0x6E, 0x6F, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x7A, 0x7B, 0x90, 0x91,
+         0x92, 0x93, 0x94, 0x95, 0x96, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xB0, 0xB1, 0xB2, 0xB8, 0xB9,
+         0xBA, 0xBB, 0xBC, 0xBD, 0xBF, 0xFF}
+
+
+class OsiError(Exception):
+    pass
+
+
+class R:
+    def __init__(self, d, p=0):
+        self.d, self.p = d, p
+
+    def take(self, n):
+        if n < 0 or self.p + n > len(self.d):
+            raise OsiError('read past end at %d (+%d)' % (self.p, n))
+        b = self.d[self.p:self.p + n]
+        self.p += n
+        return b
+
+    def u8(self): return self.take(1)[0]
+    def u16(self): return struct.unpack('<H', self.take(2))[0]
+    def u32(self): return struct.unpack('<I', self.take(4))[0]
+
+    def count(self, min_entry):
+        n = self.u16()
+        if n * min_entry > len(self.d) - self.p:
+            raise OsiError('count %d exceeds remaining bytes' % n)
+        return n
+
+    def strings(self):
+        out = []
+        for _ in range(self.count(2)):
+            n = self.u8()
+            out.append(self.take(n).decode('latin1'))
+            self.take(1)  # terminator
+        return out
+
+
+def parse(d):
+    r = R(d)
+    if r.take(4) != b'OSI\0':
+        raise OsiError('bad magic')
+    major, minor = r.u16(), r.u16()
+    if major != 4:
+        raise OsiError('unsupported version %d.%d (LOMN uses 4.1)' % (major, minor))
+    o = {'version': [major, minor]}
+    o['strings'] = r.strings()
+    o['globals'] = r.strings()
+    funcs = []
+    for _ in range(r.count(7)):
+        n = r.u8()
+        name = r.take(n).decode('latin1')
+        off, npar = r.u32(), r.u16()
+        funcs.append((name, off, npar))
+    classes = []
+    for _ in range(r.count(2)):
+        props = [r.u16() for _ in range(r.u8())]
+        meths = []
+        for _ in range(r.u8()):
+            meths.append((r.u16(), r.u32()))
+        classes.append([None, props, meths])
+    for c in classes:
+        n = r.u8()
+        c[0] = r.take(n).decode('latin1')
+        r.take(1)
+    o['symbols'] = r.strings()
+    o['sources'] = r.strings()
+    o['functions'] = funcs
+    o['classes'] = classes
+    o['tables_end'] = r.p
+    return o
+
+
+def disasm(d, start):
+    """Linear walk of one subroutine (SAGESharp's rule: stop at a Return past the last forward branch target)."""
+    r = R(d, start)
+    out, last_target = [], 0
+    for _ in range(MAX_INSNS_PER_SUB):
+        at = r.p
+        op = r.u8()
+        if op in OPS:
+            args = []
+            for f in OPS[op]:
+                if f == 'T':
+                    b = r.take(3)
+                    v = b[0] | b[1] << 8 | b[2] << 16
+                    args.append(v - (1 << 24) if v & 0x800000 else v)
+                else:
+                    args.append(struct.unpack('<' + f, r.take(struct.calcsize(f)))[0])
+        elif op in NOARG:
+            args = []
+        else:
+            raise OsiError('unknown opcode 0x%02x at %d' % (op, at))
+        out.append((at, op, args))
+        if op in (0x53, 0x54):
+            last_target = max(last_target, r.p + args[0])
+        elif op == 0x52 and r.p > last_target:
+            return out
+    raise OsiError('subroutine at %d exceeds the instruction cap' % start)
+
+
+def literal(o, ins):
+    at, op, a = ins
+    if op in (0x40, 0x41, 0x42, 0x43): return a[0]
+    if op == 0x44: return a[0]
+    if op == 0x45: return 0
+    if op == 0x46: return o['strings'][a[0]] if a[0] < len(o['strings']) else None
+    if op == 0x48: return '0x%08x' % a[0]
+    return None
+
+
+def subroutines(o):
+    for name, off, _ in o['functions']:
+        yield name, off
+    seen = set()
+    for cname, _, meths in o['classes']:
+        for sym, off in meths:
+            if off in seen:
+                continue
+            seen.add(off)
+            mname = o['symbols'][sym] if sym < len(o['symbols']) else '?'
+            yield cname + '.' + mname, off
+
+
+def find_plain_push_calls(d, o, wanted):
+    """Every CallGameFunction(class, func, argc) whose 'class.func' (lower case) is in `wanted`, with the argc preceding
+    instructions decoded as literals where they are plain pushes (None otherwise)."""
+    hits = []
+    for sub, off in subroutines(o):
+        ins = disasm(d, off)
+        for i, (at, op, a) in enumerate(ins):
+            if op != 0x82:
+                continue
+            cls = o['strings'][a[0]] if a[0] < len(o['strings']) else '?'
+            fn = o['strings'][a[1]] if a[1] < len(o['strings']) else '?'
+            key = (cls + '.' + fn).lower()
+            if key not in wanted:
+                continue
+            argc = a[2]
+            prev = ins[max(0, i - argc):i]
+            args = [literal(o, p) for p in prev] if len(prev) == argc else None
+            hits.append({'call': key, 'in': sub, 'offset': at, 'argc': argc, 'args': args})
+    return hits
+
+
+def eval_calls(d, o, cls, method):
+    """CallGameFunction calls in cls.method with their literal arguments, evaluating straight-line constant code:
+    pushes, + - * / on numbers, Pop/PopN; every other opcode, branch or branch target forgets the stack."""
+    off = None
+    for name, meths in ((c[0], c[2]) for c in o['classes']):
+        if name.lower() == cls.lower():
+            for sym, mo in meths:
+                if o['symbols'][sym].lower() == method.lower():
+                    off = mo
+    if off is None:
+        return None
+    ins = disasm(d, off)
+    targets = set()
+    for i, (at, op, a) in enumerate(ins):
+        if op in (0x53, 0x54):
+            nxt = ins[i + 1][0] if i + 1 < len(ins) else at + 3
+            targets.add(nxt + a[0])
+    st, calls = [], []
+    for at, op, a in ins:
+        if at in targets:
+            st = []
+        if op in (0x40, 0x41, 0x42, 0x43, 0x48):
+            st.append(a[0])
+        elif op == 0x45:
+            st.append(0)
+        elif op == 0x44:
+            st.append(a[0])
+        elif op == 0x46:
+            st.append(o['strings'][a[0]])
+        elif op == 0x47:
+            st.append(None)
+        elif op in (0x00, 0x04, 0x05, 0x06):
+            pass
+        elif op == 0x30:
+            st and st.pop()
+        elif op == 0x31:
+            for _ in range(a[0]):
+                st and st.pop()
+        elif op in (0x70, 0x71, 0x72, 0x73):
+            y = st.pop() if st else None
+            x = st.pop() if st else None
+            if isinstance(x, (int, float)) and isinstance(y, (int, float)) and not isinstance(x, bool):
+                r = {0x70: lambda: x + y, 0x71: lambda: x - y, 0x72: lambda: x * y, 0x73: lambda: x / y if y else 0}[op]()
+                st.append(float(r) if isinstance(x, float) or isinstance(y, float) or op == 0x73 else int(r))
+            else:
+                st.append(None)
+        elif op == 0x82:
+            argc = a[2]
+            args = [st.pop() if st else None for _ in range(argc)][::-1]
+            calls.append(((o['strings'][a[0]] + '.' + o['strings'][a[1]]).lower(), args))
+            st.append(None)
+        else:
+            st = []
+    return calls
+
+
+def main():
+    d = open(sys.argv[1], 'rb').read()
+    o = parse(d)
+    if '--summary' in sys.argv:
+        n = sum(len(disasm(d, off)) for _, off in subroutines(o))
+        print(json.dumps({'version': o['version'], 'strings': len(o['strings']), 'globals': len(o['globals']),
+                          'functions': len(o['functions']), 'classes': len(o['classes']), 'symbols': len(o['symbols']),
+                          'sources': len(o['sources']), 'tables_end': o['tables_end'], 'instructions': n}))
+        return
+    if '--eval' in sys.argv:
+        i = sys.argv.index('--eval')
+        calls = eval_calls(d, o, sys.argv[i + 1], sys.argv[i + 2])
+        print(json.dumps(None if calls is None else [{'call': k, 'args': a} for k, a in calls], indent=1))
+        return
+    i = sys.argv.index('--plain-calls')
+    wanted = set(w.lower() for w in sys.argv[i + 1:])
+    print(json.dumps(find_plain_push_calls(d, o, wanted), indent=1))
+
+
+if __name__ == '__main__':
+    main()
