--- base/tools/research/osi_craft.py	1970-01-01 01:00:00
+++ work/tools/research/osi_craft.py	2026-10-07 12:43:03
@@ -0,0 +1,52 @@
+"""Writes crafted hostile Base.osi files for END-TO-END time/memory probes of lomn_view (M1a-3 REF3 revision 2; the
+in-process probes are engine/tests/probe_osi.cpp). Put the output at <install>/data/Base.osi of a written synthetic install
+(lomn_view --synthetic 2 --write-install DIR) and run lomn_view on levt/stat under /usr/bin/time.
+Usage: osi_craft.py OUT KIND   KIND in: calls (Fable's call flood), stack (string-push flood), funcs (65535 functions on
+one long subroutine: check_all), nops (one maximal subroutine)."""
+import struct, sys
+
+
+def build(strings, cls, method_code, functions=()):
+    b = bytearray(b'OSI\0' + struct.pack('<HH', 4, 1))
+    def table(v):
+        b.extend(struct.pack('<H', len(v)))
+        for s in v:
+            b.append(len(s)); b.extend(s.encode()); b.append(0)
+    table(strings); table([])
+    b.extend(struct.pack('<H', len(functions)))
+    fpatch = []
+    for name in functions:
+        b.append(len(name)); b.extend(name.encode()); fpatch.append(len(b)); b.extend(b'\0\0\0\0\0\0')
+    b.extend(struct.pack('<H', 1)); b.append(0); b.append(1); b.extend(struct.pack('<H', 0))
+    mpatch = len(b); b.extend(b'\0\0\0\0')
+    b.append(len(cls)); b.extend(cls.encode()); b.append(0)
+    table(['initfull']); table([])
+    code = len(b)
+    struct.pack_into('<I', b, mpatch, code)
+    for p in fpatch: struct.pack_into('<I', b, p, code)
+    b.extend(method_code)
+    return bytes(b)
+
+
+def main():
+    out, kind = sys.argv[1], sys.argv[2]
+    s = ['gcareadirector', 'setfog', 'x' * 255]
+    if kind == 'calls':      # CallGameFunction argc 127, 100,000 times (600 KB): one OsiCall of 127 args each
+        code = bytes([0x82, 0, 0, 1, 0, 127]) * 100000 + b'\x52'
+        d = build(s, 'lego_area_statt', code)
+    elif kind == 'stack':    # PushString (255 chars) 200,000 times: the literal stack copies every string
+        code = bytes([0x46, 2, 0]) * 200000 + b'\x52'
+        d = build(s, 'lego_area_statt', code)
+    elif kind == 'funcs':    # 65,535 functions sharing one 300,000-instruction subroutine: check_all walks it per function
+        code = b'\x00' * 300000 + b'\x52'
+        d = build(s, 'lego_area_statt', code, functions=['f'] * 65535)
+    elif kind == 'nops':     # one subroutine at the per-subroutine cap
+        code = b'\x00' * ((1 << 20) - 1) + b'\x52'
+        d = build(s, 'lego_area_statt', code)
+    else:
+        sys.exit('unknown kind')
+    open(out, 'wb').write(d)
+
+
+if __name__ == '__main__':
+    main()
diff -ruN -x __pycache__ base/tools/research/osi_maxima.py work/tools/research/osi_maxima.py
--- base/tools/research/osi_maxima.py	1970-01-01 01:00:00
+++ work/tools/research/osi_maxima.py	2026-10-07 12:43:03
@@ -0,0 +1,53 @@
+"""Measures, on a real Base.osi, every quantity the C++ OSI reader caps (M1a-3 REF3 revision 2).
+Every cap in engine/include/lomn/sage/osi.h cites the value this prints. Uses osi.py (the independent Python reader).
+Usage: osi_maxima.py Base.osi   (JSON to stdout)"""
+import json, os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import osi
+
+d = open(sys.argv[1], 'rb').read()
+o = osi.parse(d)
+subs = list(osi.subroutines(o))
+m = dict(file_bytes=len(d), strings=len(o['strings']), longest_string=max(map(len, o['strings'])),
+         string_table_bytes=sum(map(len, o['strings'])), functions=len(o['functions']), classes=len(o['classes']),
+         methods_total=sum(len(c[2]) for c in o['classes']), unique_subroutines=len(subs),
+         function_offsets_unique=len(set(off for _, off, _ in o['functions'])))
+ins_max = ins_sum = calls_max = calls_sum = argc_max = depth_max = tgt_max = 0
+argbytes_call = argbytes_sub = args_sub = 0
+where = {}
+for name, off in subs:
+    ins = osi.disasm(d, off)
+    ins_sum += len(ins)
+    if len(ins) > ins_max: ins_max, where['ins'] = len(ins), name
+    tg = set()
+    for i, (at, op, a) in enumerate(ins):
+        if op in (0x53, 0x54):
+            tg.add((ins[i + 1][0] if i + 1 < len(ins) else at + 3) + a[0])
+    tgt_max = max(tgt_max, len(tg))
+    # the evaluator of osi.eval_calls, instrumented: stack depth, calls, args, string bytes copied into calls
+    st, nc, nargs, sb = [], 0, 0, 0
+    for at, op, a in ins:
+        if at in tg: st = []
+        if op in (0x40, 0x41, 0x42, 0x43, 0x48, 0x45, 0x44, 0x47): st.append(0)
+        elif op == 0x46: st.append(o['strings'][a[0]] if a[0] < len(o['strings']) else None)
+        elif op in (0x00, 0x04, 0x05, 0x06): pass
+        elif op == 0x30: st and st.pop()
+        elif op == 0x31:
+            for _ in range(a[0]): st and st.pop()
+        elif op in (0x70, 0x71, 0x72, 0x73):
+            st and st.pop(); st and st.pop(); st.append(0)
+        elif op == 0x82:
+            argc = max(0, a[2]); argc_max = max(argc_max, argc)
+            args = [st.pop() if st else None for _ in range(argc)]
+            b = sum(len(x) for x in args if isinstance(x, str))
+            argbytes_call = max(argbytes_call, b); sb += b
+            nc += 1; nargs += argc; st.append(None)
+        else: st = []
+        depth_max = max(depth_max, len(st))
+    calls_sum += nc
+    if nc > calls_max: calls_max, where['calls'] = nc, name
+    args_sub = max(args_sub, nargs); argbytes_sub = max(argbytes_sub, sb)
+m.update(insns_per_sub_max=ins_max, insns_total=ins_sum, branch_targets_per_sub_max=tgt_max, calls_per_sub_max=calls_max,
+         calls_total=calls_sum, argc_max=argc_max, args_per_sub_max=args_sub, string_arg_bytes_per_call_max=argbytes_call,
+         string_arg_bytes_per_sub_max=argbytes_sub, eval_stack_depth_max=depth_max, where=where)
+print(json.dumps(m, indent=1))
