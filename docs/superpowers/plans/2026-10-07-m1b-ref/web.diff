+  assert.match(checkCopyManifest({ ...ok, files: [{ path: 5, size: 1 }] }), /entry/);
+  assert.match(checkCopyManifest({ ...ok, files: [{ path: 'a', size: -1 }] }), /entry/);
+  assert.match(checkCopyManifest({ ...ok, files: [{ path: 'data/../x', size: 1 }] }), /entry/);
+  assert.match(checkCopyManifest({ ...ok, files: new Array(70000).fill({ path: 'a', size: 1 }) }), /files/);
+  assert.match(checkCopyManifest({ ...ok, version: 2 }), /format/);
+  const entries = [{ path: 'LEGOBionicle.exe', size: 4 }, { path: 'data/Base.osi', size: 2 }];
+  assert.equal(sameFiles(entries, ok.files), '');
+  assert.match(sameFiles(entries.slice(0, 1), ok.files), /missing.*data\/Base\.osi/);
+  assert.match(sameFiles([{ path: 'LEGOBionicle.exe', size: 4 }, { path: 'data/Base.osi', size: 3 }], ok.files), /size/);
+});
+
+test('M2 filterCached: a cached prefetch set over the byte cap is dropped (discovery runs instead)', async () => {
+  const { filterCached, MAX_CACHED_BYTES } = await import('../app/engine.js');
+  const byNorm = new Map([['root/a', { size: 1 << 30 }]]);
+  assert.equal(MAX_CACHED_BYTES, 64 * 1024 * 1024);
+  assert.equal(filterCached([{ path: 'root/a', offset: 0, length: 100 }, { path: 'root/zz', offset: 0, length: 1 }], byNorm).length, 1);
+  assert.deepEqual(filterCached([{ path: 'root/a', offset: 0, length: MAX_CACHED_BYTES + 1 }], byNorm), []);
+  assert.deepEqual(filterCached([{ path: 'root/a', offset: 2 ** 30 - 5, length: 10 }], byNorm), []);
+});
diff -ruN -x node_modules base/web/tests/unit_test.mjs ref/web/tests/unit_test.mjs
--- base/web/tests/unit_test.mjs	1970-01-01 01:00:00
+++ ref/web/tests/unit_test.mjs	2026-10-07 17:10:26
@@ -0,0 +1,99 @@
+// Node unit tests of the page's untrusted-input code (no browser): build identification, builds.json shape checks, the
+// copy/index file rule, <input webkitdirectory> path handling and the engine's range-list parser.
+// Run: cd web && timeout 60 node --test tests/unit_test.mjs
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { blkTablesFingerprint, checkBuilds, classify, MAX_BLK_ENTRIES } from '../app/fingerprint.js';
+import { filesSource, wanted } from '../app/byo.js';
+import { parseRanges } from '../app/engine.js';
+
+const H = (n) => n.toString(16).padStart(2, '0').repeat(32);
+const builds = checkBuilds({
+  accepted: [{ id: 'good', exe_sha256: H(1) }],
+  data: [{ id: 'gooddata', blk_tables_sha256: H(2) }],
+  rejected: [{ id: 'rb', exe_sha256: H(3), name: 'REBUILT', reason: 'needs LOMNHook' }],
+});
+
+function blk(count, extra = 0) {
+  const b = new Uint8Array(12 + count * 56 + extra);
+  b.set([0x42, 0x4c, 0x4b, 0x46]);
+  new DataView(b.buffer).setUint32(8, count, true);
+  return b;
+}
+const fromBytes = (files) => ({
+  entries: Object.entries(files).map(([path, bytes]) => ({ path, size: bytes.length, bytes })),
+  read: async (e, o, l) => e.bytes.subarray(o, o + l),
+});
+
+test('classify: accepted, rejected-list (named), unknown exe, unknown data', () => {
+  assert.equal(classify(builds, H(1), H(2)).ok, true);
+  assert.match(classify(builds, H(3), H(2)).message, /^This is REBUILT \(LEGOBionicle\.exe SHA-256 030303030303…\), which is not supported: needs LOMNHook$/);
+  assert.match(classify(builds, H(9), H(2)).message, /^Unknown build: LEGOBionicle\.exe SHA-256 090909090909…/);
+  // C2 / D13: accepted exe + unknown tables is soft-accepted with a warning naming the fingerprint (no hard rejection).
+  const soft = classify(builds, H(1), H(8));
+  assert.equal(soft.ok, true);
+  assert.equal(soft.data, 'unknown');
+  assert.match(soft.warning, /^Game data differs from the known build — rendering may differ \(\.blk table fingerprint 080808080808…/);
+});
+
+test('checkBuilds rejects malformed lists', () => {
+  assert.throws(() => checkBuilds({ accepted: [{ id: 'x', exe_sha256: 'nothex' }] }), /bad accepted entry/);
+  assert.throws(() => checkBuilds({ accepted: [], data: [{ id: '', blk_tables_sha256: H(1) }] }), /bad data entry/);
+  assert.throws(() => checkBuilds({ accepted: [], rejected: [{ id: 'r', exe_sha256: H(1) }] }), /bad rejected entry/);
+  assert.throws(() => checkBuilds({ accepted: new Array(65).fill({ id: 'a', exe_sha256: H(1) }) }), /bad accepted list/);
+  assert.throws(() => checkBuilds(null), /bad accepted list/);
+});
+
+test('blkTablesFingerprint: order-independent, path-case-insensitive, bounded', async () => {
+  const a = fromBytes({ 'data/A.blk': blk(2, 100), 'data/levels/x.blk': blk(0), 'data/b.txt': new Uint8Array(3) });
+  const b = fromBytes({ 'data/levels/X.BLK': blk(0), 'DATA/a.blk': blk(2, 100) });
+  const fa = await blkTablesFingerprint(a.entries, a.read);
+  const fb = await blkTablesFingerprint(b.entries, b.read);
+  assert.equal(fa.fingerprint, fb.fingerprint);
+  assert.equal(fa.blkFiles, 2);
+  assert.equal(fa.tableBytes, 12 + 2 * 56 + 12);
+  // The entry bytes after the table do not count; the table does.
+  const c = fromBytes({ 'data/A.blk': (() => { const x = blk(2, 100); x[12 + 2 * 56 + 5] = 7; return x; })(), 'data/levels/x.blk': blk(0) });
+  assert.equal((await blkTablesFingerprint(c.entries, c.read)).fingerprint, fa.fingerprint);
+  const d = fromBytes({ 'data/A.blk': (() => { const x = blk(2, 100); x[20] = 7; return x; })(), 'data/levels/x.blk': blk(0) });
+  assert.notEqual((await blkTablesFingerprint(d.entries, d.read)).fingerprint, fa.fingerprint);
+  const bad = async (files, re) => { const s = fromBytes(files); await assert.rejects(blkTablesFingerprint(s.entries, s.read), re); };
+  await bad({ 'data/a.blk': new Uint8Array(20) }, /no BLKF magic/);
+  await bad({ 'data/a.blk': new Uint8Array(5) }, /too small/);
+  await bad({ 'data/a.blk': blk(3).subarray(0, 12 + 2 * 56) }, /entry table larger than the file/);
+  const huge = blk(0);
+  new DataView(huge.buffer).setUint32(8, MAX_BLK_ENTRIES + 1, true);
+  await bad({ 'data/a.blk': huge }, /cap/);
+  await bad({ 'other/a.blk': blk(0) }, /not a LOMN install/);
+});
+
+test('wanted(): the exe at the top and data/ except dot files, exes and DLLs', () => {
+  assert.equal(wanted('LEGOBionicle.exe'), true);
+  assert.equal(wanted('data/levels/lev1/vllg.blk'), true);
+  assert.equal(wanted('Data/Base.osi'), true);
+  assert.equal(wanted('data/Cinematics/Binkplay.exe'), false);
+  assert.equal(wanted('data/Cinematics/binkw32.DLL'), false);  // a DLL inside data/ (mutation 17 of mutate4.py)
+  assert.equal(wanted('mods/BetterSaver.dll'), false);
+  assert.equal(wanted('data/.DS_Store'), false);
+  assert.equal(wanted('binkw32.dll'), false);
+  assert.equal(wanted('sub/LEGOBionicle.exe'), false);
+});
+
+test('filesSource: strips the picked folder, keeps only wanted files', () => {
+  const mk = (rel, n) => {
+    const f = new File([new Uint8Array(n)], rel.split('/').pop());
+    Object.defineProperty(f, 'webkitRelativePath', { value: rel });
+    return f;
+  };
+  const s = filesSource([mk('install/LEGOBionicle.exe', 4), mk('install/data/Base.osi', 2), mk('install/mods/x.dll', 1), mk('install/data/.DS_Store', 1)]);
+  assert.equal(s.name, 'install');
+  assert.deepEqual(s.entries.map((e) => [e.path, e.size]), [['LEGOBionicle.exe', 4], ['data/Base.osi', 2]]);
+});
+
+test('parseRanges: integers only, malformed lines rejected', () => {
+  assert.deepEqual(parseRanges('root/a\t0\t12\nroot/b\t12\t560\n'), [{ path: 'root/a', offset: 0, length: 12 }, { path: 'root/b', offset: 12, length: 560 }]);
+  assert.throws(() => parseRanges('root/a\t-1\t12\n'), /malformed/);
+  assert.throws(() => parseRanges('root/a\t1.5\t12\n'), /malformed/);
+  assert.throws(() => parseRanges('root/a\t1\n'), /malformed/);
+  assert.throws(() => parseRanges('\t1\t2\n'), /malformed/);
+});
diff -ruN -x node_modules base/web/tools/build_site.mjs ref/web/tools/build_site.mjs
--- base/web/tools/build_site.mjs	1970-01-01 01:00:00
+++ ref/web/tools/build_site.mjs	2026-10-07 17:18:38
@@ -0,0 +1,89 @@
+// Assembles the static site: web/index.html, web/app/*.js, the wasm build and builds.json, plus asset-manifest.json
+// (every file with its byte size and SHA-256; the network-discipline test allows exactly these URLs).
+// Content hashing (for a later deploy, parent spec §4.6): every JS and wasm file is published as <name>.<10 hex of the
+// SHA-256 of its published bytes>.<ext>, and the references to it (quoted relative specifiers in the JS, the script src in
+// index.html) are rewritten first, leaves before importers, so a hash covers its dependencies' names. index.html,
+// builds.json and asset-manifest.json keep stable names (they must be revalidated). There is no CSS file: the page's CSS
+// is inline in index.html. Deploy headers (immutable for hashed names) are not written here: deploy is out of scope.
+// Usage: node web/tools/build_site.mjs <wasm_build_dir> <out_dir> [--extra-builds file.json]
+//   --extra-builds: merges test-only accepted/data/rejected entries (synthetic fixtures) into builds.json. Never used
+//   for the real site (make site).
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const web = path.resolve(here, '..');
+const repo = path.resolve(web, '..');
+const args = process.argv.slice(2);
+const [wasmDir, outDir] = args;
+if (!wasmDir || !outDir) {
+  console.error('usage: build_site.mjs <wasm_build_dir> <out_dir> [--extra-builds file.json]');
+  process.exit(2);
+}
+const extraAt = args.indexOf('--extra-builds');
+const extra = extraAt > 0 ? JSON.parse(fs.readFileSync(args[extraAt + 1], 'utf8')) : null;
+
+fs.rmSync(outDir, { recursive: true, force: true });
+fs.mkdirSync(path.join(outDir, 'app'), { recursive: true });
+// Sources, in hashing order: a file comes after every file it references.
+const ORDER = ['app/fingerprint.js', 'app/idb.js', 'app/paths.js', 'app/opfs_worker.js', 'lomn_web.wasm', 'lomn_web.js', 'app/byo.js', 'app/engine.js', 'app/main.js'];
+const srcOf = (rel) => (rel.startsWith('app/') ? path.join(web, rel) : path.join(wasmDir, rel));
+const appFiles = fs.readdirSync(path.join(web, 'app')).filter((f) => f.endsWith('.js')).map((f) => 'app/' + f).sort();
+const unknown = appFiles.filter((f) => !ORDER.includes(f));
+if (unknown.length) throw new Error('build_site: add these to ORDER (after what they import): ' + unknown.join(', '));
+const hashed = new Map();  // rel -> published rel
+const relSpec = (fromRel, toRel) => {
+  const r = path.posix.relative(path.posix.dirname(fromRel), toRel);
+  return r.startsWith('.') ? r : './' + r;
+};
+const rewrite = (fromRel, text) => {
+  for (const [orig, pub] of hashed) {
+    const a = relSpec(fromRel, orig), b = relSpec(fromRel, pub);
+    for (const q of ["'", '"']) text = text.split(q + a + q).join(q + b + q);
+  }
+  return text;
+};
+for (const rel of ORDER) {
+  let bytes = fs.readFileSync(srcOf(rel));
+  if (rel.endsWith('.js')) bytes = Buffer.from(rewrite(rel, bytes.toString('utf8')));
+  const h = crypto.createHash('sha256').update(bytes).digest('hex').slice(0, 10);
+  const ext = path.extname(rel);
+  const pub = rel.slice(0, -ext.length) + '.' + h + ext;
+  fs.writeFileSync(path.join(outDir, pub), bytes);
+  hashed.set(rel, pub);
+}
+let html = fs.readFileSync(path.join(web, 'index.html'), 'utf8');
+for (const [orig, pub] of hashed) html = html.split(`src="${orig}"`).join(`src="${pub}"`);
+fs.writeFileSync(path.join(outDir, 'index.html'), html);
+// Every reference must have been rewritten: no published file may still name an unhashed source.
+for (const pub of [...hashed.values(), 'index.html']) {
+  if (!pub.endsWith('.js') && pub !== 'index.html') continue;
+  const text = fs.readFileSync(path.join(outDir, pub), 'utf8');
+  for (const orig of hashed.keys()) {
+    const spec = pub === 'index.html' ? `"${orig}"` : `'${relSpec(pub, orig)}'`;
+    if (text.includes(spec)) throw new Error(`build_site: ${pub} still references ${spec}`);
+  }
+}
+const builds = JSON.parse(fs.readFileSync(path.join(repo, 'tools', 'builds.json'), 'utf8'));
+if (extra) for (const k of ['accepted', 'data', 'rejected']) builds[k] = [...(builds[k] || []), ...(extra[k] || [])];
+fs.writeFileSync(path.join(outDir, 'builds.json'), JSON.stringify(builds, null, 1) + '\n');
+
+const files = [];
+const walk = (dir, prefix) => {
+  for (const f of fs.readdirSync(dir).sort()) {
+    const p = path.join(dir, f);
+    if (fs.statSync(p).isDirectory()) walk(p, prefix + f + '/');
+    else {
+      const rel = prefix + f;
+      const source = [...hashed].find(([, pub]) => pub === rel)?.[0];
+      files.push({ path: rel, bytes: fs.statSync(p).size, sha256: crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'), ...(source ? { source } : {}) });
+    }
+  }
+};
+walk(outDir, '');
+const manifest = { format: 'lomn-asset-manifest', version: 1, files, total_bytes: files.reduce((n, f) => n + f.bytes, 0) };
+const text = JSON.stringify(manifest, null, 1) + '\n';
+fs.writeFileSync(path.join(outDir, 'asset-manifest.json'), text);
+console.log(`site: ${files.length + 1} files, ${manifest.total_bytes + Buffer.byteLength(text)} bytes -> ${outDir}`);
diff -ruN -x node_modules base/web/tools/fingerprint_cli.mjs ref/web/tools/fingerprint_cli.mjs
--- base/web/tools/fingerprint_cli.mjs	1970-01-01 01:00:00
+++ ref/web/tools/fingerprint_cli.mjs	2026-10-07 15:49:55
@@ -0,0 +1,41 @@
+// Node front end of web/app/fingerprint.js (the code the page runs): prints the exe SHA-256 and the blockfile-table
+// fingerprint of an install folder as JSON. Walks the folder like the page (dot files skipped; data/ and the exe only).
+// Usage: node web/tools/fingerprint_cli.mjs <install_dir>
+import fs from 'node:fs';
+import path from 'node:path';
+import { blkTablesFingerprint, lowerAscii, sha256hex } from '../app/fingerprint.js';
+
+const root = process.argv[2];
+if (!root) {
+  console.error('usage: fingerprint_cli.mjs <install_dir>');
+  process.exit(2);
+}
+const entries = [];
+const walk = (dir, prefix) => {
+  for (const f of fs.readdirSync(dir)) {
+    if (f.startsWith('.')) continue;
+    const p = path.join(dir, f);
+    const st = fs.statSync(p);
+    if (st.isDirectory()) walk(p, prefix + f + '/');
+    else entries.push({ path: prefix + f, size: st.size, abs: p });
+  }
+};
+walk(root, '');
+const readRange = async (e, off, len) => {
+  const fd = fs.openSync(e.abs, 'r');
+  try {
+    const b = Buffer.alloc(len);
+    const n = fs.readSync(fd, b, 0, len, off);
+    return new Uint8Array(b.buffer, b.byteOffset, n);
+  } finally {
+    fs.closeSync(fd);
+  }
+};
+const exe = entries.find((e) => lowerAscii(e.path) === 'legobionicle.exe');
+const fp = await blkTablesFingerprint(entries, readRange);
+console.log(JSON.stringify({
+  exe_sha256: exe ? await sha256hex(fs.readFileSync(exe.abs)) : null,
+  blk_tables_sha256: fp.fingerprint,
+  blk_files: fp.blkFiles,
+  table_bytes: fp.tableBytes,
+}, null, 1));
