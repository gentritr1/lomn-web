diff -ruN -x node_modules base/web/app/byo.js ref/web/app/byo.js
--- base/web/app/byo.js	1970-01-01 01:00:00
+++ ref/web/app/byo.js	2026-10-07 17:16:48
@@ -0,0 +1,220 @@
+// Bring-your-own files (spec §4.3). Nothing here sends anything over the network: every byte is read locally through
+// the File System Access API (Chromium: the player's folder, in place) or from OPFS (Safari/Firefox: a one-time copy).
+//
+// A "source" is {kind, name, entries, file(entry)}: entries = [{path, size}] relative to the install root (the folder
+// that holds LEGOBionicle.exe), file(entry) -> Promise<File>. Three kinds:
+//   'handle' a FileSystemDirectoryHandle the player picked (showDirectoryPicker); persisted in IndexedDB
+//   'opfs'   the copy inside the origin-private file system (directory COPY_DIR)
+//   'files'  the File objects of <input webkitdirectory> (only to validate and copy them; they do not survive a reload)
+import { blkTablesFingerprint, classify, lowerAscii, MAX_EXE_BYTES, sha256hex } from './fingerprint.js';
+import { checkRelPath, MAX_DEPTH, MAX_PATH_BYTES } from './paths.js';
+
+export const COPY_DIR = 'lomn-install';
+export const COPY_DONE = 'lomn-copy-complete.json';
+export const EXE = 'legobionicle.exe';
+// Caps on what a picked folder may make the page walk (real install: 529 files, depth 5, longest path 54 bytes). The path
+// rules (UTF-8 bytes, depth, segments) are paths.js's, shared with the copy worker.
+export const MAX_FILES = 65536;
+export { MAX_DEPTH, MAX_PATH_BYTES };
+const MAX_DONE_BYTES = 8 * 1024 * 1024;
+
+const isHidden = (name) => name.startsWith('.');
+
+// Which files the copy (and the engine's index) takes: the exe at the top and everything under data/ except dot files and
+// executables/DLLs (the port never runs them). The quota check sums exactly this set.
+export function wanted(path) {
+  const k = lowerAscii(path);
+  if (k === EXE) return true;
+  if (!k.startsWith('data/')) return false;
+  if (k.split('/').some(isHidden)) return false;
+  return !(k.endsWith('.exe') || k.endsWith('.dll'));
+}
+
+// REF4 r2 (M11): one rule for both sources. A wanted file whose path breaks paths.js's rules, or whose name differs from
+// an earlier one only in case (one engine path; possible on a case-sensitive file system), is skipped with a warning
+// instead of failing the whole install. Returns true when the entry is taken.
+function admit(path, seen, warnings) {
+  const why = checkRelPath(path);
+  if (why) {
+    if (warnings.length < 100) warnings.push(`skipped ${path.slice(0, 80)}: ${why}`);
+    return false;
+  }
+  const key = lowerAscii(path);
+  if (seen.has(key)) {
+    if (warnings.length < 100) warnings.push(`skipped ${path.slice(0, 80)}: same name as ${seen.get(key)} (names are case-insensitive)`);
+    return false;
+  }
+  seen.set(key, path);
+  return true;
+}
+
+export async function walkHandle(dir) {
+  const entries = [];
+  const handles = new Map();
+  const seen = new Map(), warnings = [];
+  let visited = 0;
+  async function walk(d, prefix, depth) {
+    if (depth > MAX_DEPTH) throw new Error(`folder nested deeper than ${MAX_DEPTH} levels`);
+    for await (const [name, h] of d.entries()) {
+      if (++visited > MAX_FILES) throw new Error(`more than ${MAX_FILES} entries in the folder`);
+      if (isHidden(name)) continue;
+      const path = prefix + name;
+      if (h.kind === 'directory') {
+        if (!checkRelPath(path)) await walk(h, path + '/', depth + 1);
+        else if (warnings.length < 100) warnings.push(`skipped folder ${path.slice(0, 80)}: ${checkRelPath(path)}`);
+      } else {
+        if (!wanted(path) || !admit(path, seen, warnings)) continue;
+        const f = await h.getFile();
+        const e = { path, size: f.size };
+        entries.push(e);
+        handles.set(e, h);
+      }
+    }
+  }
+  await walk(dir, '', 0);
+  const cache = new Map();
+  return {
+    entries,
+    warnings,
+    file: async (e) => {
+      let f = cache.get(e);
+      if (!f) cache.set(e, (f = await handles.get(e).getFile()));
+      return f;
+    },
+  };
+}
+
+export async function handleSource(dir, kind) {
+  const w = await walkHandle(dir);
+  return { kind, name: dir.name, dir, entries: w.entries, warnings: w.warnings, file: w.file };
+}
+
+// <input webkitdirectory>: webkitRelativePath = "<picked folder>/data/...". The first segment is dropped.
+export function filesSource(fileList) {
+  const entries = [];
+  const files = new Map();
+  const seen = new Map(), warnings = [];
+  let name = '';
+  if (fileList.length > MAX_FILES) throw new Error(`more than ${MAX_FILES} files`);
+  for (const f of fileList) {
+    const rel = f.webkitRelativePath || f.name;
+    const slash = rel.indexOf('/');
+    if (!name) name = slash > 0 ? rel.slice(0, slash) : '';
+    const path = slash > 0 ? rel.slice(slash + 1) : rel;
+    if (!path || path.split('/').some(isHidden) || !wanted(path) || !admit(path, seen, warnings)) continue;
+    const e = { path, size: f.size };
+    entries.push(e);
+    files.set(e, f);
+  }
+  return { kind: 'files', name, entries, warnings, file: async (e) => files.get(e) };
+}
+
+export async function readRange(source, e, offset, length) {
+  const f = await source.file(e);
+  if (offset + length > f.size) throw new Error(`${e.path}: read past the end (the file changed?)`);
+  return new Uint8Array(await f.slice(offset, offset + length).arrayBuffer());
+}
+
+// exe hash + blockfile-table fingerprint -> classify() against builds.json. {ok, message, build, data, exeSha, dataFp}.
+export async function validate(source, builds) {
+  const exe = source.entries.find((e) => lowerAscii(e.path) === EXE);
+  if (!exe) return { ok: false, message: 'LEGOBionicle.exe was not found at the top of the chosen folder. Choose the game folder itself (the one that contains LEGOBionicle.exe and data/).' };
+  if (exe.size > MAX_EXE_BYTES) return { ok: false, message: 'LEGOBionicle.exe is larger than any known build: not an accepted build.' };
+  const t0 = performance.now();
+  const exeSha = await sha256hex(await readRange(source, exe, 0, exe.size));
+  let fp;
+  try {
+    fp = await blkTablesFingerprint(source.entries, (e, o, l) => readRange(source, e, o, l));
+  } catch (err) {
+    return { ok: false, message: 'The game data could not be validated: ' + err.message, exeSha };
+  }
+  const v = classify(builds, exeSha, fp.fingerprint);
+  return { ...v, exeSha, dataFp: fp.fingerprint, blkFiles: fp.blkFiles, tableBytes: fp.tableBytes, ms: performance.now() - t0 };
+}
+
+export const totalBytes = (source) => source.entries.reduce((n, e) => n + e.size, 0);
+
+// Quota first (spec §4.3): persist() then estimate(); never start a copy that cannot finish.
+export async function quotaCheck(needBytes) {
+  let persisted = false;
+  try {
+    persisted = (await navigator.storage.persist?.()) ?? false;
+  } catch { /* not fatal: the estimate decides */ }
+  const est = await navigator.storage.estimate();
+  const free = Math.max(0, (est.quota ?? 0) - (est.usage ?? 0));
+  return { ok: free >= needBytes, free, need: needBytes, persisted, quota: est.quota, usage: est.usage };
+}
+
+// REF4 r2 (I6): the completion manifest's shape ('' when valid): bounded file list of {path (paths.js rules), size}.
+export function checkCopyManifest(done) {
+  if (done?.format !== 'lomn-opfs-copy' || done.version !== 1) return 'unknown format';
+  if (!Array.isArray(done.files) || done.files.length > MAX_FILES) return 'bad files list';
+  for (const f of done.files)
+    if (!f || checkRelPath(f.path) || !Number.isSafeInteger(f.size) || f.size < 0) return 'bad entry ' + JSON.stringify(f).slice(0, 80);
+  return '';
+}
+// The copy (entries walked from OPFS) against the manifest's files: '' when every listed file is there with its size.
+export function sameFiles(entries, files) {
+  const have = new Map(entries.map((e) => [lowerAscii(e.path), e.size]));
+  for (const f of files) {
+    const k = lowerAscii(f.path);
+    if (!have.has(k)) return `missing ${f.path}`;
+    if (have.get(k) !== f.size) return `size of ${f.path} is ${have.get(k)}, the copy wrote ${f.size}`;
+  }
+  return '';
+}
+
+// The completion manifest of a finished OPFS copy, or null (absent or malformed; the files themselves are compared with
+// it by sameFiles once the copy is walked).
+export async function opfsCopy() {
+  try {
+    const root = await navigator.storage.getDirectory();
+    const dir = await root.getDirectoryHandle(COPY_DIR);
+    const doneFile = await (await dir.getFileHandle(COPY_DONE)).getFile();
+    if (doneFile.size > MAX_DONE_BYTES) return null;
+    const done = JSON.parse(await doneFile.text());
+    if (checkCopyManifest(done)) return null;
+    return { dir, done };
+  } catch {
+    return null;
+  }
+}
+// REF4 r2 (I7): a copy directory exists (with or without its completion manifest).
+export async function opfsDirExists() {
+  try {
+    await (await navigator.storage.getDirectory()).getDirectoryHandle(COPY_DIR);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// Removes a previous (possibly partial) copy so the estimate sees the space it held.
+export async function opfsClear() {
+  const root = await navigator.storage.getDirectory();
+  try {
+    await root.removeEntry(COPY_DIR, { recursive: true });
+  } catch { /* nothing to clear */ }
+}
+
+// Copies the source into OPFS in a worker (createSyncAccessHandle, chunked). onProgress(bytesDone, bytesTotal).
+// The completion manifest is written last, so an interrupted copy is never mistaken for a complete one.
+export function copyToOpfs(source, verdict, onProgress) {
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(new URL('./opfs_worker.js', import.meta.url), { type: 'module' });
+    const files = source.entries.map((e) => ({ path: e.path, size: e.size }));
+    Promise.all(source.entries.map((e) => source.file(e))).then((blobs) => {
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'progress') onProgress(data.done, data.total);
+        else if (data.type === 'done') { worker.terminate(); resolve(data); }
+        else if (data.type === 'error') { worker.terminate(); reject(new Error(data.message)); }
+      };
+      worker.onerror = (ev) => { worker.terminate(); reject(new Error('copy worker failed: ' + (ev.message || 'error'))); };
+      worker.postMessage({
+        type: 'copy', dir: COPY_DIR, doneName: COPY_DONE, files, blobs,
+        done: { format: 'lomn-opfs-copy', version: 1, build: verdict.build, data: verdict.data, exe_sha256: verdict.exeSha,
+                blk_tables_sha256: verdict.dataFp, files, bytes: totalBytes(source) },
+      });
+    }, reject);
+  });
+}
diff -ruN -x node_modules base/web/app/engine.js ref/web/app/engine.js
--- base/web/app/engine.js	1970-01-01 01:00:00
+++ ref/web/app/engine.js	2026-10-07 17:17:42
@@ -0,0 +1,236 @@
+// The wasm engine (lomn_web.js, an ES module factory built with INVOKE_RUN=0) and its file bridge.
+//
+// Prefetch by discovery (REF4 decision D2; engine side: engine/src/app/main_web.cpp): a load runs in rounds; each
+// round's misses (reads whose bytes are not resident) are fetched from the player's files straight into wasm heap
+// buffers, chunk by chunk (CHUNK bytes at a time: the JS-side peak is one chunk, never a whole file), and the load
+// runs again until a round has no miss. The last round's reads (lomn_fs_touched) are cached in IndexedDB per
+// (data fingerprint, engine build, area), so a revisit prefetches everything in one go and needs one round.
+import { idbDelete, idbGet, idbKeys, idbSet } from './idb.js';
+import { lowerAscii, sha256hex } from './fingerprint.js';
+
+export const CHUNK = 8 * 1024 * 1024;
+export const MAX_ROUNDS = 16;  // hard limit; measured maximum 8 over all 122 Beta 1.5.0 areas (a13_real asserts <= 12)
+// REF4 r2 (M2): a cached prefetch set is a hint from IndexedDB (tamperable): over this many bytes it is ignored and the
+// area is discovered instead. The largest real area set is 13,066,416 bytes (lev0/frnt incl. boot).
+export const MAX_CACHED_BYTES = 64 * 1024 * 1024;
+
+// Cached ranges that are inside an indexed file, non-empty, and together under MAX_CACHED_BYTES ([] otherwise).
+export function filterCached(ranges, byNorm) {
+  const ok = ranges.filter((r) => {
+    const e = byNorm.get(r.path);
+    return e && r.length > 0 && r.offset + r.length <= e.size;
+  });
+  return ok.reduce((n, r) => n + r.length, 0) > MAX_CACHED_BYTES ? [] : ok;
+}
+const MAX_RANGES_TEXT = 4096;  // ranges accepted from one miss list or cached set (engine cap: 4,096 misses per round)
+
+// "path\toffset\tlength\n" lines -> [{path, offset, length}], bounded and integer-checked.
+export function parseRanges(text) {
+  const out = [];
+  for (const line of text.split('\n')) {
+    if (!line) continue;
+    if (out.length >= MAX_RANGES_TEXT * 16) throw new Error('range list over the cap');
+    const [path, o, l] = line.split('\t');
+    const offset = Number(o), length = Number(l);
+    if (!path || !Number.isSafeInteger(offset) || !Number.isSafeInteger(length) || offset < 0 || length < 0)
+      throw new Error('malformed range line');
+    out.push({ path, offset, length });
+  }
+  return out;
+}
+
+export class Engine {
+  constructor(M, source, onState) {
+    this.M = M;
+    this.source = source;
+    this.onState = onState;
+    this.byNorm = new Map();  // engine path ("root/...", lower-case) -> source entry
+    this.load = null;         // metrics of the last area load (JS side)
+    this.boot = null;
+    this.cacheKey = '';
+    this.concurrency = 1;     // debug (M1 measurement): ranges fetched in parallel per round
+    this.useCache = true;     // debug: false = always discover
+    this.validation = null;   // the BYO verdict shown with the metrics (C2: data 'unknown' + warning)
+  }
+
+  str(s, fn) {
+    const p = this.M.stringToNewUTF8(s);
+    try {
+      return fn(p);
+    } finally {
+      this.M._free(p);
+    }
+  }
+  lastError() { return this.M.UTF8ToString(this.M._lomn_last_error()); }
+  // Engine metrics + the measured configuration (build flavour, the SHA-256 of the wasm bytes actually instantiated,
+  // canvas size); the adapter is in the engine part.
+  metrics() {
+    const m = JSON.parse(this.M.UTF8ToString(this.M._lomn_metrics_json()));
+    if (this.validation) m.validation = this.validation;
+    const c = document.getElementById('canvas');
+    m.build = { ...this.build, wasm_sha256: this.wasmSha, wasm_bytes: this.wasmBytes };
+    m.canvas = { width: c.width, height: c.height, css_width: c.clientWidth, css_height: c.clientHeight, device_pixel_ratio: window.devicePixelRatio };
+    return m;
+  }
+  areas() {
+    return this.M.UTF8ToString(this.M._lomn_list_areas()).split('\n').filter(Boolean).map((l) => {
+      const [level, area] = l.split('\t');
+      return { level, area };
+    });
+  }
+
+  // Registers every file (path, size) of the source: exists()/size() answer from this index; no bytes move.
+  index() {
+    for (const e of this.source.entries) {
+      const norm = 'root/' + lowerAscii(e.path);
+      if (!this.str('Root/' + e.path, (p) => this.M._lomn_fs_add_file(p, e.size))) throw new Error('index: ' + this.lastError());
+      this.byNorm.set(norm, e);
+    }
+  }
+
+  // One range into the heap. Returns the bytes moved (0 when it was already resident).
+  async fetchRange(r) {
+    const e = this.byNorm.get(r.path);
+    if (!e) throw new Error('prefetch: not in the index: ' + r.path);
+    if (r.length === 0 || this.str(r.path, (p) => this.M._lomn_fs_is_resident(p, r.offset, r.length))) return 0;
+    const f = await this.source.file(e);
+    if (r.offset + r.length > f.size) throw new Error(`prefetch: ${e.path} is shorter than the index says (changed on disk?)`);
+    const ptr = this.str(r.path, (p) => this.M._lomn_fs_reserve(p, r.offset, r.length));
+    if (!ptr) throw new Error('prefetch: ' + this.lastError());
+    try {
+      for (let pos = 0; pos < r.length; pos += CHUNK) {
+        const n = Math.min(CHUNK, r.length - pos);
+        const buf = new Uint8Array(await f.slice(r.offset + pos, r.offset + pos + n).arrayBuffer());
+        if (buf.length !== n) throw new Error(`prefetch: short read of ${e.path}`);
+        this.M.HEAPU8.set(buf, ptr + pos);  // re-read HEAPU8 each time: a reserve may have grown the memory
+      }
+    } catch (err) {
+      this.M._lomn_fs_abort(ptr);
+      throw err;
+    }
+    this.M._lomn_fs_commit(ptr);
+    return r.length;
+  }
+
+  // Rounds of probe() until it returns 0 (no miss). probe() returns the miss count, or < 0 on a real error.
+  // Fetches a list of ranges, `concurrency` at a time; returns [bytes moved, ranges moved].
+  async fetchAll(list, fetched) {
+    let bytes = 0, n = 0, next = 0;
+    const worker = async () => {
+      while (next < list.length) {
+        const r = list[next++];
+        const b = await this.fetchRange(r);
+        if (b) {
+          bytes += b;
+          ++n;
+          fetched.push(r);
+        }
+      }
+    };
+    await Promise.all(Array.from({ length: Math.max(1, Math.min(this.concurrency, 16)) }, worker));
+    return [bytes, n];
+  }
+
+  async rounds(probe, what, prefetch = []) {
+    const t0 = performance.now();
+    let fetchMs = 0, bytes = 0, ranges = 0;
+    const fetched = [];  // every range this load moved (I5: over-fetch = moved but not read by the final round)
+    this.fetched = fetched;
+    const tf = performance.now();
+    [bytes, ranges] = await this.fetchAll(prefetch, fetched);
+    fetchMs += performance.now() - tf;
+    for (let round = 1; round <= MAX_ROUNDS; ++round) {
+      const m = probe();
+      if (m === 0) return { rounds: round, fetch_ms: fetchMs, bytes, ranges, total_ms: performance.now() - t0, cached: prefetch.length > 0 };
+      if (m < 0) throw new Error(this.lastError());
+      const misses = parseRanges(this.M.UTF8ToString(this.M._lomn_fs_misses()));
+      const t1 = performance.now();
+      const [moved, nMoved] = await this.fetchAll(misses, fetched);
+      ranges += nMoved;
+      fetchMs += performance.now() - t1;
+      bytes += moved;
+      if (moved === 0 && misses.every((r) => r.length > 0)) throw new Error(`${what}: prefetch made no progress (${misses[0]?.path})`);
+    }
+    throw new Error(`${what}: prefetch did not converge in ${MAX_ROUNDS} rounds`);
+  }
+
+  async cached(key) {
+    if (!this.useCache) return [];
+    try {
+      const text = await idbGet(this.cacheKey + key);
+      if (typeof text !== 'string' || text.length > 16 * 1024 * 1024) return [];
+      // Validated against the index and capped before use: a stale or tampered cache can only cost a fetch, never a bad
+      // read or an oversized heap.
+      return filterCached(parseRanges(text), this.byNorm);
+    } catch {
+      return [];
+    }
+  }
+  forgetCachedSet(area) { return idbDelete(this.cacheKey + 'area:' + area).catch(() => {}); }
+  // REF4 r2 (M2): cached sets of other wasm builds can never be used again: drop them (keys "prefetch|<fp>|<sha>|...").
+  async pruneOtherBuilds() {
+    const sha = this.cacheKey.split('|')[2];
+    const keys = await idbKeys().catch(() => []);
+    let n = 0;
+    for (const k of keys)
+      if (typeof k === 'string' && k.startsWith('prefetch|') && k.split('|')[2] !== sha) {
+        await idbDelete(k).catch(() => {});
+        ++n;
+      }
+    return n;
+  }
+
+  // Boot set before main() (spec §4.3): Art.blk header + table and Base.osi, discovered like an area, then pinned.
+  async bootAndMain(width, height, cacheKey) {
+    this.cacheKey = cacheKey;
+    this.pruned = await this.pruneOtherBuilds();
+    this.index();
+    const pre = await this.cached('boot');
+    this.boot = await this.rounds(() => this.M._lomn_boot_probe(), 'boot', pre);
+    this.boot.pinned_bytes = this.M._lomn_boot_done();
+    await idbSet(this.cacheKey + 'boot', this.M.UTF8ToString(this.M._lomn_fs_touched())).catch(() => {});
+    this.M._lomn_configure(width, height, 0);
+    this.M.callMain([]);
+  }
+
+  async showArea(level, area) {
+    const key = `area:${level}/${area}`;
+    const t0 = performance.now();
+    this.str(level, (l) => this.str(area, (a) => this.M._lomn_area_begin(l, a)));
+    const pre = await this.cached(key);
+    const r = await this.rounds(() => this.M._lomn_area_probe(), `${level}/${area}`, pre);
+    const touched = this.M.UTF8ToString(this.M._lomn_fs_touched());
+    const read = new Set(touched.split('\n').filter(Boolean));
+    const overFetch = this.fetched.filter((x) => !read.has(`${x.path}\t${x.offset}\t${x.length}`)).reduce((n, x) => n + x.length, 0);
+    if (!this.M._lomn_area_show()) throw new Error(this.lastError());
+    await idbSet(this.cacheKey + key, touched).catch(() => {});
+    this.load = { area: `${level}/${area}`, ...r, touched, over_fetch_bytes: overFetch, concurrency: this.concurrency, load_total_ms: performance.now() - t0 };
+    return this.load;
+  }
+}
+
+// Instantiates the module from wasm bytes fetched (once) and hashed here, so the page knows exactly which build it runs
+// (metrics.build.wasm_sha256; also the prefetch-cache key). onState(state, detail) receives the engine's own states.
+// The two file names below are rewritten to their content-hashed names by web/tools/build_site.mjs.
+export async function createEngine(source, onState) {
+  const res = await fetch(new URL('../lomn_web.wasm', import.meta.url));
+  if (!res.ok) throw new Error('lomn_web.wasm: HTTP ' + res.status);
+  const wasm = new Uint8Array(await res.arrayBuffer());
+  const wasmSha = await sha256hex(wasm);
+  const { default: createLomn } = await import('../lomn_web.js');
+  const M = await createLomn({
+    // Instantiate from the bytes hashed above (no second download; Emscripten 6 ignores a plain wasmBinary option).
+    instantiateWasm: (imports, receive) => {
+      WebAssembly.instantiate(wasm, imports).then((r) => receive(r.instance, r.module), (e) => onState('error', 'wasm instantiate: ' + e));
+      return {};
+    },
+    onLomnState: (s, d) => onState(s, d),
+    print: (t) => console.log(t),
+    printErr: (t) => console.warn(t),
+  });
+  const e = new Engine(M, source, onState);
+  e.wasmSha = wasmSha;
+  e.wasmBytes = wasm.length;
+  e.build = JSON.parse(M.UTF8ToString(M._lomn_build_info()));
+  return e;
+}
diff -ruN -x node_modules base/web/app/fingerprint.js ref/web/app/fingerprint.js
--- base/web/app/fingerprint.js	1970-01-01 01:00:00
+++ ref/web/app/fingerprint.js	2026-10-07 17:17:16
@@ -0,0 +1,96 @@
+// Build identification for the bring-your-own-files page (spec §4.3 "validation is cheap"). Shared by the browser
+// (web/app/byo.js) and Node (web/tools/fingerprint_cli.mjs, the test fixtures); the independent oracle is
+// tools/byo_fingerprint.py. Everything read here is untrusted: every count and length is bounded before use.
+//
+// exe:  SHA-256 of LEGOBionicle.exe at the top of the chosen folder (whole file, <= MAX_EXE_BYTES).
+// data: the blockfile-table fingerprint. For every file data/**/*.blk (path relative to the install root, '/'-separated,
+//       ASCII lower-case, sorted by that path in UTF-16 code-unit order = byte order for ASCII):
+//         header = bytes [0, 12): "BLKF", u32 version, u32 count (little-endian)
+//         table  = bytes [0, 12 + count * 56)           (the ScBlock entry table: names, sizes, flags, offsets)
+//         line   = `${path} ${fileSize} ${sha256hex(table)}`
+//       fingerprint = sha256hex(lines.join('\n') + '\n'). A file whose header is not "BLKF" or whose table does not fit
+//       is an error naming the file.
+export const MAX_EXE_BYTES = 64 * 1024 * 1024;        // real exe: 6,180,412 bytes (canonical) / 6,180,xxx (installer)
+export const MAX_BLK_ENTRIES = 65536;                 // real maximum: 2,608 entries (data/Art/Art.blk)
+export const MAX_BLK_FILES = 4096;                    // real: 189 .blk files
+export const MAX_TOTAL_TABLE_BYTES = 64 * 1024 * 1024; // real: 643,748 bytes over all 189 tables
+const BLK_HEADER = 12;
+const BLK_ENTRY = 56;
+
+const hex = (buf) => Array.from(new Uint8Array(buf), (b) => b.toString(16).padStart(2, '0')).join('');
+export async function sha256hex(bytes) {
+  return hex(await globalThis.crypto.subtle.digest('SHA-256', bytes));
+}
+
+// Lower-case ASCII only (the engine's fs::normalize rule); other bytes are kept.
+export function lowerAscii(s) {
+  return s.replace(/[A-Z]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 32));
+}
+
+// entries: [{path, size}] relative to the install root ('/' separators, any case). readRange(entry, offset, length)
+// resolves to a Uint8Array of exactly `length` bytes. Returns {fingerprint, blkFiles, tableBytes}; throws Error with a
+// message naming the file on malformed input.
+export async function blkTablesFingerprint(entries, readRange) {
+  const blks = entries
+    .map((e) => ({ e, key: lowerAscii(e.path) }))
+    .filter((x) => x.key.startsWith('data/') && x.key.endsWith('.blk'))
+    .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
+  if (blks.length === 0) throw new Error('no data/**/*.blk files: this is not a LOMN install');
+  if (blks.length > MAX_BLK_FILES) throw new Error(`more than ${MAX_BLK_FILES} .blk files`);
+  const lines = [];
+  let total = 0;
+  for (const { e, key } of blks) {
+    if (!(e.size >= BLK_HEADER)) throw new Error(`${e.path}: too small for a blockfile header`);
+    const h = await readRange(e, 0, BLK_HEADER);
+    if (h.length !== BLK_HEADER || h[0] !== 0x42 || h[1] !== 0x4c || h[2] !== 0x4b || h[3] !== 0x46)
+      throw new Error(`${e.path}: not a blockfile (no BLKF magic)`);
+    const count = new DataView(h.buffer, h.byteOffset, h.byteLength).getUint32(8, true);
+    if (count > MAX_BLK_ENTRIES) throw new Error(`${e.path}: ${count} entries (cap ${MAX_BLK_ENTRIES})`);
+    const len = BLK_HEADER + count * BLK_ENTRY;
+    if (len > e.size) throw new Error(`${e.path}: entry table larger than the file`);
+    total += len;
+    if (total > MAX_TOTAL_TABLE_BYTES) throw new Error('blockfile tables over the size cap');
+    const table = await readRange(e, 0, len);
+    if (table.length !== len) throw new Error(`${e.path}: short read`);
+    lines.push(`${key} ${e.size} ${await sha256hex(table)}`);
+  }
+  const text = new TextEncoder().encode(lines.join('\n') + '\n');
+  return { fingerprint: await sha256hex(text), blkFiles: blks.length, tableBytes: total };
+}
+
+// builds.json (tools/builds.json, copied into the site): shape-checked before use.
+export function checkBuilds(b) {
+  const isHex = (s) => typeof s === 'string' && /^[0-9a-f]{64}$/.test(s);
+  const isId = (s) => typeof s === 'string' && s.length > 0 && s.length <= 64;
+  if (!b || typeof b !== 'object' || !Array.isArray(b.accepted) || b.accepted.length > 64) throw new Error('builds.json: bad accepted list');
+  for (const a of b.accepted) if (!isId(a.id) || !isHex(a.exe_sha256)) throw new Error('builds.json: bad accepted entry');
+  const data = b.data ?? [];
+  if (!Array.isArray(data) || data.length > 64) throw new Error('builds.json: bad data list');
+  for (const d of data) if (!isId(d.id) || !isHex(d.blk_tables_sha256)) throw new Error('builds.json: bad data entry');
+  const rejected = b.rejected ?? [];
+  if (!Array.isArray(rejected) || rejected.length > 64) throw new Error('builds.json: bad rejected list');
+  for (const r of rejected)
+    if (!isId(r.id) || !isHex(r.exe_sha256) || typeof r.name !== 'string' || typeof r.reason !== 'string')
+      throw new Error('builds.json: bad rejected entry');
+  return { accepted: b.accepted, data, rejected };
+}
+
+// The verdict for an exe hash + data fingerprint. {ok, build, data, message}; message names the build on rejection.
+export function classify(builds, exeSha, dataFp) {
+  const short = exeSha.slice(0, 12);
+  const rej = builds.rejected.find((r) => r.exe_sha256 === exeSha);
+  if (rej) return { ok: false, message: `This is ${rej.name} (LEGOBionicle.exe SHA-256 ${short}…), which is not supported: ${rej.reason}` };
+  const acc = builds.accepted.find((a) => a.exe_sha256 === exeSha);
+  if (!acc)
+    return { ok: false, message: `Unknown build: LEGOBionicle.exe SHA-256 ${short}… is not an accepted build. Only BIONICLE: The Legend of Mata Nui Beta 1.5.0 is supported (REBUILT and other mods are not).` };
+  const data = builds.data.find((d) => d.blk_tables_sha256 === dataFp);
+  // REF4 r2 decision D13 (controller ruling C2, option b): an accepted exe with blockfile tables no accepted build lists is
+  // SOFT-accepted: every parser is bounded, so differing tables are a fidelity risk, not a safety one (the canonical
+  // build's own data has never been fingerprinted). The page shows a persistent warning and the reason goes into the
+  // metrics. The owner can tighten this to a rejection by adding the canonical fingerprint to builds.json `data`.
+  if (!data) {
+    const warning = `Game data differs from the known build — rendering may differ (.blk table fingerprint ${dataFp.slice(0, 12)}… is not in builds.json for "${acc.id}")`;
+    return { ok: true, build: acc.id, data: 'unknown', warning, message: `Accepted with a warning: ${acc.id}, unknown data` };
+  }
+  return { ok: true, build: acc.id, data: data.id, message: `Accepted: ${acc.id} with ${data.id}` };
+}
diff -ruN -x node_modules base/web/app/idb.js ref/web/app/idb.js
--- base/web/app/idb.js	1970-01-01 01:00:00
+++ ref/web/app/idb.js	2026-10-07 17:17:16
@@ -0,0 +1,33 @@
+// Minimal IndexedDB key/value store (one database, one object store). Holds the picked directory handle (Chromium:
+// FileSystemDirectoryHandle is structured-cloneable) and the per-area prefetch sets the engine discovered.
+const DB = 'lomn-web';
+const STORE = 'kv';
+
+function open() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function tx(mode, fn) {
+  const db = await open();
+  try {
+    return await new Promise((resolve, reject) => {
+      const t = db.transaction(STORE, mode);
+      const req = fn(t.objectStore(STORE));
+      t.oncomplete = () => resolve(req?.result);
+      t.onerror = () => reject(t.error);
+      t.onabort = () => reject(t.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+export const idbGet = (key) => tx('readonly', (s) => s.get(key));
+export const idbSet = (key, value) => tx('readwrite', (s) => s.put(value, key));
+export const idbDelete = (key) => tx('readwrite', (s) => s.delete(key));
+export const idbKeys = () => tx('readonly', (s) => s.getAllKeys());
diff -ruN -x node_modules base/web/app/main.js ref/web/app/main.js
--- base/web/app/main.js	1970-01-01 01:00:00
+++ ref/web/app/main.js	2026-10-07 17:36:03
@@ -0,0 +1,379 @@
+// LOMN Web viewer page: bring-your-own files -> validation -> (copy) -> engine -> area viewer.
+// window.__lomn: {state, message, error, build, source, areas, metrics (getter), load, boot, copy, showArea(), ...}.
+// States: boot | need-files | need-permission | validating | rejected | quota-short | copying | starting | ready |
+//         loading-area | area-ready | error. Tests wait on these (never on time).
+import { checkBuilds } from './fingerprint.js';
+import { copyToOpfs, filesSource, handleSource, opfsClear, opfsCopy, opfsDirExists, quotaCheck, sameFiles, totalBytes, validate } from './byo.js';
+import { createEngine } from './engine.js';
+import { idbDelete, idbGet, idbSet } from './idb.js';
+
+const $ = (id) => document.getElementById(id);
+const params = new URLSearchParams(location.search);
+const L = (window.__lomn = window.__lomn || {});
+let engine = null;
+let builds = null;
+let busy = false;
+let starting = false;  // M4: one engine per page (a second pick while one starts is refused)
+// M13: unfaithful or test-only switches need ?debug=1, so a pasted URL never silently renders differently.
+const debug = params.get('debug') === '1';
+
+function setState(state, message = '') {
+  L.state = state;
+  L.message = message;
+  $('status').textContent = state;
+  $('message').textContent = message;
+  $('message').dataset.state = state;
+}
+function fail(err) {
+  L.error = String(err?.message ?? err);
+  setState('error', L.error);
+}
+const pickerMessage = 'Choose your BIONICLE: The Legend of Mata Nui (Beta 1.5.0) folder. Nothing is uploaded: the files are read on this computer.';
+// I3/I6/I7: back to the folder choice with a reason (the picker button shown where the browser has one).
+function needFiles(reason) {
+  $('byo').hidden = false;
+  $('viewer').hidden = true;
+  if ('showDirectoryPicker' in window && params.get('fs') !== 'opfs') $('pick-dir').hidden = false;
+  setState('need-files', reason ? `${reason} ${pickerMessage}` : pickerMessage);
+}
+const mb = (n) => (n / 1048576).toFixed(1) + ' MiB';
+
+// Canvas: ?size=WxH fixes the drawing buffer and CSS size (tests compare pixels at 1280x720); otherwise the canvas takes
+// its container's width (min(100%, 1280px)) and a 16:9 height rounded to a whole CSS pixel, and the drawing buffer is that
+// size x devicePixelRatio (ResizeObserver -> lomn_resize: surface + depth buffer recreated).
+function canvasSize() {
+  const m = /^(\d{2,4})x(\d{2,4})$/.exec(params.get('size') || '');
+  if (m) return { w: +m[1], h: +m[2], fixed: true };
+  const c = $('canvas');
+  const dpr = window.devicePixelRatio || 1;
+  const cssW = Math.max(1, Math.round(c.parentElement.clientWidth)), cssH = Math.max(1, Math.round((cssW * 9) / 16));
+  return { w: Math.round(cssW * dpr), h: Math.round(cssH * dpr), cssW, cssH, fixed: false };
+}
+
+async function start() {
+  try {
+    if (params.get('scene') === 'triangle') return startTriangle();
+    setState('boot');
+    const res = await fetch('builds.json');
+    builds = checkBuilds(await res.json());
+    if ('showDirectoryPicker' in window && params.get('fs') !== 'opfs') $('pick-dir').hidden = false;
+    // ?pick=1: choose a (different) folder even when one is remembered.
+    if (params.get('pick') === '1') return setState('need-files', 'Choose the game folder.');
+    // Revisit 1: a folder handle the player picked earlier (Chromium).
+    const handle = await idbGet('install-handle').catch(() => null);
+    if (handle && params.get('fs') !== 'opfs') {
+      // I3: a remembered folder that was moved or deleted is forgotten and the folder asked for again (never a dead end).
+      const revisit = async () => {
+        let src;
+        try {
+          src = await handleSource(handle, 'handle');
+        } catch (err) {
+          await idbDelete('install-handle').catch(() => {});
+          L.forgottenHandle = String(err?.message ?? err);
+          return needFiles(`The remembered folder "${handle.name}" could not be read (moved or deleted).`);
+        }
+        return useSource(src, 'revisit');
+      };
+      const perm = await handle.queryPermission({ mode: 'read' });
+      if (perm === 'granted') return revisit();
+      $('regrant').hidden = false;
+      $('regrant').textContent = `Allow access to "${handle.name}" again`;
+      $('regrant').onclick = async () => {
+        if ((await handle.requestPermission({ mode: 'read' })) === 'granted') {
+          $('regrant').hidden = true;
+          revisit();
+        } else {
+          setState('need-permission', 'Permission was not granted. Choose the folder again.');
+        }
+      };
+      return setState('need-permission', `The game folder "${handle.name}" needs your permission again.`);
+    }
+    // Revisit 2: a finished OPFS copy (Safari/Firefox path), checked against its completion manifest (I6).
+    const copy = await opfsCopy();
+    if (copy) {
+      let src, why = '';
+      try {
+        src = await handleSource(copy.dir, 'opfs');
+        why = sameFiles(src.entries, copy.done.files);
+      } catch (err) {
+        why = String(err?.message ?? err);
+      }
+      if (!why) return useSource(src, 'revisit');
+      await opfsClear();
+      L.copyProblem = why;
+      return needFiles(`The browser copy of the game files was incomplete (${why}) and was removed.`);
+    }
+    // I7: a copy directory without its completion manifest is an interrupted copy: free its space now.
+    if (await opfsDirExists()) {
+      await opfsClear();
+      return needFiles('An incomplete copy (interrupted before it finished) was removed.');
+    }
+    needFiles('');
+  } catch (err) {
+    fail(err);
+  }
+}
+
+async function onPickDir() {
+  try {
+    const handle = await window.showDirectoryPicker({ id: 'lomn-install', mode: 'read' });
+    await adoptHandle(handle);
+  } catch (err) {
+    if (err?.name !== 'AbortError') fail(err);
+  }
+}
+// The Chromium path: the handle is read in place (no copy) and persisted for the next visit.
+async function adoptHandle(handle) {
+  const src = await handleSource(handle, 'handle');
+  const ok = await useSource(src, 'picked');
+  if (ok) await idbSet('install-handle', handle);
+  return ok;
+}
+
+// Safari/Firefox path (also used by Chromium when the folder comes from the input): validate the File objects, check the
+// quota, copy into OPFS in a worker, then read from the copy.
+async function onInput(ev) {
+  if (busy) return;
+  busy = true;
+  try {
+    const src = filesSource(ev.target.files);
+    setState('validating', `Checking ${src.entries.length} files…`);
+    const v = await validate(src, builds);
+    L.validation = v;
+    if (!v.ok) return setState('rejected', v.message);
+    await opfsClear();
+    const need = totalBytes(src);
+    const q = await quotaCheck(need);
+    L.quota = q;
+    if (!q.ok)
+      return setState('quota-short', `Not enough browser storage to copy the game files: ${mb(q.need)} needed, ${mb(q.free)} available` +
+        ` (persistent storage ${q.persisted ? 'granted' : 'not granted'}). Free some space, or use Chrome or Edge, which read the folder in place without copying.`);
+    setState('copying', `Copying ${mb(need)} into browser storage (one time)…`);
+    $('copy-progress').hidden = false;
+    $('copy-progress').max = need;
+    const t0 = performance.now();
+    const res = await copyToOpfs(src, v, (done, total) => {
+      $('copy-progress').value = done;
+      L.copyProgress = { done, total };
+    });
+    L.copy = { bytes: res.bytes, ms: performance.now() - t0 };
+    $('copy-progress').hidden = true;
+    const copy = await opfsCopy();
+    if (!copy) throw new Error('the copy finished but its completion manifest is missing');
+    await useSource(await handleSource(copy.dir, 'opfs'), 'copied');
+  } catch (err) {
+    fail(err);
+  } finally {
+    busy = false;
+    ev.target.value = '';
+  }
+}
+
+async function useSource(src, how) {
+  if (starting || engine) return false;  // M4: a second pick never starts a second engine on the same canvas
+  starting = true;
+  try {
+    return await startWith(src, how);
+  } finally {
+    if (!engine) starting = false;
+  }
+}
+
+async function startWith(src, how) {
+  setState('validating', `Checking ${src.entries.length} files…`);
+  const v = await validate(src, builds);
+  L.validation = v;
+  L.sourceWarnings = src.warnings ?? [];
+  if (!v.ok) {
+    setState('rejected', v.message);
+    return false;
+  }
+  // C2 (D13): accepted exe + unknown tables: shown, with a persistent warning; the reason also goes into the metrics.
+  if (v.warning) {
+    $('warning').hidden = false;
+    $('warning').textContent = v.warning;
+  }
+  L.build = v.build;
+  L.source = { kind: src.kind, how, name: src.name, files: src.entries.length, bytes: totalBytes(src) };
+  $('byo').hidden = true;
+  $('viewer').hidden = false;
+  setState('starting', `${v.message}. Starting the engine…`);
+  const size = canvasSize();
+  applyCanvasSize(size);
+  engine = await createEngine(src, onEngineState);
+  L.engine = engine;
+  engine.validation = { build: v.build, data: v.data, warning: v.warning ?? null, source_warnings: (src.warnings ?? []).length };
+  if (debug) {
+    // ?debug=1&fog=off: the pixel gate's positive control. ?debug_spin=MS: busy-wait per frame (I2). ?fetch_concurrency=N,
+    // ?nocache=1: prefetch measurement switches (M1).
+    if (params.get('fog') === 'off') engine.M._lomn_set_fog(0);
+    const spin = Number(params.get('debug_spin') || 0);
+    if (spin > 0) engine.M._lomn_debug_spin(spin);
+    engine.concurrency = Math.max(1, Math.min(16, Number(params.get('fetch_concurrency') || 1)));
+    if (params.get('nocache') === '1') engine.useCache = false;
+  }
+  await engine.bootAndMain(size.w, size.h, `prefetch|${v.dataFp}|${engine.wasmSha}|`);
+  L.boot = engine.boot;
+  return true;
+}
+
+function applyCanvasSize(size) {
+  const c = $('canvas');
+  if (size.fixed) {
+    c.parentElement.style.width = size.w + 'px';
+    c.style.width = size.w + 'px';
+    c.style.height = size.h + 'px';
+  } else {
+    c.style.height = size.cssH + 'px';  // whole CSS pixels (the 16:9 aspect-ratio alone can give x.5)
+  }
+  c.width = size.w;
+  c.height = size.h;
+}
+
+function onEngineState(state, detail) {
+  if (state === 'error') {
+    // C1: a lost GPU device (or the engine's first uncaptured GPU error) ends the session: say so, offer a reload.
+    L.lost = detail;
+    $('loading').hidden = true;
+    $('reload').hidden = false;
+    return fail(new Error(detail));
+  }
+  if (state !== 'ready') return;
+  L.adapter = detail;
+  L.metricsAtReady = engine.metrics();  // the heap after the boot set, before any area (memory budget)
+  L.areas = engine.areas();
+  const pick = $('area-picker');
+  pick.textContent = '';
+  for (const a of L.areas) pick.add(new Option(`${a.level}/${a.area}`, `${a.level}/${a.area}`));
+  pick.onchange = () => showArea(pick.value);
+  if (!canvasSize().fixed) new ResizeObserver(() => {
+    const s = canvasSize();
+    $('canvas').style.height = s.cssH + 'px';
+    if (s.w !== $('canvas').width || s.h !== $('canvas').height) engine.M._lomn_resize(s.w, s.h);
+  }).observe($('canvas').parentElement);
+  setState('ready', `${L.areas.length} areas. Pick one.`);
+  startInput();
+  if (params.get('hud') === '1') startHud();
+  const first = params.get('area') || (L.areas[0] ? `${L.areas[0].level}/${L.areas[0].area}` : '');
+  // I2: the engine measures the display rate from 100 empty frames before the first area (about 1.7 s at 60 Hz); the
+  // first area waits for it (at most 6 s; without it the HUD says the rate is not measured).
+  const t0 = performance.now();
+  const wait = () => {
+    if (engine.metrics().fps.display_hz > 0 || performance.now() - t0 > 6000) {
+      if (first) showArea(first);
+    } else {
+      requestAnimationFrame(wait);
+    }
+  };
+  requestAnimationFrame(wait);
+}
+
+// Area switch: the previous area keeps rendering under the loading overlay while the next one is prefetched.
+async function showArea(name) {
+  if (!engine || busy) return false;
+  const [level, area] = String(name).split('/');
+  if (!L.areas.some((a) => a.level === level && a.area === area)) return false;
+  busy = true;
+  $('area-picker').value = name;
+  $('area-picker').disabled = true;
+  $('loading').hidden = false;
+  setState('loading-area', `Loading ${name}…`);
+  try {
+    L.load = await engine.showArea(level, area);
+    setState('area-ready', name);
+    return true;
+  } catch (err) {
+    fail(err);
+    return false;
+  } finally {
+    busy = false;
+    $('area-picker').disabled = false;
+    $('loading').hidden = true;
+  }
+}
+
+// Free-fly camera input: WASD / arrows move, Q/E down/up, Shift faster; drag (or pointer lock after a click) looks.
+function startInput() {
+  const c = $('canvas');
+  const bits = { KeyW: 1, ArrowUp: 1, KeyS: 2, ArrowDown: 2, KeyA: 4, ArrowLeft: 4, KeyD: 8, ArrowRight: 8, KeyE: 16, KeyQ: 32, ShiftLeft: 64, ShiftRight: 64 };
+  let keys = 0, dragging = false;
+  const push = (dx = 0, dy = 0) => engine.M._lomn_input(keys, dx, dy);
+  // M3: keys move the camera only while the canvas has focus (click it) or the pointer is locked to it; elsewhere the
+  // page keeps its normal keyboard behaviour (Tab, Shift+Tab, arrows in the picker).
+  const ours = () => document.activeElement === c || document.pointerLockElement === c;
+  addEventListener('keydown', (e) => {
+    if (!ours() || !(e.code in bits)) return;
+    keys |= bits[e.code];
+    push();
+    e.preventDefault();
+  });
+  addEventListener('keyup', (e) => {
+    if (!(e.code in bits)) return;
+    keys &= ~bits[e.code];
+    push();
+  });
+  addEventListener('blur', () => { keys = 0; push(); });
+  c.addEventListener('mousedown', () => { dragging = true; c.focus(); });
+  addEventListener('mouseup', () => { dragging = false; });
+  c.addEventListener('dblclick', () => {
+    const r = c.requestPointerLock?.();  // a promise in current Chromium: a refused lock is not an unhandled rejection
