+  assert.deepEqual(s.entries.map((e) => e.path), ['LEGOBionicle.exe', 'data/Base.osi']);
+  assert.equal(s.warnings.length, 2);
+  assert.match(s.warnings.join('\n'), /same name/);
+  assert.match(s.warnings.join('\n'), /bytes/);
+});
+
