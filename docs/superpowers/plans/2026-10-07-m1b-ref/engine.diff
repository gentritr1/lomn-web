diff -ruN base/engine/src/view/fly_camera.cpp ref/engine/src/view/fly_camera.cpp
--- base/engine/src/view/fly_camera.cpp	1970-01-01 01:00:00
+++ ref/engine/src/view/fly_camera.cpp	2026-10-07 15:37:38
@@ -0,0 +1,61 @@
+#include "lomn/view/fly_camera.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace lomn::view {
+namespace {
+constexpr double kDeg = 3.14159265358979323846 / 180.0;
+float wrap_yaw(double y) {
+  y = std::fmod(y, 360.0);
+  if (y > 180.0) y -= 360.0;
+  if (y <= -180.0) y += 360.0;
+  return static_cast<float>(y);
+}
+}  // namespace
+
+void FlyCamera::reset(const Camera& start) {
+  std::memcpy(eye_, start.eye, sizeof eye_);
+  yaw_ = start.yaw_deg;
+  pitch_ = start.pitch_deg;
+  moved_ = false;
+}
+
+void FlyCamera::update(const FlyInput& in, double dt_s, const FlySpeeds& sp) {
+  if (!std::isfinite(dt_s)) dt_s = 0;
+  dt_s = std::max(0.0, std::min(0.25, dt_s));
+  const bool look = std::isfinite(in.look_dx) && std::isfinite(in.look_dy) && (in.look_dx != 0 || in.look_dy != 0);
+  if (look) {
+    yaw_ = wrap_yaw(static_cast<double>(yaw_) + static_cast<double>(in.look_dx) * sp.deg_per_pixel);
+    const double p = static_cast<double>(pitch_) - static_cast<double>(in.look_dy) * sp.deg_per_pixel;
+    pitch_ = static_cast<float>(std::max<double>(-kMaxPitchDeg, std::min<double>(kMaxPitchDeg, p)));
+    moved_ = true;
+  }
+  const float f = (in.forward ? 1.0f : 0.0f) - (in.back ? 1.0f : 0.0f);
+  const float r = (in.right ? 1.0f : 0.0f) - (in.left ? 1.0f : 0.0f);
+  const float u = (in.up ? 1.0f : 0.0f) - (in.down ? 1.0f : 0.0f);
+  if ((f != 0 || r != 0 || u != 0) && dt_s > 0) {
+    const double step = static_cast<double>(sp.units_per_s) * (in.fast ? sp.fast_multiplier : 1.0f) * dt_s;
+    const double y = yaw_ * kDeg, p = pitch_ * kDeg;
+    // make_camera's forward: (sin y cos p, sin p, -cos y cos p); right = forward x up projected on xz: (cos y, 0, sin y).
+    const double fwd[3] = {std::sin(y) * std::cos(p), std::sin(p), -std::cos(y) * std::cos(p)};
+    const double right[3] = {std::cos(y), 0.0, std::sin(y)};
+    for (int k = 0; k < 3; ++k)
+      eye_[k] = static_cast<float>(eye_[k] + step * (f * fwd[k] + r * right[k] + (k == 1 ? u : 0.0f)));
+    moved_ = true;
+  }
+}
+
+CameraSettings FlyCamera::settings(const CameraSettings& base) const {
+  if (!moved_) return base;
+  CameraSettings s = base;
+  s.eye_set = true;
+  std::memcpy(s.eye, eye_, sizeof s.eye);
+  s.yaw_set = true;
+  s.yaw_deg = yaw_;
+  s.pitch_deg = pitch_;
+  return s;
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/src/view/prefetch.cpp ref/engine/src/view/prefetch.cpp
--- base/engine/src/view/prefetch.cpp	1970-01-01 01:00:00
+++ ref/engine/src/view/prefetch.cpp	2026-10-07 15:38:06
@@ -0,0 +1,49 @@
+#include "lomn/view/prefetch.h"
+
+#include <algorithm>
+#include <set>
+
+#include "lomn/sage/blockchain.h"
+#include "lomn/view/area.h"
+
+namespace lomn::view {
+
+void boot_reads(const fs::FileSystem& fs) {
+  sage::BlockChain chain(fs);
+  chain.open_art(kArtBlkPath, nullptr);  // header + table (GcGame::LoadArtBlockHeader); absent on a synthetic install
+  std::vector<uint8_t> bytes;
+  fs.read(kBaseOsiPath, bytes);
+}
+
+std::vector<fs::ByteRange> record_reads(fs::FileSystem& fs, const std::function<void()>& fn) {
+  std::set<fs::ByteRange> seen;
+  fs.set_range_logger([&seen](const std::string& p, uint64_t off, uint64_t len) { seen.insert({p, off, len}); });
+  fn();
+  fs.set_range_logger(nullptr);
+  return std::vector<fs::ByteRange>(seen.begin(), seen.end());
+}
+
+std::vector<AreaRef> list_areas(const std::vector<std::string>& paths) {
+  static const std::string kPrefix = "root/data/levels/";
+  std::set<AreaRef> out;
+  for (const std::string& p : paths) {
+    if (p.compare(0, kPrefix.size(), kPrefix) != 0) continue;
+    const std::string rest = p.substr(kPrefix.size());
+    const size_t slash = rest.find('/');
+    if (slash == std::string::npos || rest.find('/', slash + 1) != std::string::npos) continue;
+    const std::string lev = rest.substr(0, slash), file = rest.substr(slash + 1);
+    if (file.size() < 5 || file.compare(file.size() - 4, 4, ".blk") != 0) continue;
+    const std::string stem = file.substr(0, file.size() - 4);
+    if (stem == lev || lev.empty() || lev.size() > 4 || stem.size() > 4) continue;
+    out.insert({lev, stem});
+  }
+  return std::vector<AreaRef>(out.begin(), out.end());
+}
+
+std::string ranges_text(const std::vector<fs::ByteRange>& ranges) {
+  std::string o;
+  for (const fs::ByteRange& r : ranges) o += r.path + "\t" + std::to_string(r.offset) + "\t" + std::to_string(r.length) + "\n";
+  return o;
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/tests/test_fly_camera.cpp ref/engine/tests/test_fly_camera.cpp
--- base/engine/tests/test_fly_camera.cpp	1970-01-01 01:00:00
+++ ref/engine/tests/test_fly_camera.cpp	2026-10-07 15:43:34
@@ -0,0 +1,102 @@
+// M1b: the viewer's free-fly camera (lomn/view/fly_camera.h).
+#include <cmath>
+#include <cstring>
+
+#include "doctest.h"
+#include "lomn/fs.h"
+#include "lomn/view/fly_camera.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn::view;
+
+namespace {
+Camera start_camera(float yaw, float pitch) {
+  Camera c;
+  c.eye[0] = 1;
+  c.eye[1] = 2;
+  c.eye[2] = 3;
+  c.yaw_deg = yaw;
+  c.pitch_deg = pitch;
+  return c;
+}
+}  // namespace
+
+TEST_CASE("fly camera: untouched it returns the base settings, so the first view is the default camera bit for bit") {
+  lomn::fs::MemoryFileSystem m;
+  REQUIRE(mount_synthetic_install(m));
+  AreaData a;
+  std::string err;
+  REQUIRE(load_area(m, kSyntheticLevel, kSyntheticArea, AreaOptions(), a, &err));
+  const Camera base = make_camera(a, CameraSettings(), 16.0f / 9.0f);
+  FlyCamera f;
+  f.reset(base);
+  FlyInput none;
+  f.update(none, 0.016);
+  CHECK_FALSE(f.moved());
+  const Camera again = make_camera(a, f.settings(CameraSettings()), 16.0f / 9.0f);
+  CHECK(std::memcmp(again.view.m, base.view.m, sizeof base.view.m) == 0);
+  CHECK(std::memcmp(again.proj.m, base.proj.m, sizeof base.proj.m) == 0);
+  CHECK(again.eye_source == "pos_start");
+  // After a move the overrides take over: eye exactly the fly eye (no eye_height added), yaw/pitch as flown.
+  FlyInput w;
+  w.forward = true;
+  f.update(w, 0.5);
+  REQUIRE(f.moved());
+  const Camera moved = make_camera(a, f.settings(CameraSettings()), 16.0f / 9.0f);
+  CHECK(moved.eye_source == "cli");
+  for (int k = 0; k < 3; ++k) CHECK(moved.eye[k] == f.eye()[k]);
+  CHECK(moved.yaw_deg == doctest::Approx(base.yaw_deg));
+}
+
+TEST_CASE("fly camera: WASD moves along make_camera's forward/right, Q/E (up/down) along world Y, Shift is faster") {
+  FlyCamera f;
+  f.reset(start_camera(0, 0));  // looking along -Z
+  FlyInput in;
+  in.forward = true;
+  f.update(in, 1.0 / 8);  // 12 u/s * 0.125 s
+  CHECK(f.eye()[2] == doctest::Approx(3 - 1.5));
+  CHECK(f.eye()[0] == doctest::Approx(1));
+  in = FlyInput();
+  in.right = true;
+  in.fast = true;
+  f.update(in, 0.1);  // +X at 60 u/s
+  CHECK(f.eye()[0] == doctest::Approx(1 + 6));
+  in = FlyInput();
+  in.up = true;
+  f.update(in, 0.25);
+  CHECK(f.eye()[1] == doctest::Approx(2 + 3));
+  // yaw 90 looks along +X: forward moves +X.
+  f.reset(start_camera(90, 0));
+  in = FlyInput();
+  in.forward = true;
+  f.update(in, 0.25);
+  CHECK(f.eye()[0] == doctest::Approx(1 + 3));
+  CHECK(f.eye()[2] == doctest::Approx(3).epsilon(1e-5));
+}
+
+TEST_CASE("fly camera: mouse look, pitch clamp, dt clamp, non-finite input ignored") {
+  FlyCamera f;
+  f.reset(start_camera(170, 0));
+  FlyInput in;
+  in.look_dx = 100;  // 15 degrees: wraps past 180
+  in.look_dy = -100; // up 15 degrees
+  f.update(in, 0.016);
+  CHECK(f.yaw_deg() == doctest::Approx(-175));
+  CHECK(f.pitch_deg() == doctest::Approx(15));
+  in.look_dx = 0;
+  in.look_dy = -10000;
+  f.update(in, 0.016);
+  CHECK(f.pitch_deg() == doctest::Approx(kMaxPitchDeg));
+  f.reset(start_camera(0, 0));
+  in = FlyInput();
+  in.forward = true;
+  f.update(in, 10.0);  // a stalled tab: at most 0.25 s of movement
+  CHECK(f.eye()[2] == doctest::Approx(3 - 3));
+  f.reset(start_camera(0, 0));
+  f.update(in, std::nan(""));
+  CHECK_FALSE(f.moved());
+  in = FlyInput();
+  in.look_dx = std::nanf("");
+  f.update(in, 0.016);
+  CHECK_FALSE(f.moved());
+}
diff -ruN base/engine/tests/test_gpu_destroy.cpp ref/engine/tests/test_gpu_destroy.cpp
--- base/engine/tests/test_gpu_destroy.cpp	1970-01-01 01:00:00
+++ ref/engine/tests/test_gpu_destroy.cpp	2026-10-07 17:15:59
@@ -0,0 +1,199 @@
+// M1b rhi on Dawn (headless). Exits 77 (ctest SKIP) without an adapter.
+//  1. destroy_* with the dependency rule: a texture/sampler/uniform buffer referenced by a live bind group is rejected
+//     (counted, nothing freed); after the bind group goes, all of them go; live_objects() follows.
+//  2. Destroy inside an open frame: the bind group and texture of a draw already recorded are destroyed before
+//     end_frame; the frame still renders that texture (WebGPU keeps recorded objects alive) with no Dawn error.
+//  3. Leak loops: 300 x (texture + bind group) and 100 x (depth render target) created and destroyed: live counts flat.
+//  4. Surface calls on a headless device are counted rejections.
+//  5. AreaRenderer::release: the synthetic A7 scene uploaded, rendered, read back and released 8 times on one device:
+//     pixels byte-identical every cycle, live counts back to the baseline after every release.
+//  REF4 r2: destroy_texture/destroy_buffer now Destroy the GPU object (deferred to end_frame inside a frame): probes 2
+//  and 5 cover both paths. 6. the lost handler receives the first uncaptured GPU error once.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "lomn/fs.h"
+#include "lomn/rhi.h"
+#include "lomn/view/area.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn;
+using namespace lomn::rhi;
+
+namespace {
+
+const char* kWgsl = R"(
+struct U { tint: vec4f }
+@group(0) @binding(0) var<uniform> u: U;
+@group(0) @binding(1) var tex: texture_2d<f32>;
+@group(0) @binding(2) var samp: sampler;
+struct VOut { @builtin(position) pos: vec4f }
+@vertex fn vs(@location(0) p: vec3f) -> VOut { var o: VOut; o.pos = vec4f(p, 1.0); return o; }
+@fragment fn fs(i: VOut) -> @location(0) vec4f { return vec4f(textureSample(tex, samp, vec2f(0.5, 0.5)).rgb * u.tint.rgb, 1.0); }
+)";
+
+bool same(const Device::LiveObjects& a, const Device::LiveObjects& b) { return a == b; }
+void print(const char* what, const Device::LiveObjects& o) {
+  std::printf("     %s: textures=%u buffers=%u pipelines=%u samplers=%u bind_groups=%u\n", what, o.textures, o.buffers, o.pipelines,
+              o.samplers, o.bind_groups);
+}
+
+}  // namespace
+
+int main() {
+  std::unique_ptr<Device> dev;
+  std::string err;
+  create_webgpu_device(nullptr, 0, 0, [&](std::unique_ptr<Device> d, std::string e) {
+    dev = std::move(d);
+    err = std::move(e);
+  });
+  if (!dev) {
+    std::printf("SKIPPED (no WebGPU adapter: %s)\n", err.c_str());
+    return 77;
+  }
+  bool ok = true;
+  auto check = [&](bool hit, const char* what) {
+    std::printf("%s %s\n", hit ? "ok  " : "FAIL", what);
+    ok = ok && hit;
+  };
+
+  // 1. Dependency rule.
+  MeshPipelineDesc pd;
+  pd.wgsl = kWgsl;
+  pd.uniform_bytes = 16;
+  pd.vertex_stride = 12;
+  pd.attributes = {{VertexFormat::Float32x3, 0, 0}};
+  const PipelineId pipe = dev->create_mesh_pipeline(pd);
+  const float quad[4][3] = {{-1, -1, 0.5f}, {1, -1, 0.5f}, {1, 1, 0.5f}, {-1, 1, 0.5f}};
+  const uint32_t idx[6] = {0, 1, 2, 0, 2, 3};
+  const BufferId vb = dev->create_vertex_buffer(sizeof quad), ib = dev->create_index_buffer(sizeof idx);
+  const BufferId ub = dev->create_uniform_buffer(kUniformAlign);
+  dev->write_buffer(vb, 0, quad, sizeof quad);
+  dev->write_buffer(ib, 0, idx, sizeof idx);
+  const float tint[4] = {1, 1, 1, 1};
+  dev->write_buffer(ub, 0, tint, sizeof tint);
+  const SamplerId samp = dev->create_sampler(SamplerDesc());
+  const Device::LiveObjects base = dev->live_objects();
+  const TextureId tex = dev->create_texture(1, 1, 1);
+  const uint8_t green[4] = {0, 255, 0, 255};
+  dev->write_texture(tex, 0, green, 4);
+  const BindGroupId bg = dev->create_bind_group({ub, 16, tex, samp});
+  if (!pipe || !vb || !ib || !ub || !samp || !tex || !bg) return std::printf("FAIL setup\n"), 1;
+  const uint32_t rej0 = dev->last_frame_stats().rejected;
+  check(!dev->destroy_texture(tex) && !dev->destroy_sampler(samp) && !dev->destroy_buffer(ub) &&
+            dev->last_frame_stats().rejected == rej0 + 3,
+        "1. texture/sampler/uniform buffer referenced by a live bind group: 3 rejected destroys");
+  check(dev->live_objects().textures == base.textures + 1 && dev->live_objects().bind_groups == 1, "1. nothing freed by the rejections");
+
+  // 2. Destroy inside an open frame, after the draw was recorded.
+  const TextureId rt = dev->create_render_target_ex(RenderTargetDesc{8, 8, true, 1.0f});
+  const float clear[4] = {0, 0, 0.25f, 1};
+  dev->begin_frame(rt, clear);
+  dev->draw_indexed({pipe, vb, ib, 0, 6, bg, 0});
+  const bool d1 = dev->destroy_bind_group(bg), d2 = dev->destroy_texture(tex);
+  dev->end_frame();
+  std::vector<uint8_t> px;
+  const bool read = dev->read_pixels(rt, px);
+  check(d1 && d2 && read && px.size() == 8 * 8 * 4 && px[(4 * 8 + 4) * 4 + 1] >= 253 && px[(4 * 8 + 4) * 4 + 0] <= 2,
+        "2. bind group + texture destroyed after the draw was recorded: the frame still shows the texture (green)");
+  check(dev->last_frame_stats().draws == 1 && dev->last_frame_stats().rejected == 0, "2. 1 draw, 0 rejected");
+  check(dev->destroy_texture(rt), "2. the render target (with its depth buffer) is destroyable");
+  check(same(dev->live_objects(), base), "1+2. live objects back to the baseline");
+
+  // 3. Leak loops.
+  for (int i = 0; i < 300; ++i) {
+    const TextureId t = dev->create_texture(256, 256, 9);
+    const BindGroupId g = dev->create_bind_group({ub, 16, t, samp});
+    if (!t || !g || !dev->destroy_bind_group(g) || !dev->destroy_texture(t)) {
+      ok = false;
+      std::printf("FAIL 3. texture loop iteration %d\n", i);
+      break;
+    }
+  }
+  for (int i = 0; i < 100; ++i) {
+    const TextureId t = dev->create_render_target_ex(RenderTargetDesc{640, 480, true, 1.0f});
+    if (!t || !dev->destroy_texture(t)) {
+      ok = false;
+      std::printf("FAIL 3. render-target loop iteration %d\n", i);
+      break;
+    }
+  }
+  check(same(dev->live_objects(), base), "3. 300 texture+bind group and 100 depth-target create/destroy cycles: counts flat");
+
+  // 4. Surface calls headless.
+  const uint32_t rej1 = dev->last_frame_stats().rejected;
+  check(!dev->set_surface_depth(true, 1.0f) && !dev->resize(64, 64) && dev->last_frame_stats().rejected == rej1 + 2,
+        "4. set_surface_depth / resize without a surface: counted rejections");
+
+  // 5. AreaRenderer::release cycles on the synthetic A7 scene.
+  fs::MemoryFileSystem mfs;
+  view::AreaData area;
+  if (!view::mount_synthetic_install(mfs) || !view::load_area(mfs, view::kSyntheticLevel, view::kSyntheticArea, view::AreaOptions(), area, &err))
+    return std::printf("FAIL load: %s\n", err.c_str()), 1;
+  const TextureId art = dev->create_render_target_ex(RenderTargetDesc{64, 64, true, 1.0f});
+  const Device::LiveObjects before = dev->live_objects();
+  view::AreaRenderer r;
+  std::vector<uint8_t> first;
+  Device::LiveObjects shown;
+  for (int cycle = 0; cycle < 8; ++cycle) {
+    if (!r.upload(*dev, area, view::RenderOptions(), &err)) {
+      std::printf("FAIL 5. upload cycle %d: %s\n", cycle, err.c_str());
+      ok = false;
+      break;
+    }
+    r.render(*dev, art, area, view::make_camera(area, view::synthetic_camera(), 1.0f));
+    r.render(*dev, art, area, view::make_camera(area, view::synthetic_camera(), 1.0f));
+    std::vector<uint8_t> p;
+    if (!dev->read_pixels(art, p)) {
+      ok = false;
+      break;
+    }
+    if (cycle == 0) {
+      first = p;
+      shown = dev->live_objects();
+      print("area shown", shown);
+    } else if (p != first || !same(dev->live_objects(), shown)) {
+      std::printf("FAIL 5. cycle %d: pixels %s, live counts %s\n", cycle, p == first ? "same" : "DIFFER",
+                  same(dev->live_objects(), shown) ? "same" : "DIFFER");
+      ok = false;
+    }
+    uint32_t failures = 0;
+    r.release(*dev, &failures);
+    if (failures || !same(dev->live_objects(), before)) {
+      std::printf("FAIL 5. cycle %d: release failures %u\n", cycle, failures);
+      print("after release", dev->live_objects());
+      ok = false;
+    }
+  }
+  check(ok, "5. 8 upload/render/release cycles: identical pixels, flat live counts, 0 rejected destroys");
+  check(dev->last_frame_stats().rejected == 0, "5. no rejected call in the last frame");
+  // 6. (REF4 r2, C1) The lost handler: a pipeline whose WGSL does not compile passes the shared checks (rhi does not parse
+  //    WGSL) and fails inside Dawn as an uncaptured validation error; that first error reaches the handler exactly once,
+  //    with a readable reason.
+  {
+    int calls = 0;
+    std::string why;
+    dev->set_lost_handler([&](const std::string& r) {
+      ++calls;
+      why = r;
+    });
+    MeshPipelineDesc bad = pd;
+    bad.wgsl = "this is not WGSL";
+    const PipelineId bp = dev->create_mesh_pipeline(bad);
+    const TextureId t6 = dev->create_render_target_ex(RenderTargetDesc{8, 8, true, 1.0f});
+    const TextureId tx = dev->create_texture(1, 1, 1);
+    const BindGroupId g6 = dev->create_bind_group({ub, 16, tx, samp});
+    dev->begin_frame(t6, clear);
+    dev->draw_indexed({bp, vb, ib, 0, 6, g6, 0});
+    dev->end_frame();
+    dev->draw_indexed({bp, vb, ib, 0, 6, g6, 0});  // outside a frame: a counted rejection, not a second GPU error
+    std::vector<uint8_t> px6;
+    dev->read_pixels(t6, px6);  // waits for the queue: any asynchronous error has been reported by now
+    std::printf("     lost handler: %d call(s): %s\n", calls, why.c_str());
+    check(calls == 1 && why.rfind("GPU error (validation)", 0) == 0, "6. the first uncaptured GPU error reaches the lost handler once");
+  }
+  std::printf("adapter=%s\n", dev->adapter().c_str());
+  return ok ? 0 : 1;
+}
diff -ruN base/engine/tests/test_prefetch_fs.cpp ref/engine/tests/test_prefetch_fs.cpp
--- base/engine/tests/test_prefetch_fs.cpp	1970-01-01 01:00:00
+++ ref/engine/tests/test_prefetch_fs.cpp	2026-10-07 15:45:43
@@ -0,0 +1,224 @@
+// M1b: PrefetchFileSystem (the browser's file system) and the read-driven prefetch ("discovery"). Runs natively and
+// as wasm32 under Node.
+#include <cstring>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "doctest.h"
+#include "lomn/fs.h"
+#include "lomn/prefetch_fs.h"
+#include "lomn/view/area.h"
+#include "lomn/view/prefetch.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn;
+using fs::ByteRange;
+using fs::Error;
+using fs::PrefetchFileSystem;
+
+namespace {
+
+// Makes [off, off+len) of `path` resident with bytes value(i) = (off + i) & 0xff.
+bool fill(PrefetchFileSystem& p, const char* path, uint64_t off, uint64_t len) {
+  uint8_t* dst = p.reserve(path, off, len);
+  if (!dst) return false;
+  for (uint64_t i = 0; i < len; ++i) dst[i] = static_cast<uint8_t>((off + i) & 0xff);
+  return p.commit(dst);
+}
+
+// The browser's loop, natively: a round runs `load`; its misses are copied from `src` (the player's files) into the
+// prefetch fs; repeat until a round has no miss. Returns the number of rounds (0 = gave up after `max_rounds`).
+template <typename Load>
+int discover(PrefetchFileSystem& p, const fs::FileSystem& src, Load load, int max_rounds = 16) {
+  for (int round = 1; round <= max_rounds; ++round) {
+    p.next_generation();
+    load();
+    if (p.misses().empty() && p.misses_dropped() == 0) return round;
+    for (const ByteRange& m : std::vector<ByteRange>(p.misses())) {
+      std::vector<uint8_t> bytes;
+      if (src.read_range(m.path, m.offset, m.length, bytes) != Error::None) return 0;
+      uint8_t* dst = p.reserve(m.path, m.offset, m.length);
+      if (!dst) return 0;
+      std::memcpy(dst, bytes.data(), bytes.size());
+      p.commit(dst);
+    }
+  }
+  return 0;
+}
+
+// Registers every file of a MemoryFileSystem holding the synthetic install in the prefetch index.
+void index_synthetic(PrefetchFileSystem& p, const fs::MemoryFileSystem& m) {
+  for (const char* f : {"Root/Data/Levels/levt/levt.blk", "Root/Data/Levels/levt/test.blk", "Root/Data/Levels/levt/stat.blk",
+                        "Root/Data/Base.osi"}) {
+    uint64_t size = 0;
+    REQUIRE(m.size(f, size) == Error::None);
+    REQUIRE(p.add_file(f, size));
+  }
+}
+
+}  // namespace
+
+TEST_CASE("prefetch fs: the index answers exists/size without resident bytes; bad registrations are rejected") {
+  PrefetchFileSystem p;
+  std::string err;
+  CHECK(p.add_file("Root\\Data\\Main.BLK", 100, &err));
+  CHECK_FALSE(p.add_file("root/data/main.blk", 5, &err));  // duplicate after normalisation
+  CHECK(err.find("duplicate") != std::string::npos);
+  CHECK_FALSE(p.add_file("User/save0.sav", 5, &err));      // only root/ is indexed
+  CHECK_FALSE(p.add_file("Root", 5, &err));
+  CHECK_FALSE(p.add_file("Root/x", (1ull << 53), &err));    // beyond a JS safe integer
+  CHECK_FALSE(p.add_file(std::string(PrefetchFileSystem::kMaxPathBytes + 1, 'a'), 1, &err));
+  CHECK(p.file_count() == 1);
+  CHECK(p.exists("ROOT/data/main.blk"));
+  uint64_t sz = 0;
+  CHECK(p.size("root/data/main.blk", sz) == Error::None);
+  CHECK(sz == 100);
+  CHECK(p.size("root/data/nope", sz) == Error::NotFound);
+  CHECK(p.size("elsewhere/x", sz) == Error::BadMount);
+}
+
+TEST_CASE("prefetch fs: reads are served only from ONE resident range that contains them; others are recorded misses") {
+  PrefetchFileSystem p;
+  REQUIRE(p.add_file("root/a.bin", 1000));
+  REQUIRE(fill(p, "root/a.bin", 100, 50));
+  REQUIRE(fill(p, "root/a.bin", 150, 50));
+  std::vector<uint8_t> out;
+  CHECK(p.read_range("root/a.bin", 110, 20, out) == Error::None);
+  CHECK(out.size() == 20);
+  CHECK(out[0] == 110);
+  CHECK(p.read_range("root/a.bin", 140, 20, out) == Error::Io);   // spans two ranges: a miss (fetched as one range)
+  CHECK(p.read_range("root/a.bin", 0, 10, out) == Error::Io);     // not resident
+  CHECK(p.read_range("root/a.bin", 0, 10, out) == Error::Io);     // the same miss again: stored once
+  CHECK(p.read("root/a.bin", out) == Error::Io);                  // whole file = [0, 1000)
+  CHECK(p.read_range("root/a.bin", 990, 20, out) == Error::Io);   // outside the file: an error, NOT a miss
+  CHECK(p.read_range("root/a.bin", 1000, 0, out) == Error::None); // empty read at the end: nothing to fetch
+  CHECK(p.read_range("root/missing", 0, 1, out) == Error::NotFound);
+  REQUIRE(p.misses().size() == 3);
+  CHECK(p.misses()[0] == ByteRange{"root/a.bin", 140, 20});
+  CHECK(p.misses()[1] == ByteRange{"root/a.bin", 0, 10});
+  CHECK(p.misses()[2] == ByteRange{"root/a.bin", 0, 1000});
+  CHECK(p.misses_total() == 4);
+  // reserve refuses what cannot or need not be fetched.
+  std::string err;
+  CHECK(p.reserve("root/a.bin", 110, 10, &err) == nullptr);
+  CHECK(err.find("already resident") != std::string::npos);
+  CHECK(p.reserve("root/a.bin", 990, 20, &err) == nullptr);
+  CHECK(p.reserve("root/a.bin", 0, 0, &err) == nullptr);
+  CHECK(p.reserve("root/zzz", 0, 1, &err) == nullptr);
+  CHECK(p.reserve("root/a.bin", 0, PrefetchFileSystem::kMaxRangeBytes + 1, &err) == nullptr);
+  // A pending reservation is not readable until committed; abort frees it.
+  uint8_t* h = p.reserve("root/a.bin", 0, 10, &err);
+  REQUIRE(h);
+  CHECK(p.read_range("root/a.bin", 0, 10, out) == Error::Io);
+  CHECK(p.pending_bytes() == 10);
+  CHECK(p.abort(h));
+  CHECK_FALSE(p.commit(h));
+  CHECK(p.pending_bytes() == 0);
+  CHECK(p.resident_bytes() == 100);
+}
+
+TEST_CASE("prefetch fs: byte budget, miss cap, user/ writes, root/ is read-only") {
+  PrefetchFileSystem p(64);
+  REQUIRE(p.add_file("root/a.bin", 100000));
+  std::string err;
+  CHECK(fill(p, "root/a.bin", 0, 60));
+  CHECK(p.reserve("root/a.bin", 100, 5, &err) == nullptr);
+  CHECK(err.find("budget") != std::string::npos);
+  CHECK(p.peak_bytes() == 60);
+  std::vector<uint8_t> out;
+  for (uint32_t i = 0; i < PrefetchFileSystem::kMaxMissesPerGeneration + 10; ++i) p.read_range("root/a.bin", 100 + i, 1, out);
+  CHECK(p.misses().size() == PrefetchFileSystem::kMaxMissesPerGeneration);
+  CHECK(p.misses_dropped() == 10);
+  p.next_generation();
+  CHECK(p.misses().empty());
+  CHECK(p.misses_dropped() == 0);
+  const uint8_t b[3] = {1, 2, 3};
+  CHECK(p.write("root/a.bin", b, 3) == Error::ReadOnly);
+  CHECK(p.write("User/s.sav", b, 3) == Error::None);
+  CHECK(p.read("user/s.sav", out) == Error::None);
+  CHECK(out.size() == 3);
+  CHECK(p.write("x/../../y", b, 3) == Error::BadMount);
+}
+
+TEST_CASE("prefetch fs: generations - release_untouched keeps pinned and touched ranges (shared files), frees the rest") {
+  PrefetchFileSystem p;
+  REQUIRE(p.add_file("root/boot.osi", 100));
+  REQUIRE(p.add_file("root/a.blk", 1000));
+  std::vector<uint8_t> out;
+  REQUIRE(fill(p, "root/boot.osi", 0, 100));
+  p.next_generation();
+  REQUIRE(p.read("root/boot.osi", out) == Error::None);
+  CHECK(p.pin_touched() == 1);
+  // "Area 1" reads [0,10) and [500,100).
+  REQUIRE(fill(p, "root/a.blk", 0, 10));
+  REQUIRE(fill(p, "root/a.blk", 500, 100));
+  p.next_generation();
+  REQUIRE(p.read_range("root/a.blk", 0, 10, out) == Error::None);
+  REQUIRE(p.read_range("root/a.blk", 500, 100, out) == Error::None);
+  CHECK(p.release_untouched() == 0);
+  // "Area 2" shares [0,10) and reads [700,50); [500,100) is area 1's only.
+  REQUIRE(fill(p, "root/a.blk", 700, 50));
+  p.next_generation();
+  REQUIRE(p.read_range("root/a.blk", 0, 10, out) == Error::None);
+  REQUIRE(p.read_range("root/a.blk", 700, 50, out) == Error::None);
+  CHECK(p.touched() == std::vector<ByteRange>{{"root/a.blk", 0, 10}, {"root/a.blk", 700, 50}});
+  CHECK(p.release_untouched() == 100);
+  CHECK(p.is_resident("root/boot.osi", 0, 100));  // pinned (boot), although not touched in this generation
+  CHECK(p.is_resident("root/a.blk", 0, 10));      // shared
+  CHECK_FALSE(p.is_resident("root/a.blk", 500, 100));
+  CHECK(p.resident_bytes() == 160);
+  CHECK(p.pinned_bytes() == 100);
+  CHECK(p.resident_ranges() == 3);
+}
+
+TEST_CASE("prefetch discovery: the synthetic areas load from misses alone, equal to the direct load and the access log") {
+  fs::MemoryFileSystem m;
+  REQUIRE(view::mount_synthetic_install(m));
+  PrefetchFileSystem p;
+  index_synthetic(p, m);
+  // Boot: no Art.blk in the synthetic install (size() fails: no miss), Base.osi whole.
+  const int boot_rounds = discover(p, m, [&] { view::boot_reads(p); });
+  CHECK(boot_rounds == 2);
+  CHECK(p.pin_touched() == 1);
+  uint64_t osi = 0;
+  REQUIRE(m.size("Root/Data/Base.osi", osi) == Error::None);
+  CHECK(p.pinned_bytes() == osi);
+  for (const char* name : {view::kSyntheticArea, view::kSyntheticStateArea, view::kSyntheticArea}) {
+    CAPTURE(name);
+    view::AreaData via_prefetch, direct;
+    std::string err;
+    bool ok = false;
+    const int rounds = discover(p, m, [&] { ok = view::load_area(p, view::kSyntheticLevel, name, view::AreaOptions(), via_prefetch, &err); });
+    CHECK(rounds >= 2);
+    CHECK(rounds <= 8);
+    REQUIRE(ok);
+    // The last round's touched ranges == the access log of the same load on the source file system (the native
+    // `lomn_view --manifest` rows), so the browser fetches exactly what the native engine reads.
+    const std::vector<ByteRange> log = view::record_reads(m, [&] { ok = view::load_area(m, view::kSyntheticLevel, name, view::AreaOptions(), direct, &err); });
+    REQUIRE(ok);
+    CHECK(p.touched() == log);
+    CHECK(via_prefetch.stats.draws == direct.stats.draws);
+    CHECK(via_prefetch.stats.textures == direct.stats.textures);
+    CHECK(via_prefetch.stats.texture_bytes == direct.stats.texture_bytes);
+    CHECK(via_prefetch.placements.size() == direct.placements.size());
+    CHECK(via_prefetch.warnings == direct.warnings);
+    CHECK(via_prefetch.fog.source == direct.fog.source);
+    p.release_untouched();
+    for (const ByteRange& r : log) CHECK(p.is_resident(r.path, r.offset, r.length));
+    uint64_t bytes = 0;
+    for (const ByteRange& r : log) bytes += r.length;
+    // Everything resident is either pinned (Base.osi, also in the log) or this area's set.
+    CHECK(p.resident_bytes() == bytes);
+  }
+}
+
+TEST_CASE("list_areas: levels/<lev>/<area>.blk, the level blockfile excluded") {
+  const std::vector<std::string> paths = {"root/data/levels/lev1/lev1.blk", "root/data/levels/lev1/vllg.blk", "root/data/levels/lev1/textures/x.dds",
+                                          "root/data/levels/lev10/abcd.blk", "root/data/levels/lev1/toolong.blk", "root/data/main.blk",
+                                          "root/data/levels/x.blk"};
+  const std::vector<view::AreaRef> a = view::list_areas(paths);
+  REQUIRE(a.size() == 1);
+  CHECK(a[0] == view::AreaRef{"lev1", "vllg"});
+  CHECK(view::ranges_text({{"root/a", 1, 2}, {"root/b", 0, 10}}) == "root/a\t1\t2\nroot/b\t0\t10\n");
+}
diff -ruN base/engine/tests/test_rhi_destroy.cpp ref/engine/tests/test_rhi_destroy.cpp
--- base/engine/tests/test_rhi_destroy.cpp	1970-01-01 01:00:00
+++ ref/engine/tests/test_rhi_destroy.cpp	2026-10-07 17:15:51
@@ -0,0 +1,231 @@
+// M1b rhi additions on the null backend: destroy_* (dependency rule: a referenced object is rejected, never cascaded),
+// live_objects(), the surface calls on a headless device, and AreaRenderer::release (area switching without leaks).
+// The log lines are exact: this suite runs natively AND as wasm32 under Node, so both produce the same text.
+#include <string>
+#include <vector>
+
+#include "doctest.h"
+#include "lomn/fs.h"
+#include "lomn/rhi.h"
+#include "lomn/view/area.h"
+#include "lomn/view/synthetic.h"
+
+using namespace lomn;
+using namespace lomn::rhi;
+
+namespace {
+
+MeshPipelineDesc mesh_desc() {
+  MeshPipelineDesc d;
+  d.wgsl = "w";
+  d.uniform_bytes = 96;
+  d.vertex_stride = 36;
+  d.attributes = {{VertexFormat::Float32x3, 0, 0}, {VertexFormat::Float32x2, 12, 1}, {VertexFormat::Float32x4, 20, 2}};
+  return d;
+}
+
+Device::LiveObjects counts(uint32_t t, uint32_t b, uint32_t p, uint32_t s, uint32_t g) {
+  Device::LiveObjects o;
+  o.textures = t;
+  o.buffers = b;
+  o.pipelines = p;
+  o.samplers = s;
+  o.bind_groups = g;
+  return o;
+}
+
+// Forwards to a null device but rejects the n-th create_index_buffer: makes AreaRenderer::upload fail half-way.
+class FailingDevice final : public Device {
+ public:
+  FailingDevice(std::unique_ptr<Device> d, int fail_index_buffer_at) : d_(std::move(d)), fail_at_(fail_index_buffer_at) {}
+  std::string backend() const override { return d_->backend(); }
+  std::string adapter() const override { return d_->adapter(); }
+  TextureId create_render_target(uint32_t w, uint32_t h) override { return d_->create_render_target(w, h); }
+  BufferId create_uniform_buffer(uint32_t b) override { return d_->create_uniform_buffer(b); }
+  void write_buffer(BufferId b, uint32_t o, const void* p, uint32_t n) override { d_->write_buffer(b, o, p, n); }
+  PipelineId create_pipeline(const PipelineDesc& x) override { return d_->create_pipeline(x); }
+  void begin_frame(TextureId t, const float c[4]) override { d_->begin_frame(t, c); }
+  void draw(PipelineId p, uint32_t n, BufferId u, uint32_t o) override { d_->draw(p, n, u, o); }
+  void end_frame() override { d_->end_frame(); }
+  bool read_pixels(TextureId t, std::vector<uint8_t>& v) override { return d_->read_pixels(t, v); }
+  FrameStats last_frame_stats() const override { return d_->last_frame_stats(); }
+  TextureId create_render_target_ex(const RenderTargetDesc& x) override { return d_->create_render_target_ex(x); }
+  BufferId create_vertex_buffer(uint32_t n) override { return d_->create_vertex_buffer(n); }
+  BufferId create_index_buffer(uint32_t n) override { return ++ib_ == fail_at_ ? 0 : d_->create_index_buffer(n); }
+  TextureId create_texture(uint32_t w, uint32_t h, uint32_t m) override { return d_->create_texture(w, h, m); }
+  bool write_texture(TextureId t, uint32_t m, const void* p, std::size_t n) override { return d_->write_texture(t, m, p, n); }
+  SamplerId create_sampler(const SamplerDesc& x) override { return d_->create_sampler(x); }
+  PipelineId create_mesh_pipeline(const MeshPipelineDesc& x) override { return d_->create_mesh_pipeline(x); }
+  BindGroupId create_bind_group(const BindGroupDesc& x) override { return d_->create_bind_group(x); }
+  void draw_indexed(const DrawIndexedDesc& x) override { d_->draw_indexed(x); }
+  bool destroy_texture(TextureId t) override { return d_->destroy_texture(t); }
+  bool destroy_buffer(BufferId b) override { return d_->destroy_buffer(b); }
+  bool destroy_pipeline(PipelineId p) override { return d_->destroy_pipeline(p); }
+  bool destroy_sampler(SamplerId s) override { return d_->destroy_sampler(s); }
+  bool destroy_bind_group(BindGroupId g) override { return d_->destroy_bind_group(g); }
+  LiveObjects live_objects() const override { return d_->live_objects(); }
+
+ private:
+  std::unique_ptr<Device> d_;
+  int fail_at_, ib_ = 0;
+};
+
+}  // namespace
+
+TEST_CASE("rhi destroy: a referenced texture/sampler/uniform buffer is rejected, never cascaded; ids are not reused") {
+  std::vector<std::string> log;
+  auto d = create_null_device(&log);
+  const BufferId ub = d->create_uniform_buffer(512);
+  const TextureId tex = d->create_texture(2, 2, 1);
+  const SamplerId s = d->create_sampler(SamplerDesc());
+  const PipelineId p = d->create_mesh_pipeline(mesh_desc());
+  const BindGroupId bg = d->create_bind_group({ub, 96, tex, s});
+  REQUIRE(bg == 1);
+  CHECK(d->live_objects() == counts(1, 1, 1, 1, 1));
+  log.clear();
+  CHECK_FALSE(d->destroy_texture(tex));
+  CHECK_FALSE(d->destroy_sampler(s));
+  CHECK_FALSE(d->destroy_buffer(ub));
+  CHECK(d->last_frame_stats().rejected == 3);
+  CHECK(d->live_objects() == counts(1, 1, 1, 1, 1));  // nothing freed by a rejected destroy
+  CHECK(d->destroy_pipeline(p));                       // pipelines are referenced by no rhi object
+  CHECK(d->destroy_bind_group(bg));
+  CHECK(d->destroy_texture(tex));
+  CHECK(d->destroy_sampler(s));
+  CHECK(d->destroy_buffer(ub));
+  CHECK_FALSE(d->destroy_buffer(ub));  // already destroyed
+  CHECK_FALSE(d->destroy_texture(0));  // 0 = the presentation surface: not a destroyable texture
+  CHECK(d->live_objects() == counts(0, 0, 0, 0, 0));
+  const std::vector<std::string> want = {
+      "destroy_texture 1 rejected: in use by bind group 1",
+      "destroy_sampler 1 rejected: in use by bind group 1",
+      "destroy_buffer 1 rejected: in use by bind group 1",
+      "destroy_pipeline 1",
+      "destroy_bind_group 1",
+      "destroy_texture 1",
+      "destroy_sampler 1",
+      "destroy_buffer 1",
+      "destroy_buffer 1 rejected: unknown buffer",
+      "destroy_texture 0 rejected: unknown texture",
+  };
+  CHECK(log == want);
+  // Ids continue: never reused after a destroy.
+  CHECK(d->create_texture(2, 2, 1) == 2);
+  CHECK(d->create_uniform_buffer(256) == 2);
+  CHECK(d->create_bind_group({1, 96, 2, 1}) == 0);  // the destroyed buffer/sampler ids are unknown now
+}
+
+TEST_CASE("rhi destroy: draws naming a destroyed object are rejected; a render target with depth is destroyable") {
+  std::vector<std::string> log;
+  auto d = create_null_device(&log);
+  const TextureId rt = d->create_render_target_ex(RenderTargetDesc{16, 16, true, 1.0f});
+  const BufferId ub = d->create_uniform_buffer(512), vb = d->create_vertex_buffer(144), ib = d->create_index_buffer(24);
+  const TextureId tex = d->create_texture(2, 2, 1);
+  const SamplerId s = d->create_sampler(SamplerDesc());
+  const PipelineId p = d->create_mesh_pipeline(mesh_desc());
+  const BindGroupId bg = d->create_bind_group({ub, 96, tex, s});
+  const float c[4] = {0, 0, 0, 1};
+  d->begin_frame(rt, c);
+  d->draw_indexed({p, vb, ib, 0, 6, bg, 0});
+  CHECK(d->destroy_pipeline(p));  // allowed inside a frame: the recorded draw keeps it (WebGPU refcounting)
+  d->draw_indexed({p, vb, ib, 0, 6, bg, 0});
+  d->end_frame();
+  CHECK(d->last_frame_stats().draws == 1);
+  CHECK(d->last_frame_stats().rejected == 1);
+  CHECK(log[log.size() - 2] == "draw_indexed pipeline=1 vb=2 ib=3 first=0 count=6 bind_group=1+0 rejected: unknown mesh pipeline");
+  CHECK(d->destroy_texture(rt));
+  log.clear();
+  d->begin_frame(rt, c);
+  d->end_frame();
+  CHECK(log.front() == "begin_frame target=1 clear=0.000,0.000,0.000,1.000 rejected: unknown render target");
+}
+
+TEST_CASE("rhi surface: set_surface_depth and resize are counted rejections on a device without a surface") {
+  std::vector<std::string> log;
+  auto d = create_null_device(&log);
+  CHECK_FALSE(d->set_surface_depth(true, 1.0f));
+  CHECK_FALSE(d->resize(640, 480));
+  CHECK(d->last_frame_stats().rejected == 2);
+  CHECK(log == std::vector<std::string>{"set_surface_depth 1 clear_depth=1.000 rejected: no presentation surface (headless device)",
+                                        "resize 640x480 rejected: no presentation surface (headless device)"});
+}
+
+TEST_CASE("rhi lost handler (REF4 r2): the null device logs the call and never invokes the handler") {
+  std::vector<std::string> log;
+  auto d = create_null_device(&log);
+  int calls = 0;
+  d->set_lost_handler([&](const std::string&) { ++calls; });
+  d->set_lost_handler(nullptr);
+  CHECK(log == std::vector<std::string>{"set_lost_handler set", "set_lost_handler cleared"});
+  CHECK(calls == 0);
+  CHECK(d->last_frame_stats().rejected == 0);
+}
+
+TEST_CASE("AreaRenderer::release: N upload/render/release cycles keep live objects flat; bind groups go first") {
+  fs::MemoryFileSystem mfs;
+  REQUIRE(view::mount_synthetic_install(mfs));
+  std::vector<std::string> log;
+  auto d = create_null_device(&log);
+  const TextureId rt = d->create_render_target_ex(RenderTargetDesc{64, 64, true, 1.0f});
+  const Device::LiveObjects base = d->live_objects();
+  CHECK(base == counts(1, 0, 0, 0, 0));
+  view::AreaRenderer r;
+  Device::LiveObjects shown[2];
+  for (int cycle = 0; cycle < 6; ++cycle) {
+    const char* name = cycle % 2 ? view::kSyntheticStateArea : view::kSyntheticArea;  // alternate two areas
+    view::AreaData a;
+    std::string err;
+    REQUIRE(view::load_area(mfs, view::kSyntheticLevel, name, view::AreaOptions(), a, &err));
+    REQUIRE(r.upload(*d, a, view::RenderOptions(), &err));
+    REQUIRE(r.render(*d, rt, a, view::make_camera(a, view::synthetic_camera(), 1.0f)));
+    REQUIRE(r.render(*d, rt, a, view::make_camera(a, view::synthetic_camera(), 1.0f)));
+    CHECK(d->last_frame_stats().rejected == 0);
+    const Device::LiveObjects live = d->live_objects();
+    if (cycle < 2) shown[cycle] = live;
+    else CHECK(live == shown[cycle % 2]);  // the same area always holds the same number of objects
+    log.clear();
+    uint32_t failures = 7;
+    const uint32_t n = r.release(*d, &failures);
+    CHECK(failures == 0);
+    CHECK(n == live.textures + live.buffers + live.pipelines + live.samplers + live.bind_groups - base.textures);
+    CHECK(d->live_objects() == base);
+    // Dependency order: every destroy_bind_group line comes before any texture/sampler/buffer destroy.
+    size_t last_group = 0, first_other = log.size();
+    for (size_t i = 0; i < log.size(); ++i) {
+      if (log[i].rfind("destroy_bind_group", 0) == 0) last_group = i;
+      else if (first_other == log.size() && log[i].rfind("destroy_pipeline", 0) != 0) first_other = i;
+    }
+    CHECK(last_group < first_other);
+    for (const std::string& l : log) CHECK(l.find("rejected") == std::string::npos);
+  }
+  CHECK(shown[0].bind_groups > 0);
+  CHECK(shown[1].pipelines > 0);
+}
+
+TEST_CASE("AreaRenderer::release: upload twice needs a release in between; a failed upload releases what it created") {
+  fs::MemoryFileSystem mfs;
+  REQUIRE(view::mount_synthetic_install(mfs));
+  view::AreaData a;
+  std::string err;
+  REQUIRE(view::load_area(mfs, view::kSyntheticLevel, view::kSyntheticArea, view::AreaOptions(), a, &err));
+  {
+    auto d = create_null_device(nullptr);
+    view::AreaRenderer r;
+    REQUIRE(r.upload(*d, a, view::RenderOptions(), &err));
+    CHECK_FALSE(r.upload(*d, a, view::RenderOptions(), &err));
+    CHECK(err.find("release") != std::string::npos);
+    r.release(*d);
+    CHECK(d->live_objects() == counts(0, 0, 0, 0, 0));
+    CHECK(r.upload(*d, a, view::RenderOptions(), &err));
+  }
+  {
+    FailingDevice d(create_null_device(nullptr), 2);  // the second model's index buffer is rejected
+    view::AreaRenderer r;
+    CHECK_FALSE(r.upload(d, a, view::RenderOptions(), &err));
+    CHECK(d.live_objects().textures > 0);  // white + the area's textures + the first model's buffers exist
+    uint32_t failures = 9;
+    r.release(d, &failures);
+    CHECK(failures == 0);
+    CHECK(d.live_objects() == counts(0, 0, 0, 0, 0));
+  }
+}
