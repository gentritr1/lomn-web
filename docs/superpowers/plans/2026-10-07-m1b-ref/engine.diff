+#endif
+  return keep(std::string("{\"type\":") + js(LOMN_BUILD_TYPE) + ",\"cxx_flags\":" + js(LOMN_BUILD_FLAGS) + ",\"emscripten\":\"" +
+              std::to_string(__EMSCRIPTEN_MAJOR__) + "." + std::to_string(__EMSCRIPTEN_MINOR__) + "." + std::to_string(__EMSCRIPTEN_TINY__) +
