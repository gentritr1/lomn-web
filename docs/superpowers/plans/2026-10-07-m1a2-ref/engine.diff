diff -ruN base/engine/include/lomn/view/math.h work/engine/include/lomn/view/math.h
--- base/engine/include/lomn/view/math.h	1970-01-01 01:00:00
+++ work/engine/include/lomn/view/math.h	2026-10-07 08:01:18
@@ -0,0 +1,36 @@
+// 4x4 matrices in the game's convention (D3D8 / D3DX): row-major storage m[row*4 + col], ROW vectors (v' = v * M),
+// translation in _41.._43 (m[12..14]); a product a*b applies a first. Uploaded unchanged to WGSL, the same 16 floats
+// read as a column-major mat4x4f, so `M * v` in WGSL equals the D3D `v * M` (no transpose anywhere).
+//
+// Determinism (native == wasm32 call logs): trig and sqrt are evaluated in double through <cmath> and rounded once to
+// float; every other step is plain float arithmetic with -ffp-contract=off (inherited from lomn_core). D3DX itself
+// computes in float, so the last bit may differ from the original; bit-faithful D3DX helpers are a later item
+// (parent spec §4: "validated against recorded outputs").
+#pragma once
+#include <cstdint>
+
+namespace lomn::view {
+
+struct Mat4 {
+  float m[16] = {};
+};
+
+Mat4 mat_identity();
+Mat4 mat_mul(const Mat4& a, const Mat4& b);
+// D3DUtil_SetRotateXMatrix: _22 = cos, _23 = sin, _32 = -sin, _33 = cos. With the game's -1.5707982 this maps a
+// model-space (x, y, z) to (x, z, -y) up to ~2e-6: the .x files are Z-up, the world is Y-up.
+Mat4 mat_rotation_x(float radians);
+Mat4 mat_translation(float x, float y, float z);
+// D3DXMatrixPerspectiveFovRH(fovy, aspect, zn, zf), documented form:
+//   yScale = cot(fovy/2), xScale = yScale / aspect
+//   [xScale 0 0 0; 0 yScale 0 0; 0 0 zf/(zn-zf) -1; 0 0 zn*zf/(zn-zf) 0]
+// A view-space point at z = -zn gets z_ndc = 0 and at z = -zf gets z_ndc = 1: D3D's [0,1] depth range, which is also
+// WebGPU's, so the matrix is used unchanged (no [-1,1] remap as for OpenGL).
+Mat4 perspective_fov_rh(float fovy_radians, float aspect, float zn, float zf);
+// D3DXMatrixLookAtRH: z = normalize(eye - at), x = normalize(cross(up, z)), y = cross(z, x);
+//   [x.x y.x z.x 0; x.y y.y z.y 0; x.z y.z z.z 0; -dot(x,eye) -dot(y,eye) -dot(z,eye) 1]
+Mat4 look_at_rh(const float eye[3], const float at[3], const float up[3]);
+// out = (p, 1) * M (homogeneous, 4 floats).
+void transform_point(const Mat4& m, const float p[3], float out[4]);
+
+}  // namespace lomn::view
diff -ruN base/engine/include/lomn/view/mips.h work/engine/include/lomn/view/mips.h
--- base/engine/include/lomn/view/mips.h	1970-01-01 01:00:00
+++ work/engine/include/lomn/view/mips.h	2026-10-07 08:00:00
@@ -0,0 +1,34 @@
+// CPU box-filter mip chains for RGBA8 textures (spec M1 §5: RGBA8 upload + CPU mips; the game's DDS files store mip
+// count 0 and D3DX built the chain at load, with its default BOX mip filter).
+//
+// Level n+1 has size max(1, w/2) x max(1, h/2) (floor), down to 1x1: floor(log2(max(w, h))) + 1 levels, the same
+// chain length D3D/WebGPU use. Each destination texel is the exact area-weighted average of the source texels its
+// footprint covers: per axis, destination texel x covers source interval [x*W/w, (x+1)*W/w), and a source texel's
+// weight is its overlap with that interval. For an even size this is the classic 2-tap average; for an odd size
+// (e.g. 5 -> 2) the middle texel is split between both destination texels, so no source texel is dropped
+// (non-power-of-two safe); a 1-texel axis stays 1 and is copied. The result is round-half-up of the weighted sum
+// divided by W*H in exact integer (u64) arithmetic, per channel, on straight (non-premultiplied) alpha like D3DX.
+#pragma once
+#include <cstdint>
+#include <vector>
+
+namespace lomn::view {
+
+struct MipLevel {
+  uint32_t width = 0, height = 0;
+  std::vector<uint8_t> rgba;  // width*height*4
+};
+
+// floor(log2(max(w, h))) + 1 (0 for an empty image).
+uint32_t mip_level_count(uint32_t width, uint32_t height);
+
+// One box-filter step. False (and dst untouched) if the sizes do not match rgba.size() or either side is 0.
+bool downsample_box(const std::vector<uint8_t>& src, uint32_t width, uint32_t height, MipLevel& dst);
+
+// The full chain; level 0 takes ownership of `rgba`. False if the size does not match or is 0.
+bool build_mip_chain(std::vector<uint8_t> rgba, uint32_t width, uint32_t height, std::vector<MipLevel>& out);
+
+// Bytes of the whole chain for a width x height RGBA8 texture.
+uint64_t mip_chain_bytes(uint32_t width, uint32_t height);
+
+}  // namespace lomn::view
