+sage_test::Bytes obj_records(uint32_t n, uint32_t flags) {
+  using namespace sage_test;
+  Bytes b;
+  put32(b, 0);
+  put32(b, n);
+  put32(b, n);
+  put32(b, 16);
+  for (uint32_t i = 0; i < n; ++i) {
+    putstr(b, "eulb");  // LE u32 of "blue"
+    for (int k = 0; k < 13; ++k) putf(b, 0.0f);
+    put32(b, flags);
+  }
+  put32(b, 12);
+  put32(b, 1);
+  put32(b, 0x00C0FFEEu);
+  return b;
+}
