+    m.indices = x.indices;
+    const uint64_t tris = x.indices.size() / 3;
+    for (const sage::XSubset& s : x.subsets) {  // bounded by parse_x (one per used material)
+      if (s.face_count == 0 || uint64_t(s.face_start) + s.face_count > tris) {
+        warn("model " + id + ": subset outside the index list");
+        return false;
+      }
+      SubsetDraw d;
+      d.first_index = s.face_start * 3;
+      d.index_count = s.face_count * 3;
+      // XMesh invariant: materials may be empty (then attrib_id is 0 and there is no material): default material.
+      const sage::XMaterial* mat = s.attrib_id < x.materials.size() ? &x.materials[s.attrib_id] : nullptr;
+      if (mat) std::memcpy(d.diffuse, mat->diffuse, sizeof d.diffuse);
+      if (mat && mat->has_texture) {
+        uint32_t t = kNoTexture;
+        if (!texture_for(mat->texture, t) && !fatal_.empty()) return false;
+        d.texture = t;
+        d.alpha = t != kNoTexture && out_.textures[t].alpha_on;
+      }
+      if (d.texture == kNoTexture) ++st.untextured_subsets;
+      if (d.alpha) ++st.alpha_subsets;
+      m.subsets.push_back(d);
+    }
+    st.subsets += static_cast<uint32_t>(m.subsets.size());
+    st.vertices += m.vertex_count;
+    st.triangles += static_cast<uint32_t>(tris);
+    if (!m.has_colors) ++st.models_without_colors;
+    return true;
+  }
+
+  // ScDrawableTexture::Load: resolve "<lev>/textures/<name>" (.dds then .tga), cached per area by resolved request.
+  bool texture_for(const std::string& name, uint32_t& index) {
+    AreaStats& st = out_.stats;
+    std::string chosen;
+    if (!sage::resolve_texture(chain_, out_.level, name, chosen)) {
+      ++st.textures_missing;
+      warn("texture " + name + ": not found");
+      return false;
+    }
+    const std::string key = lower(chosen);
+    auto it = texture_cache_.find(key);
+    if (it != texture_cache_.end()) {
+      if (it->second < 0) return false;
+      index = static_cast<uint32_t>(it->second);
+      return true;
+    }
+    texture_cache_[key] = -1;
+    if (out_.textures.size() >= kMaxAreaTextures) return fatal("area: more than kMaxAreaTextures textures");
+    std::string e;
+    std::vector<uint8_t> bytes;
+    if (!chain_.load(chosen, bytes, nullptr, &e)) {
+      ++st.textures_failed;
+      warn("texture " + name + ": " + e);
+      return false;
+    }
+    const auto t0 = Clock::now();
+    sage::Image img;
+    Texture tex;
+    tex.request = chosen;
+    bool ok = false;
+    if (ends_with(key, ".tga")) {
+      sage::TgaInfo ti;
+      ok = sage::decode_tga(bytes.data(), bytes.size(), img, &ti, &e);
+      if (ok) {
+        // Spec R8: a 32-bpp TGA declaring 0 alpha bits is X8R8G8B8 (opaque); INFERRED from D3DX, confirm in A8.
+        tex.alpha_on = ti.alpha_bits > 0;
+        tex.format = ti.bits == 24 ? "TGA24" : tex.alpha_on ? "TGA32a" : "TGA32";
+        if (!tex.alpha_on)
+          for (size_t i = 3; i < img.rgba.size(); i += 4) img.rgba[i] = 255;
+      }
+    } else {
+      sage::DdsInfo di;
+      ok = sage::decode_dds(bytes.data(), bytes.size(), img, &di, &e);
+      if (ok) {
+        tex.alpha_on = di.alpha_on;  // ScDrawableTexture mAlphaOn: DXT3 and A8R8G8B8 only
+        tex.format = sage::dds_format_name(di.format);
+      }
+    }
+    if (!ok) {
+      st.decode_ms += ms_since(t0);
+      ++st.textures_failed;
+      warn("texture " + name + ": " + e);
+      return false;
+    }
+    const uint64_t chain_bytes = mip_chain_bytes(img.width, img.height);
+    if (chain_bytes > kMaxAreaTextureBytes - std::min(kMaxAreaTextureBytes, st.texture_bytes)) {
+      st.decode_ms += ms_since(t0);
+      return fatal("area: textures over kMaxAreaTextureBytes");
+    }
+    if (!build_mip_chain(std::move(img.rgba), img.width, img.height, tex.mips)) {
+      st.decode_ms += ms_since(t0);
+      ++st.textures_failed;
+      warn("texture " + name + ": mip chain failed");
+      return false;
+    }
+    st.decode_ms += ms_since(t0);
+    st.texture_bytes += chain_bytes;
+    if (tex.alpha_on) ++st.textures_alpha;
+    texture_cache_[key] = static_cast<int64_t>(out_.textures.size());
+    index = static_cast<uint32_t>(out_.textures.size());
+    out_.textures.push_back(std::move(tex));
+    return true;
+  }
+
+  void grow_bounds(const Model& m, const Mat4& world) {
+    for (int c = 0; c < 8; ++c) {
+      const float p[3] = {(c & 1) ? m.bounds_max[0] : m.bounds_min[0], (c & 2) ? m.bounds_max[1] : m.bounds_min[1],
+                          (c & 4) ? m.bounds_max[2] : m.bounds_min[2]};
+      float w[4];
+      transform_point(world, p, w);
+      for (int k = 0; k < 3; ++k) {
+        if (!out_.has_bounds || w[k] < out_.bounds_min[k]) out_.bounds_min[k] = w[k];
+        if (!out_.has_bounds || w[k] > out_.bounds_max[k]) out_.bounds_max[k] = w[k];
+      }
+      out_.has_bounds = true;
+    }
+  }
+
+  sage::BlockChain chain_;
+  AreaData& out_;
+  std::string prefix_;
+  std::vector<uint8_t> bytes_;
+  std::map<std::string, int64_t> model_cache_, texture_cache_;  // ordered maps: deterministic, no pointer keys
+  std::vector<std::string> warnings_;
+  std::string fatal_;  // set when a cap is exceeded: the whole load fails
+};
+
+const char* kWgsl = R"(// lomn M1a-2 unlit area shader. Uniform block per draw (dynamic offset).
+struct U {
+  wvp: mat4x4f,     // world * view * proj, D3D row-vector matrix uploaded as-is (column-major read == transpose)
+  diffuse: vec4f,   // material diffuse, used when the vertex has no colour
+  params: vec4f,    // x: 1 = use vertex colour, y: alpha reference (0..1), alpha pass discards a <= y
+}
+@group(0) @binding(0) var<uniform> u: U;
+@group(0) @binding(1) var tex: texture_2d<f32>;
+@group(0) @binding(2) var samp: sampler;
+struct VOut {
+  @builtin(position) pos: vec4f,
+  @location(0) uv: vec2f,
+  @location(1) color: vec4f,
+}
+// @location(1) is the vertex normal: declared so the layout is visible here, unused until M1a-3 lighting.
+@vertex fn vs(@location(0) p: vec3f, @location(1) n: vec3f, @location(2) uv: vec2f, @location(3) c: vec4f) -> VOut {
+  var o: VOut;
+  o.pos = u.wvp * vec4f(p, 1.0);
+  o.uv = uv;
+  o.color = select(u.diffuse, c, u.params.x > 0.5);
+  return o;
+}
+// Stage 0: COLOROP MODULATE(TEXTURE, DIFFUSE) (D3D default). Alpha: DrawX (0x005528c0) sets ALPHAOP SELECTARG2
+// (stage state 4 = 3) with ALPHAARG2 = TEXTURE (6 = 2), i.e. alpha = texture alpha, as below.
+// Not modelled (M1a-3 gap): DrawX ~lines 295-298 turn ALPHABLEND OFF for the alpha pass when the flag at
+// *param_2 + 0xc is set (alpha test only); this preview always blends.
+fn shade(i: VOut) -> vec4f {
+  let t = textureSample(tex, samp, i.uv);
+  return vec4f(t.rgb * i.color.rgb, t.a);
+}
+@fragment fn fs_opaque(i: VOut) -> @location(0) vec4f {
+  return vec4f(shade(i).rgb, 1.0);
+}
+@fragment fn fs_alpha(i: VOut) -> @location(0) vec4f {
+  let c = shade(i);
+  if (c.a <= u.params.y) {
+    discard;
+  }
+  return c;
+}
+)";
+
+}  // namespace
+
+const char* area_wgsl() { return kWgsl; }
+
+bool load_area(const fs::FileSystem& fs, std::string_view level, std::string_view area, const AreaOptions& opt, AreaData& out,
+               std::string* err) {
+  out = AreaData();
+  AreaData tmp;
+  Loader l(fs, tmp);
+  if (err) err->clear();
+  if (!l.run(level, area, opt, err)) return false;  // no partial state on failure
+  out = std::move(tmp);
+  return true;
+}
+
+Camera make_camera(const AreaData& a, const CameraSettings& s, float aspect) {
+  Camera c;
+  c.fov_deg = s.fov_deg;
+  c.near_z = s.near_z;
+  c.far_z = s.far_z;
+  c.aspect = aspect;
+  float centre[3] = {0, 0, 0};
+  if (a.has_bounds)
+    for (int k = 0; k < 3; ++k) centre[k] = (a.bounds_min[k] + a.bounds_max[k]) * 0.5f;
+  if (s.eye_set) {
+    std::memcpy(c.eye, s.eye, sizeof c.eye);
+    c.eye_source = "cli";
+  } else if (a.has_start) {
+    c.eye[0] = a.start[0];
+    c.eye[1] = a.start[1] + s.eye_height;
+    c.eye[2] = a.start[2];
+    c.eye_source = "pos_start";
+  } else if (a.has_bounds) {
+    std::memcpy(c.eye, centre, sizeof c.eye);
+    c.eye[1] += s.eye_height;
+    c.eye_source = "bounds_centre";
+  } else {
+    c.eye_source = "origin";
+  }
+  constexpr double kDeg = 3.14159265358979323846 / 180.0;
+  float yaw = s.yaw_deg;
+  if (s.yaw_set) {
+    c.yaw_source = "cli";
+  } else {
+    const float dx = centre[0] - c.eye[0], dz = centre[2] - c.eye[2];
+    if (a.has_bounds && dx * dx + dz * dz > 1e-6f) {
+      yaw = static_cast<float>(std::atan2(static_cast<double>(dx), static_cast<double>(-dz)) / kDeg);
+      c.yaw_source = "towards_bounds_centre";
+    } else {
+      yaw = 0.0f;
+      c.yaw_source = "default";
+    }
+  }
+  c.yaw_deg = yaw;
+  c.pitch_deg = s.pitch_deg;
+  const double y = yaw * kDeg, p = s.pitch_deg * kDeg;
+  const float fwd[3] = {static_cast<float>(std::sin(y) * std::cos(p)), static_cast<float>(std::sin(p)),
+                        static_cast<float>(-std::cos(y) * std::cos(p))};
+  for (int k = 0; k < 3; ++k) c.at[k] = c.eye[k] + fwd[k];
+  const float up[3] = {0, 1, 0};
+  c.view = look_at_rh(c.eye, c.at, up);
+  c.proj = perspective_fov_rh(static_cast<float>(s.fov_deg * kDeg), aspect, s.near_z, s.far_z);
+  return c;
+}
+
+uint64_t release_cpu_copies(AreaData& a) {
+  uint64_t freed = 0;
+  for (Model& m : a.models) {
+    freed += m.vertices.capacity() * sizeof(float) + m.indices.capacity() * sizeof(uint32_t);
+    std::vector<float>().swap(m.vertices);
+    std::vector<uint32_t>().swap(m.indices);
+  }
+  for (Texture& t : a.textures) {
+    for (const MipLevel& l : t.mips) freed += l.rgba.capacity();
+    std::vector<MipLevel>().swap(t.mips);
+  }
+  a.cpu_released = true;
+  return freed;
+}
+
+namespace {
+constexpr uint32_t kSlot = rhi::uniform_stride(kAreaUniformBytes);  // one uniform slot per draw (256 bytes)
+}  // namespace
+
+bool AreaRenderer::upload(rhi::Device& dev, const AreaData& a, const RenderOptions& opt, std::string* err) {
+  if (a.cpu_released) return fail(err, "render: area CPU copies were already released");
+  opt_ = opt;
+  rhi::MeshPipelineDesc pd;
+  pd.wgsl = kWgsl;
+  pd.uniform_bytes = kAreaUniformBytes;
+  pd.vertex_stride = kVertexFloats * 4;
+  pd.attributes = {{rhi::VertexFormat::Float32x3, 0, 0},
+                   {rhi::VertexFormat::Float32x3, 12, 1},
+                   {rhi::VertexFormat::Float32x2, 24, 2},
+                   {rhi::VertexFormat::Float32x4, 32, 3}};
+  pd.cull = rhi::CullMode::None;               // render mode 0x11: D3DCULL_NONE
+  pd.depth_compare = rhi::CompareFunc::LessEqual;  // D3DRS_ZFUNC LESSEQUAL
+  pd.depth_write = true;                       // ZWRITE on in both DrawX passes
+  pd.fs_entry = "fs_opaque";
+  pd.blend = rhi::BlendMode::Opaque;
+  opaque_ = dev.create_mesh_pipeline(pd);
+  pd.fs_entry = "fs_alpha";
+  // DrawX pass 2: ALPHABLENDENABLE 1 (SRCALPHA/INVSRCALPHA from SrPushRenderMode), ALPHATESTENABLE 1, ALPHAFUNC GREATER.
+  pd.blend = rhi::BlendMode::AlphaBlend;
+  alpha_ = dev.create_mesh_pipeline(pd);
+  if (!opaque_ || !alpha_) return fail(err, "render: mesh pipeline rejected");
+  pipelines_created_ = 2;
+  // MAG/MIN ANISOTROPIC (max 3) and MIP LINEAR set globally; GcArea::Render forces MAGFILTER LINEAR; ADDRESS never set.
+  rhi::SamplerDesc sd;
+  sd.max_anisotropy = 3;
+  sampler_ = dev.create_sampler(sd);
+  if (!sampler_) return fail(err, "render: sampler rejected");
+  uniform_slots_ = a.stats.draws ? a.stats.draws : 1;
+  uniforms_ = dev.create_uniform_buffer(uniform_slots_ * kSlot);
+  if (!uniforms_) return fail(err, "render: uniform buffer rejected");
+  const uint8_t white[4] = {255, 255, 255, 255};
+  rhi::TextureId wt = dev.create_texture(1, 1, 1);
+  if (!wt || !dev.write_texture(wt, 0, white, 4)) return fail(err, "render: white texture rejected");
+  white_group_ = dev.create_bind_group({uniforms_, kAreaUniformBytes, wt, sampler_});
+  if (!white_group_) return fail(err, "render: bind group rejected");
+  textures_created_ = 1;
+  uploaded_texture_bytes_ = 4;
+  texture_groups_.clear();
+  for (const Texture& t : a.textures) {
+    const MipLevel& top = t.mips.front();
+    rhi::TextureId id = dev.create_texture(top.width, top.height, static_cast<uint32_t>(t.mips.size()));
+    if (!id) return fail(err, "render: texture rejected: " + t.request);
+    for (uint32_t m = 0; m < t.mips.size(); ++m) {
+      if (!dev.write_texture(id, m, t.mips[m].rgba.data(), t.mips[m].rgba.size())) return fail(err, "render: mip upload rejected: " + t.request);
+      uploaded_texture_bytes_ += t.mips[m].rgba.size();
+    }
+    ++textures_created_;
+    const rhi::BindGroupId bg = dev.create_bind_group({uniforms_, kAreaUniformBytes, id, sampler_});
+    if (!bg) return fail(err, "render: bind group rejected: " + t.request);
+    texture_groups_.push_back(bg);
+  }
+  models_.clear();
+  for (const Model& m : a.models) {
+    GpuModel g;
+    const uint32_t vbytes = static_cast<uint32_t>(m.vertices.size() * 4), ibytes = static_cast<uint32_t>(m.indices.size() * 4);
+    g.vb = dev.create_vertex_buffer(vbytes);
+    g.ib = dev.create_index_buffer(ibytes);
+    if (!g.vb || !g.ib) return fail(err, "render: buffer rejected for model " + m.id);
+    dev.write_buffer(g.vb, 0, m.vertices.data(), vbytes);
+    dev.write_buffer(g.ib, 0, m.indices.data(), ibytes);
+    models_.push_back(g);
+  }
+  uniform_data_.assign(size_t(uniform_slots_) * kSlot, 0);
+  return true;
+}
+
+void AreaRenderer::render(rhi::Device& dev, rhi::TextureId target, const AreaData& a, const Camera& cam) {
+  // Object order: route groups, record order inside a group; trans sorted far-to-near (GcTransDirector::SortIt; the
+  // direction is INFERRED). Distances in double so the order is identical on every platform for equal floats.
+  static const sage::Route kOrder[] = {sage::Route::Main, sage::Route::Moveable, sage::Route::NoLightMoveable, sage::Route::Back};
+  std::vector<uint32_t> objects;
+  for (sage::Route r : kOrder)
+    for (uint32_t i = 0; i < a.placements.size(); ++i)
+      if (a.placements[i].route == r) objects.push_back(i);
+  std::vector<std::pair<double, uint32_t>> trans;
+  for (uint32_t i = 0; i < a.placements.size(); ++i)
+    if (a.placements[i].route == sage::Route::Trans) {
+      double d = 0;
+      for (int k = 0; k < 3; ++k) {
+        const double v = double(a.placements[i].pos[k]) - cam.eye[k];
+        d += v * v;
+      }
+      trans.push_back({-d, i});
+    }
+  std::stable_sort(trans.begin(), trans.end(), [](const auto& x, const auto& y) { return x.first < y.first; });
+  for (const auto& t : trans) objects.push_back(t.second);
+
+  struct Item {
+    uint32_t placement, subset;
+  };
+  std::vector<Item> items;
+  for (uint32_t o : objects) {
+    const Model& m = a.models[a.placements[o].model];
+    for (int pass = 0; pass < 2; ++pass)
+      for (uint32_t s = 0; s < m.subsets.size(); ++s)
+        if (m.subsets[s].alpha == (pass == 1)) items.push_back({o, s});
+  }
+  const Mat4 vp = mat_mul(cam.view, cam.proj);
+  const uint32_t n = static_cast<uint32_t>(std::min<size_t>(items.size(), uniform_slots_));
+  for (uint32_t i = 0; i < n; ++i) {
+    const Placement& p = a.placements[items[i].placement];
+    const SubsetDraw& sd = a.models[p.model].subsets[items[i].subset];
+    float u[24];
+    const Mat4 wvp = mat_mul(p.world, vp);
+    std::memcpy(u, wvp.m, 64);
+    std::memcpy(u + 16, sd.diffuse, 16);
+    u[20] = opt_.vertex_colors && a.models[p.model].has_colors ? 1.0f : 0.0f;
+    u[21] = opt_.alpha_ref / 255.0f;
+    u[22] = 0.0f;
+    u[23] = 0.0f;
+    std::memcpy(&uniform_data_[size_t(i) * kSlot], u, sizeof u);
+  }
+  if (n) dev.write_buffer(uniforms_, 0, uniform_data_.data(), n * kSlot);
+  dev.begin_frame(target, opt_.clear);
+  for (uint32_t i = 0; i < n; ++i) {
+    const Placement& p = a.placements[items[i].placement];
+    const SubsetDraw& sd = a.models[p.model].subsets[items[i].subset];
+    rhi::DrawIndexedDesc d;
+    d.pipeline = sd.alpha ? alpha_ : opaque_;
+    d.vertices = models_[p.model].vb;
+    d.indices = models_[p.model].ib;
+    d.first_index = sd.first_index;
+    d.index_count = sd.index_count;
+    d.bind_group = sd.texture == kNoTexture ? white_group_ : texture_groups_[sd.texture];
+    d.uniform_offset = i * kSlot;
+    dev.draw_indexed(d);
+  }
+  dev.end_frame();
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/src/view/math.cpp work/engine/src/view/math.cpp
--- base/engine/src/view/math.cpp	1970-01-01 01:00:00
+++ work/engine/src/view/math.cpp	2026-10-07 08:54:40
@@ -0,0 +1,97 @@
+#include "lomn/view/math.h"
+
+#include <cmath>
+
+namespace lomn::view {
+
+Mat4 mat_identity() {
+  Mat4 r;
+  r.m[0] = r.m[5] = r.m[10] = r.m[15] = 1.0f;
+  return r;
+}
+
+Mat4 mat_mul(const Mat4& a, const Mat4& b) {
+  Mat4 r;
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) {
+      float s = 0.0f;
+      for (int k = 0; k < 4; ++k) s += a.m[i * 4 + k] * b.m[k * 4 + j];
+      r.m[i * 4 + j] = s;
+    }
+  return r;
+}
+
+Mat4 mat_rotation_x(float radians) {
+  const float c = static_cast<float>(std::cos(static_cast<double>(radians)));
+  const float s = static_cast<float>(std::sin(static_cast<double>(radians)));
+  Mat4 r = mat_identity();
+  r.m[5] = c;
+  r.m[6] = s;
+  r.m[9] = -s;
+  r.m[10] = c;
+  return r;
+}
+
+Mat4 mat_translation(float x, float y, float z) {
+  Mat4 r = mat_identity();
+  r.m[12] = x;
+  r.m[13] = y;
+  r.m[14] = z;
+  return r;
+}
+
+Mat4 perspective_fov_rh(float fovy, float aspect, float zn, float zf) {
+  const float ys = static_cast<float>(1.0 / std::tan(static_cast<double>(fovy) / 2.0));
+  const float xs = ys / aspect;
+  Mat4 r;
+  r.m[0] = xs;
+  r.m[5] = ys;
+  r.m[10] = zf / (zn - zf);
+  r.m[11] = -1.0f;
+  r.m[14] = zn * zf / (zn - zf);
+  return r;
+}
+
+namespace {
+void normalize3(float v[3]) {
+  const float len = static_cast<float>(std::sqrt(static_cast<double>(v[0] * v[0] + v[1] * v[1] + v[2] * v[2])));
+  if (len > 0.0f) {
+    v[0] /= len;
+    v[1] /= len;
+    v[2] /= len;
+  }
+}
+void cross3(const float a[3], const float b[3], float o[3]) {
+  o[0] = a[1] * b[2] - a[2] * b[1];
+  o[1] = a[2] * b[0] - a[0] * b[2];
+  o[2] = a[0] * b[1] - a[1] * b[0];
+}
+float dot3(const float a[3], const float b[3]) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+}  // namespace
+
+Mat4 look_at_rh(const float eye[3], const float at[3], const float up[3]) {
+  float z[3] = {eye[0] - at[0], eye[1] - at[1], eye[2] - at[2]};
+  normalize3(z);
+  float x[3];
+  cross3(up, z, x);
+  normalize3(x);
+  float y[3];
+  cross3(z, x, y);
+  Mat4 r;
+  for (int i = 0; i < 3; ++i) {
+    r.m[i * 4 + 0] = x[i];
+    r.m[i * 4 + 1] = y[i];
+    r.m[i * 4 + 2] = z[i];
+  }
+  r.m[12] = -dot3(x, eye);
+  r.m[13] = -dot3(y, eye);
+  r.m[14] = -dot3(z, eye);
+  r.m[15] = 1.0f;
+  return r;
+}
+
+void transform_point(const Mat4& m, const float p[3], float out[4]) {
+  for (int j = 0; j < 4; ++j) out[j] = p[0] * m.m[j] + p[1] * m.m[4 + j] + p[2] * m.m[8 + j] + m.m[12 + j];
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/src/view/mips.cpp work/engine/src/view/mips.cpp
--- base/engine/src/view/mips.cpp	1970-01-01 01:00:00
+++ work/engine/src/view/mips.cpp	2026-10-07 08:54:45
@@ -0,0 +1,93 @@
+#include "lomn/view/mips.h"
+
+namespace lomn::view {
+namespace {
+
+struct Tap {
+  uint32_t src;     // source index
+  uint64_t weight;  // overlap in units of 1/dst_size source texels
+};
+
+// Per destination texel of one axis: the source texels it covers and their overlap weights (sum == src_size).
+// Destination texel x covers [x*S, (x+1)*S) and source texel i covers [i*D, (i+1)*D) in the common unit 1/(S*D).
+std::vector<std::vector<Tap>> axis_taps(uint32_t s, uint32_t d) {
+  std::vector<std::vector<Tap>> taps(d);
+  for (uint32_t x = 0; x < d; ++x) {
+    const uint64_t lo = uint64_t(x) * s, hi = uint64_t(x + 1) * s;
+    for (uint64_t i = lo / d; i < s && i * d < hi; ++i) {
+      const uint64_t a = i * d > lo ? i * d : lo, b = (i + 1) * d < hi ? (i + 1) * d : hi;
+      if (b > a) taps[x].push_back({static_cast<uint32_t>(i), b - a});
+    }
+  }
+  return taps;
+}
+
+}  // namespace
+
+uint32_t mip_level_count(uint32_t width, uint32_t height) {
+  if (width == 0 || height == 0) return 0;
+  uint32_t m = width > height ? width : height, n = 1;
+  while (m > 1) {
+    m >>= 1;
+    ++n;
+  }
+  return n;
+}
+
+uint64_t mip_chain_bytes(uint32_t width, uint32_t height) {
+  uint64_t total = 0;
+  const uint32_t n = mip_level_count(width, height);
+  for (uint32_t i = 0; i < n; ++i) {
+    const uint64_t w = (width >> i) ? (width >> i) : 1, h = (height >> i) ? (height >> i) : 1;
+    total += w * h * 4;
+  }
+  return total;
+}
+
+bool downsample_box(const std::vector<uint8_t>& src, uint32_t width, uint32_t height, MipLevel& dst) {
+  if (width == 0 || height == 0 || src.size() != uint64_t(width) * height * 4) return false;
+  const uint32_t dw = width > 1 ? width / 2 : 1, dh = height > 1 ? height / 2 : 1;
+  const auto tx = axis_taps(width, dw), ty = axis_taps(height, dh);
+  const uint64_t total = uint64_t(width) * height;  // sum of all weights of one destination texel
+  MipLevel out;
+  out.width = dw;
+  out.height = dh;
+  out.rgba.resize(size_t(dw) * dh * 4);
+  for (uint32_t y = 0; y < dh; ++y) {
+    for (uint32_t x = 0; x < dw; ++x) {
+      uint64_t acc[4] = {0, 0, 0, 0};
+      for (const Tap& vy : ty[y]) {
+        const uint8_t* row = &src[(size_t(vy.src) * width) * 4];
+        for (const Tap& vx : tx[x]) {
+          const uint64_t w = vx.weight * vy.weight;
+          const uint8_t* p = row + size_t(vx.src) * 4;
+          for (int c = 0; c < 4; ++c) acc[c] += w * p[c];
+        }
+      }
+      uint8_t* o = &out.rgba[(size_t(y) * dw + x) * 4];
+      for (int c = 0; c < 4; ++c) o[c] = static_cast<uint8_t>((acc[c] + total / 2) / total);
+    }
+  }
+  dst = std::move(out);
+  return true;
+}
+
+bool build_mip_chain(std::vector<uint8_t> rgba, uint32_t width, uint32_t height, std::vector<MipLevel>& out) {
+  out.clear();
+  if (width == 0 || height == 0 || rgba.size() != uint64_t(width) * height * 4) return false;
+  const uint32_t n = mip_level_count(width, height);
+  out.reserve(n);
+  out.push_back({width, height, std::move(rgba)});
+  for (uint32_t i = 1; i < n; ++i) {
+    MipLevel next;
+    const MipLevel& prev = out.back();
+    if (!downsample_box(prev.rgba, prev.width, prev.height, next)) {
+      out.clear();
+      return false;
+    }
+    out.push_back(std::move(next));
+  }
+  return true;
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/src/view/synthetic.cpp work/engine/src/view/synthetic.cpp
--- base/engine/src/view/synthetic.cpp	1970-01-01 01:00:00
+++ work/engine/src/view/synthetic.cpp	2026-10-07 08:51:21
@@ -0,0 +1,280 @@
+#include "lomn/view/synthetic.h"
+
+#include <algorithm>
+#include <cstring>
+#include <initializer_list>
+#include <string>
+#include <vector>
+
+namespace lomn::view {
+namespace {
+
+using Bytes = std::vector<uint8_t>;
+
+void put16(Bytes& b, uint16_t v) {
+  b.push_back(static_cast<uint8_t>(v));
+  b.push_back(static_cast<uint8_t>(v >> 8));
+}
+void put32(Bytes& b, uint32_t v) {
+  for (int i = 0; i < 4; ++i) b.push_back(static_cast<uint8_t>(v >> (8 * i)));
+}
+void putf(Bytes& b, float f) {
+  uint32_t u;
+  std::memcpy(&u, &f, 4);
+  put32(b, u);
+}
+void putstr(Bytes& b, const std::string& s) { b.insert(b.end(), s.begin(), s.end()); }
+uint32_t id4(const char* s) {  // "vllw" -> LE u32 whose file bytes read "wllv"
+  return (uint32_t(uint8_t(s[0])) << 24) | (uint32_t(uint8_t(s[1])) << 16) | (uint32_t(uint8_t(s[2])) << 8) | uint32_t(uint8_t(s[3]));
+}
+
+// "BLKF", version 1, entries sorted by name (the game's Find binary-searches), stored (flags 2), then payloads.
+Bytes make_blk(std::vector<std::pair<std::string, Bytes>> es) {
+  std::sort(es.begin(), es.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+  Bytes b;
+  putstr(b, "BLKF");
+  put32(b, 1);
+  put32(b, static_cast<uint32_t>(es.size()));
+  uint32_t off = static_cast<uint32_t>(12 + 56 * es.size());
+  for (const auto& e : es) {
+    Bytes name(40, 0);
+    std::memcpy(name.data(), e.first.data(), std::min<size_t>(e.first.size(), 39));
+    b.insert(b.end(), name.begin(), name.end());
+    put32(b, static_cast<uint32_t>(e.second.size()));
+    put32(b, static_cast<uint32_t>(e.second.size()));
+    put32(b, 2);
+    put32(b, off);
+    off += static_cast<uint32_t>(e.second.size());
+  }
+  for (const auto& e : es) b.insert(b.end(), e.second.begin(), e.second.end());
+  return b;
+}
+
+Bytes dds_header(uint32_t w, uint32_t h, const char* fourcc) {
+  Bytes b;
+  putstr(b, "DDS ");
+  put32(b, 124);
+  put32(b, 0x1007);
+  put32(b, h);
+  put32(b, w);
+  put32(b, 0);
+  put32(b, 0);
+  put32(b, 0);  // mip count 0, like every Beta DDS
+  for (int i = 0; i < 11; ++i) put32(b, 0);
+  put32(b, 32);
+  if (fourcc) {
+    put32(b, 0x4);
+    putstr(b, fourcc);
+    for (int i = 0; i < 5; ++i) put32(b, 0);
+  } else {  // A8R8G8B8
+    put32(b, 0x41);
+    put32(b, 0);
+    put32(b, 32);
+    put32(b, 0x00ff0000u);
+    put32(b, 0x0000ff00u);
+    put32(b, 0x000000ffu);
+    put32(b, 0xff000000u);
+  }
+  put32(b, 0x1000);
+  for (int i = 0; i < 4; ++i) put32(b, 0);
+  return b;
+}
+
+Bytes red_dds() {  // DXT1 4x4: c0 = c1 = 0xF800 (red), all indices 0
+  Bytes b = dds_header(4, 4, "DXT1");
+  put16(b, 0xF800);
+  put16(b, 0xF800);
+  put32(b, 0);
+  return b;
+}
+
+Bytes cut_dds() {  // A8R8G8B8 8x8: columns 0..3 opaque green, 4..7 transparent magenta
+  Bytes b = dds_header(8, 8, nullptr);
+  for (int y = 0; y < 8; ++y)
+    for (int x = 0; x < 8; ++x) put32(b, x < 4 ? 0xff00ff00u : 0x00ff00ffu);
+  return b;
+}
+
+// Binary .x token writer (xof 0303bin 0032): NAME=1, STRING=2, INTEGER_LIST=6, FLOAT_LIST=7, '{'=10, '}'=11.
+struct X {
+  Bytes b;
+  X() { putstr(b, "xof 0303bin 0032"); }
+  X& name(const std::string& s) {
+    put16(b, 1);
+    put32(b, static_cast<uint32_t>(s.size()));
+    putstr(b, s);
+    return *this;
+  }
+  X& str(const std::string& s) {
+    put16(b, 2);
+    put32(b, static_cast<uint32_t>(s.size()));
+    putstr(b, s);
+    put16(b, 20);
+    return *this;
+  }
+  X& ints(const std::vector<uint32_t>& v) {
+    put16(b, 6);
+    put32(b, static_cast<uint32_t>(v.size()));
+    for (uint32_t x : v) put32(b, x);
+    return *this;
+  }
+  X& floats(const std::vector<float>& v) {
+    put16(b, 7);
+    put32(b, static_cast<uint32_t>(v.size()));
+    for (float x : v) putf(b, x);
+    return *this;
+  }
+  X& open() {
+    put16(b, 10);
+    return *this;
+  }
+  X& close() {
+    put16(b, 11);
+    return *this;
+  }
+  X& obj(const std::string& type) { return name(type).open(); }
+};
+
+// A quad in the model's y = 0 plane (world z = 0 after RotX), x [x0,x1], model z [z0,z1] (world y), u along x.
+void quad(std::vector<float>& pos, std::vector<float>& uv, std::vector<uint32_t>& faces, float x0, float x1, float z0, float z1) {
+  const uint32_t base = static_cast<uint32_t>(pos.size() / 3);
+  for (float v : {x0, 0.f, z0, x1, 0.f, z0, x1, 0.f, z1, x0, 0.f, z1}) pos.push_back(v);
+  for (float v : {0.f, 1.f, 1.f, 1.f, 1.f, 0.f, 0.f, 0.f}) uv.push_back(v);
+  for (uint32_t v : {4u, base, base + 1, base + 2, base + 3}) faces.push_back(v);
+}
+
+void material(X& x, std::initializer_list<float> diffuse, const char* texture) {
+  std::vector<float> f(diffuse);
+  for (float v : {0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f}) f.push_back(v);  // power, specular, emissive
+  x.obj("Material").floats(f);
+  if (texture) x.obj("TextureFilename").str(texture).close();
+  x.close();
+}
+
+Bytes quad_x() {
+  std::vector<float> pos, uv;
+  std::vector<uint32_t> faces;
+  quad(pos, uv, faces, -8, -1, -4, 4);   // subset 0: red
+  quad(pos, uv, faces, 1, 8, -4, 4);     // subset 1: cut (alpha)
+  quad(pos, uv, faces, 50, 60, -4, 4);   // subset 2: missing texture, off-screen
+  X x;
+  x.obj("Mesh").ints({12}).floats(pos);
+  std::vector<uint32_t> fi = {3};
+  fi.insert(fi.end(), faces.begin(), faces.end());
+  x.ints(fi);
+  // One normal (0,-1,0) for every corner (world +Z after RotX, towards the camera): no vertex is split.
+  std::vector<uint32_t> ni = {3};  // nFaceNormals, then per face: 4 corners, normal 0
+  for (int f = 0; f < 3; ++f) ni.insert(ni.end(), {4u, 0u, 0u, 0u, 0u});
+  x.obj("MeshNormals").ints({1}).floats({0.f, -1.f, 0.f}).ints(ni).close();
+  x.obj("MeshTextureCoords").ints({12}).floats(uv).close();
+  x.obj("MeshVertexColors").ints({12});
+  for (uint32_t i = 0; i < 12; ++i) x.ints({i}).floats({1.0f, 0.5f, 1.0f, 1.0f});
+  x.close();
+  x.obj("MeshMaterialList").ints({3, 3, 0, 1, 2});
+  material(x, {1, 1, 1, 1}, "red");
+  material(x, {1, 1, 1, 1}, "cut");
+  material(x, {1, 1, 1, 1}, "nothere");
+  x.close();
+  x.close();
+  return x.b;
+}
+
+Bytes blue_x() {
+  std::vector<float> pos, uv;
+  std::vector<uint32_t> faces;
+  quad(pos, uv, faces, -8, 8, -2, 8);
+  X x;
+  x.obj("Mesh").ints({4}).floats(pos);
+  std::vector<uint32_t> fi = {1};
+  fi.insert(fi.end(), faces.begin(), faces.end());
+  x.ints(fi);
+  x.obj("MeshMaterialList").ints({1, 1, 0});
+  material(x, {0, 0, 1, 1}, nullptr);
+  x.close();
+  x.close();
+  return x.b;
+}
+
+struct Rec {
+  const char* id;
+  float x, y, z;
+  uint32_t flags;
+};
+
+// {slot, n, n, ptr=0x16} + 60-byte records at 0x16, padding, one fix-up slot (12), count, 0x00C0FFEE (the Beta shape).
+Bytes obj_slb(const std::vector<Rec>& recs) {
+  Bytes b;
+  put32(b, id4("????"));
+  put32(b, static_cast<uint32_t>(recs.size()));
+  put32(b, static_cast<uint32_t>(recs.size()));
+  put32(b, 0x16);
+  put16(b, 0);
+  put32(b, 0);
+  for (const Rec& r : recs) {
+    put32(b, id4(r.id));
+    putf(b, r.x);
+    putf(b, r.y);
+    putf(b, r.z);
+    for (int k = 0; k < 3; ++k) putf(b, 0.0f);  // orient
+    put32(b, 0);                                // +0x1c
+    for (int k = 0; k < 6; ++k) putf(b, 0.0f);  // ext0, ext1
+    put32(b, r.flags);
+  }
+  put16(b, 0);
+  put32(b, 12);
+  put32(b, 1);
+  put32(b, 0x00C0FFEEu);
+  return b;
+}
+
+Bytes pos_slb(const std::vector<Rec>& recs) {  // {slot, n, ptr=12} + 20-byte records
+  Bytes b;
+  put32(b, 0);
+  put32(b, static_cast<uint32_t>(recs.size()));
+  put32(b, 12);
+  for (const Rec& r : recs) {
+    put32(b, id4(r.id));
+    putf(b, r.x);
+    putf(b, r.y);
+    putf(b, r.z);
+    put32(b, r.flags);
+  }
+  put32(b, 8);
+  put32(b, 1);
+  put32(b, 0x00C0FFEEu);
+  return b;
+}
+
+}  // namespace
+
+bool mount_synthetic_install(fs::MemoryFileSystem& fs) {
+  Bytes level = make_blk({{"red.dds", red_dds()}, {"cut.dds", cut_dds()}});
+  Bytes area = make_blk({
+      {"quad.x", quad_x()},
+      {"blue.x", blue_x()},
+      {"test_obj.slb", obj_slb({{"quad", 0, 0, 0, 0x10},
+                                {"blue", 0, 0, -2, 0x10},
+                                {"blue", 0, 0, -50, 0x08},
+                                {"quad", 0, 0, -60, 0x110},
+                                {"blue", 0, 0, -70, 0x110},
+                                {"blue", 0, 0, -80, 0x20},
+                                {"nope", 0, 0, 0, 0x04},
+                                {"miss", 0, 0, 0, 0x10}})},
+      {"test_pos.slb", pos_slb({{"pkup", 1, 2, 3, 0x60}, {"strt", 0, 0, 10, 0x1000}})},
+  });
+  return fs.mount("Root/Data/Levels/levt/levt.blk", std::move(level)) && fs.mount("Root/Data/Levels/levt/test.blk", std::move(area));
+}
+
+CameraSettings synthetic_camera() {
+  CameraSettings s;
+  s.fov_deg = 90.0f;
+  s.near_z = 0.1f;
+  s.far_z = 100.0f;
+  s.eye_height = 0.0f;
+  s.pitch_deg = 0.0f;
+  s.yaw_set = true;
+  s.yaw_deg = 0.0f;
+  return s;
+}
+
+}  // namespace lomn::view
diff -ruN base/engine/tests/a7_calls.cmake work/engine/tests/a7_calls.cmake
--- base/engine/tests/a7_calls.cmake	1970-01-01 01:00:00
+++ work/engine/tests/a7_calls.cmake	2026-10-07 08:08:02
@@ -0,0 +1,30 @@
+# ctest helper (spec M1 A7): render the synthetic scene on the null backend twice and require both call logs to be
+# non-empty, byte-identical, and equal to the checked-in EXPECTED log. RUNNER is empty natively and "node" for wasm32,
+# so native and wasm32 are each pinned to the same file (and make test-wasm cmp's the two outputs directly).
+foreach(run a b)
+  file(MAKE_DIRECTORY ${OUT}/${run})
+  execute_process(COMMAND ${RUNNER} ${EXE} --synthetic 1 --backend null --out ${OUT}/${run}/calls.txt
+                  RESULT_VARIABLE rc TIMEOUT 120)
+  if(NOT rc EQUAL 0)
+    message(FATAL_ERROR "lomn_view --synthetic run ${run} failed: ${rc}")
+  endif()
+  file(SIZE ${OUT}/${run}/calls.txt sz)
+  if(sz EQUAL 0)
+    message(FATAL_ERROR "${OUT}/${run}/calls.txt is empty")
+  endif()
+endforeach()
+execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/calls.txt ${OUT}/b/calls.txt RESULT_VARIABLE diff)
+if(NOT diff EQUAL 0)
+  message(FATAL_ERROR "A7 call log differs between two runs")
+endif()
+if(NOT EXISTS ${EXPECTED})
+  message(FATAL_ERROR "missing expected log ${EXPECTED}")
+endif()
+execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/calls.txt ${EXPECTED} RESULT_VARIABLE diff)
+if(NOT diff EQUAL 0)
+  message(FATAL_ERROR "A7 call log ${OUT}/a/calls.txt differs from the expected ${EXPECTED}")
+endif()
+file(READ ${OUT}/a/calls.txt.json m)
+if(NOT m MATCHES "\"draws_last_frame\":10,")
+  message(FATAL_ERROR "A7 metrics: expected 10 draws in the frame: ${m}")
+endif()
