# ctest helper: run lomn_native (null backend) twice and require byte-identical trace + call log.
# RUNNER is empty natively and "node" for the wasm32 build. If REFERENCE is set, also require equality with it.
foreach(run a b)
  execute_process(COMMAND ${RUNNER} ${EXE} --backend null --frames 600 --shot 0,300,599 --out ${OUT}/${run}
                  RESULT_VARIABLE rc TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "lomn_native run ${run} failed: ${rc}")
  endif()
endforeach()
foreach(f trace.jsonl calls.txt)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/${f} ${OUT}/b/${f} RESULT_VARIABLE diff)
  if(NOT diff EQUAL 0)
    message(FATAL_ERROR "${f} differs between runs")
  endif()
endforeach()
if(REFERENCE)
  foreach(f trace.jsonl calls.txt)
    execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/${f} ${REFERENCE}/${f} RESULT_VARIABLE diff)
    if(NOT diff EQUAL 0)
      message(FATAL_ERROR "${f} differs from reference ${REFERENCE}")
    endif()
  endforeach()
endif()
file(READ ${OUT}/a/metrics.json m)
if(NOT m MATCHES "\"frames\": 600,")
  message(FATAL_ERROR "metrics.json frame count != 600: ${m}")
endif()
