# ctest helper (spec M1 A7): render the synthetic scene on the null backend twice and require both call logs to be
# non-empty, byte-identical, and equal to the checked-in EXPECTED log. RUNNER is empty natively and "node" for wasm32,
# so native and wasm32 are each pinned to the same file (and make test-wasm cmp's the two outputs directly).
foreach(run a b)
  file(MAKE_DIRECTORY ${OUT}/${run})
  execute_process(COMMAND ${RUNNER} ${EXE} --synthetic 1 --backend null --out ${OUT}/${run}/calls.txt
                  RESULT_VARIABLE rc TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "lomn_view --synthetic run ${run} failed: ${rc}")
  endif()
  file(SIZE ${OUT}/${run}/calls.txt sz)
  if(sz EQUAL 0)
    message(FATAL_ERROR "${OUT}/${run}/calls.txt is empty")
  endif()
endforeach()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/calls.txt ${OUT}/b/calls.txt RESULT_VARIABLE diff)
if(NOT diff EQUAL 0)
  message(FATAL_ERROR "A7 call log differs between two runs")
endif()
if(NOT EXISTS ${EXPECTED})
  message(FATAL_ERROR "missing expected log ${EXPECTED}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/calls.txt ${EXPECTED} RESULT_VARIABLE diff)
if(NOT diff EQUAL 0)
  message(FATAL_ERROR "A7 call log ${OUT}/a/calls.txt differs from the expected ${EXPECTED}")
endif()
file(READ ${OUT}/a/calls.txt.json m)
if(NOT m MATCHES "\"draws_last_frame\":10,")
  message(FATAL_ERROR "A7 metrics: expected 10 draws in the frame: ${m}")
endif()
