# ctest helper (M2a-2): the "pending" marker of lomn_osi_conform (docs/osi/conformance.md "Pending programs"), on a temporary
# corpus built here: g/ok (passes), n/pend (pending "T3"; its .asm does not even assemble and its expectation could not be
# met), n/gone (pending, no .asm at all), then, in a second corpus, one real failure next to a pending program.
# RUNNER is empty natively and "node" for wasm32; ASSEMBLE is tools/osi/conform_assemble.py; PYTHON the interpreter.
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT}/c1/g ${OUT}/c1/n ${OUT}/c2/g ${OUT}/c2/n)
set(ASM ".function main 0\n    PushConstanti8 1\n    PushConstanti8 2\n    Add\n    Return\n")
set(OKJ "{\"id\":\"ok\",\"entry\":\"main\",\"args\":[],\"natives\":[],\"registry\":\"none\",\"expect\":{\"ok\":true,\"result\":{\"type\":\"0x10\",\"value\":3},\"depth\":0,\"context_depth\":0,\"fpu_pc\":24}}")
set(BADJ "{\"id\":\"bad\",\"entry\":\"main\",\"args\":[],\"natives\":[],\"registry\":\"none\",\"expect\":{\"ok\":true,\"result\":{\"type\":\"0x10\",\"value\":4}}}")
set(PENDJ "{\"id\":\"pend\",\"pending\":\"T3\",\"entry\":\"main\",\"registry\":\"none\",\"returns\":{\"object\":1},\"then\":[],\"pc_after\":7,\"swallowed\":true,\"expect\":{\"top\":1,\"result\":{\"type\":\"0x10\",\"value\":99}}}")
set(GONEJ "{\"id\":\"gone\",\"pending\":\"T9\",\"expect\":{\"ok\":true}}")
foreach(c c1 c2)
  file(WRITE ${OUT}/${c}/g/ok.asm "${ASM}")
  file(WRITE ${OUT}/${c}/g/ok.expect.json "${OKJ}")
  file(WRITE ${OUT}/${c}/n/pend.asm "this is not assembly\n")
  file(WRITE ${OUT}/${c}/n/pend.expect.json "${PENDJ}")
  file(WRITE ${OUT}/${c}/n/gone.expect.json "${GONEJ}")
endforeach()
file(WRITE ${OUT}/c2/g/bad.asm "${ASM}")
file(WRITE ${OUT}/c2/g/bad.expect.json "${BADJ}")

function(run_runner corpus rc_var out_var)
  execute_process(COMMAND ${PYTHON} ${ASSEMBLE} ${OUT}/${corpus} ${OUT}/${corpus}-osi
                  RESULT_VARIABLE arc OUTPUT_VARIABLE aout ERROR_VARIABLE aerr TIMEOUT 60)
  if(NOT arc EQUAL 0)
    message(FATAL_ERROR "conform_assemble failed on ${corpus} (a pending .asm must be skipped): ${aout}${aerr}")
  endif()
  execute_process(COMMAND ${RUNNER} ${EXE} ${OUT}/${corpus} --osi-dir ${OUT}/${corpus}-osi --trace-dir ${OUT}/${corpus}-trace
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  set(${rc_var} ${rc} PARENT_SCOPE)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
endfunction()

run_runner(c1 rc out)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "pending corpus: expected exit 0, got ${rc}:\n${out}")
endif()
foreach(line "PENDING n/pend (T3)" "PENDING n/gone (T9)" "conformance: 1/1 pass, 2 pending")
  string(FIND "\n${out}" "\n${line}\n" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "missing the line '${line}' in:\n${out}")
  endif()
endforeach()
if(out MATCHES "FAIL")
  message(FATAL_ERROR "a FAIL line in the pending corpus:\n${out}")
endif()
if(NOT EXISTS ${OUT}/c1-trace/g/ok.trace)
  message(FATAL_ERROR "the passing program left no trace")
endif()
if(EXISTS ${OUT}/c1-trace/n)
  message(FATAL_ERROR "a pending program left a trace")
endif()

run_runner(c2 rc out)
if(rc EQUAL 0)
  message(FATAL_ERROR "a real failure next to pending programs must still exit non-zero:\n${out}")
endif()
foreach(line "conformance: 1/2 pass, 2 pending" "PENDING n/pend (T3)")
  string(FIND "\n${out}" "\n${line}\n" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "missing the line '${line}' in:\n${out}")
  endif()
endforeach()
if(NOT out MATCHES "FAIL g/bad.expect.json: result")
  message(FATAL_ERROR "the real failure is not reported:\n${out}")
endif()
