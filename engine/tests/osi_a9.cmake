# ctest helper (M2a-2 T6, acceptance A8/A9): `lomn_view --install DIR --script 1` runs the game's script headless through
# lomn::osi::ScriptHost. RUNNER is empty natively and node for wasm32, so each build checks ITS lomn_view against ITS
# lomn_osi_run (the A6 driver) and against tools/osi/coverage.py. `make osi-a9` adds native == wasm32 and the Python legs.
#   MODE=smoke (no game data): tests/data/osi_a9_smoke.asm assembled into a temporary install; --natives stub must equal
#              lomn_osi_run on the same script (digest, natives.log and the trace window -1:2 byte for byte: lomn_view adds
#              no behaviour); the coverage report == coverage.py --log of its natives.log and == the report computed by
#              hand in the .asm header; bad arguments exit 2, a missing install exits 3; an output onto the script
#              or inside the install exits 2 and leaves the install byte-identical (fix 1, m1).
#   MODE=real (LOMN_DATA): the A6 path (FRAMES frames + KEYSPEC) with --natives stub: D lines == lomn_osi_run's D lines
#              (C1: D lines only), natives.log equal, coverage == coverage.py; then the A8 run (--frames 1) exits 0 with
#              `unregistered 0`.
if(MODE STREQUAL "real" AND "$ENV{LOMN_DATA}" STREQUAL "")
  message(STATUS "SKIPPED (no LOMN_DATA)")
  return()
endif()
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
function(run what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 600)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${what} failed (${rc}):\n${o}\n${e}")
  endif()
  set(last_out "${o}" PARENT_SCOPE)
endfunction()
function(expect_rc want what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 120)
  if(NOT rc EQUAL ${want})
    message(FATAL_ERROR "${what}: exit ${rc}, want ${want}\n${o}\n${e}")
  endif()
  message(STATUS "exit ${want}: ${what}")
endfunction()
function(same a b what)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${a} ${b} RESULT_VARIABLE d)
  if(NOT d EQUAL 0)
    message(FATAL_ERROR "A9 ${what}: ${a} and ${b} differ")
  endif()
  message(STATUS "cmp ${what}: OK")
endfunction()
# The coverage report lines of a lomn_view stdout == coverage.py --log <its natives.log>, byte for byte.
function(coverage_equal stdout_text log what)
  string(REPLACE "\n" ";" lines "${stdout_text}")
  set(cov "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^(coverage: |native )")
      string(APPEND cov "${l}\n")
    endif()
  endforeach()
  run("coverage.py" ${PY} ${COVERAGE} --log ${log})
  if(NOT cov STREQUAL last_out OR cov STREQUAL "")
    message(FATAL_ERROR "${what}: lomn_view's coverage report differs from coverage.py --log:\n--- lomn_view\n${cov}--- coverage.py\n${last_out}")
  endif()
  message(STATUS "coverage report == coverage.py --log: OK (${what})")
  set(cov_text "${cov}" PARENT_SCOPE)
endfunction()
function(d_lines in out)
  file(STRINGS ${in} d REGEX "^D ")
  list(LENGTH d n)
  string(JOIN "\n" t ${d})
  file(WRITE ${out} "${t}\n")
  set(d_count ${n} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "smoke")
  file(MAKE_DIRECTORY ${OUT}/install/data)
  run("osiasm" ${PY} ${OSIASM} ${ASM} -o ${OUT}/install/data/Base.osi)
  set(args --frames 6 --keys "down@1 esc@4" --trace-frames -1:2)
  run("lomn_view --script 1" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --natives stub ${args}
      --digest ${OUT}/v.digest --natives-log ${OUT}/v.log --trace ${OUT}/v.trace --out ${OUT}/v.json)
  set(view_out "${last_out}")
  message(STATUS "lomn_view:\n${view_out}")
  run("lomn_osi_run" ${RUNNER} ${OSIRUN} ${OUT}/install/data/Base.osi ${args}
      --digest ${OUT}/o.digest --natives-log ${OUT}/o.log --trace ${OUT}/o.trace)
  same(${OUT}/v.digest ${OUT}/o.digest "digest lomn_view == lomn_osi_run")
  same(${OUT}/v.log ${OUT}/o.log "natives.log lomn_view == lomn_osi_run")
  same(${OUT}/v.trace ${OUT}/o.trace "trace window -1:2 lomn_view == lomn_osi_run")
  coverage_equal("${view_out}" ${OUT}/v.log "smoke")
  # computed by hand from the script (osi_a9_smoke.asm header): calls 2 + 6 + 1, rows at frames -1, -1, 0, 3. The tier column is
  # what the merged registry row DECLARES (--natives stub runs every row as its stub), so the expected tiers and the counts
  # of the first line are DERIVED from the committed tables (data/osi/natives.json, natives_beta150.json), never hard-coded:
  # a row with no "tier" key is a stub, a mod row says "mod" (natives.md 7.1). M2a-2 T7a made the resolution natives tier1.
  function(tier_of key out)
    set(t "")
    foreach(f IN ITEMS natives.json natives_beta150.json)
      if(t STREQUAL "")
        file(STRINGS ${TABLES}/${f} rowlines REGEX "\"key\":\"${key}\"")
        foreach(l IN LISTS rowlines)
          if(t STREQUAL "")
            if(l MATCHES "\"tier\":\"([a-z0-9]+)\"")
              set(t "${CMAKE_MATCH_1}")
            else()
              set(t "stub")
            endif()
          endif()
        endforeach()
      endif()
    endforeach()
    if(t STREQUAL "")
      message(FATAL_ERROR "no registry row for ${key} in ${TABLES}")
    endif()
    set(${out} "${t}" PARENT_SCOPE)
  endfunction()
  tier_of(gcgame.getresolutionwidth t_w)
  tier_of(gcsaver.clearcinema t_c)
  tier_of(gcgame.getresolutionheight t_h)
  tier_of(gcsaver.cheatmenu t_m)
  foreach(t IN ITEMS tier1 tier2 stub mod tier3)
    set(n_${t} 0)
  endforeach()
  foreach(t IN ITEMS ${t_w} ${t_c} ${t_h} ${t_m})
    math(EXPR n_${t} "${n_${t}} + 1")
  endforeach()
  set(want "^coverage: natives distinct 4 \\(tier1 ${n_tier1}, tier2 ${n_tier2}, stub ${n_stub}, mod ${n_mod}, tier3 ${n_tier3}\\), calls 9, unregistered 0\nnative gcgame\\.getresolutionwidth +tier ${t_w} +first +-1 calls +1 body 0x004367b0\nnative gcsaver\\.clearcinema +tier ${t_c} +first +-1 calls +1 body 0x10001e40\nnative gcgame\\.getresolutionheight +tier ${t_h} +first +0 calls +6 body 0x004367d0\nnative gcsaver\\.cheatmenu +tier ${t_m} +first +3 calls +1 body 0x005d35b0\n$")
  if(NOT cov_text MATCHES "${want}")
    message(FATAL_ERROR "the smoke coverage report is not the hand-computed one:\n${cov_text}")
  endif()
  if(NOT view_out MATCHES "\nnesting high-water 1\nstack high-water [0-9]+\nsetup: " OR NOT view_out MATCHES "\nstop: none\n")
    message(FATAL_ERROR "stdout order (coverage, nesting, stack, summary) or stop line wrong:\n${view_out}")
  endif()
  file(READ ${OUT}/v.json j)
  if(NOT j MATCHES "\"skip_video\":true" OR NOT j MATCHES "\"deterministic\":true" OR NOT j MATCHES "\"natives\":\"stub\"")
    message(FATAL_ERROR "the --out JSON does not report skip_video / deterministic / natives:\n${j}")
  endif()
  expect_rc(2 "--frames 0" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --frames 0)
  expect_rc(2 "--script 2" ${RUNNER} ${EXE} --install ${OUT}/install --script 2)
  expect_rc(2 "--script 1 --level x" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --level x)
  expect_rc(2 "--trace-frames 3:2" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --trace ${OUT}/x.trace --trace-frames 3:2)
  expect_rc(3 "missing install" ${RUNNER} ${EXE} --install ${OUT}/missing --script 1 --natives stub)
  # fix 1 (m1): an output onto the script, or anywhere inside the install, is refused (exit 2) and the install is untouched
  file(SHA256 ${OUT}/install/data/Base.osi sha_before)
  expect_rc(2 "--digest onto the script" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --natives stub
            --digest ${OUT}/install/data/Base.osi)
  expect_rc(2 "--natives-log via .. into the install" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --natives stub
            --natives-log ${OUT}/install/data/../data/Base.osi)
  expect_rc(2 "--out inside the install" ${RUNNER} ${EXE} --install ${OUT}/install --script 1 --natives stub
            --out ${OUT}/install/data/v.json)
  file(SHA256 ${OUT}/install/data/Base.osi sha_after)
  file(GLOB inst_files RELATIVE ${OUT}/install ${OUT}/install/*/* ${OUT}/install/*)
  if(NOT sha_before STREQUAL sha_after OR NOT inst_files STREQUAL "data;data/Base.osi")
    message(FATAL_ERROR "the install changed: ${sha_before} -> ${sha_after}, files ${inst_files}")
  endif()
  message(STATUS "install untouched: OK")
elseif(MODE STREQUAL "real")
  set(INSTALL "$ENV{LOMN_DATA}/install")
  run("lomn_view --script 1" ${RUNNER} ${EXE} --install ${INSTALL} --script 1 --natives stub --frames ${FRAMES} --keys "${KEYSPEC}"
      --digest ${OUT}/v.digest --natives-log ${OUT}/v.log)
  set(view_out "${last_out}")
  message(STATUS "lomn_view:\n${view_out}")
  run("lomn_osi_run" ${RUNNER} ${OSIRUN} ${INSTALL}/data/Base.osi --frames ${FRAMES} --keys "${KEYSPEC}"
      --digest ${OUT}/o.digest --natives-log ${OUT}/o.log)
  d_lines(${OUT}/v.digest ${OUT}/v.D)
  set(vn ${d_count})
  d_lines(${OUT}/o.digest ${OUT}/o.D)
  math(EXPR want "${FRAMES} + 1")
  if(NOT vn EQUAL want)
    message(FATAL_ERROR "lomn_view digest has ${vn} D lines, want ${want} (frame -1 + ${FRAMES} frames)")
  endif()
  same(${OUT}/v.D ${OUT}/o.D "D lines lomn_view --natives stub == lomn_osi_run (${vn} lines)")
  same(${OUT}/v.log ${OUT}/o.log "natives.log lomn_view == lomn_osi_run")
  coverage_equal("${view_out}" ${OUT}/v.log "A6 path")
  run("lomn_view --script 1 --frames 1 (A8)" ${RUNNER} ${EXE} --install ${INSTALL} --script 1 --natives stub --frames 1
      --natives-log ${OUT}/a8.log)
  set(a8_out "${last_out}")
  coverage_equal("${a8_out}" ${OUT}/a8.log "A8")
  if(NOT a8_out MATCHES "^coverage: natives distinct [0-9]+ \\([^)]*\\), calls [0-9]+, unregistered 0\n")
    message(FATAL_ERROR "A8: the report must open the stdout with unregistered 0:\n${a8_out}")
  endif()
else()
  message(FATAL_ERROR "MODE must be smoke or real")
endif()
