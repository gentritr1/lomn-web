# Copy to .env.local (gitignored). Paths to YOUR local copies; nothing here is ever committed.
# Write values WITHOUT quotes, even if they contain spaces: make reads this file directly, and
# shells load it with `source tools/env.sh`.
# LOMN_DATA layout: reference/LEGOBionicle.exe (canonical, see tools/builds.json) + install/ (Beta 1.5.0 install)
LOMN_DATA=/absolute/path/to/lomn-data
# Ghidra project + export cache (optional; default ~/.cache/lomn-web)
LOMN_CACHE=
